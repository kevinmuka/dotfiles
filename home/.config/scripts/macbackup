import termios
import time
import tty
import uuid


VERSION = "0.12.3"
FINDER_ICON = "Icon\r"
ICON_SIDECAR = "/icon.json"
PATH_LISTS = ("plain-paths.txt", "private-paths.txt", "exclude-paths.txt")
PATTERN_FILE = "explicit-only-patterns.txt"
CONFIG_FILES = (*PATH_LISTS, PATTERN_FILE)
SETTINGS_TEMPLATE = '''# Nessuna password: le credenziali rimangono nella configurazione rclone.
schema_version = 1
max_delete = 25

[policy]
private_directory_names = []
ignored_file_names = [".DS_Store"]
use_gitignore = false

[targets.google]
enabled = false
plain = "gdrive:MacBackup/plain"
private = "gdrive-private:"

[targets.proton]
enabled = false
plain = "pdrive:MacBackup/plain"
private = "pdrive-private:"
'''


class ConfigError(Exception):
    pass


class GitIgnoreMatcher:
    """Ask Git to evaluate only .gitignore files, without a repository index."""
    def __init__(self):
        executable = shutil.which('git')
        if executable is None:
            raise ConfigError('use_gitignore richiede Git nel PATH.')
        self.temporary = tempfile.TemporaryDirectory(prefix='macbackup-gitignore-')
        gitdir = str(Path(self.temporary.name) / 'repo.git')
        self.environment = {key: value for key, value in os.environ.items()
                            if not key.startswith('GIT_')}
        initialized = subprocess.run([executable, 'init', '--bare', '-q', gitdir],
                                     env=self.environment, capture_output=True)
        if initialized.returncode:
            self.temporary.cleanup()
            raise ConfigError('Impossibile inizializzare il controllo dei .gitignore: '
                              + initialized.stderr.decode('utf-8', 'replace').strip())
        command = [executable, '--git-dir', gitdir, '--work-tree', '/',
                   '-c', 'core.bare=false', '-c', 'core.excludesFile=/dev/null',
                   'check-ignore', '--no-index', '-z', '-v', '-n', '--stdin']
        try:
            self.process = subprocess.Popen(command, env=self.environment,
                                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                            stderr=subprocess.PIPE)
        except OSError as exc:
            self.temporary.cleanup()
            raise ConfigError(f'Impossibile avviare il controllo dei .gitignore: {exc}') from exc
        self.pending = b''
        self.cache: dict[Path, tuple[bool, str | None]] = {}
        atexit.register(self.close)

    def preload(self, paths: list[Path]) -> None:
        waiting = list(dict.fromkeys(path for path in paths if path not in self.cache))
        assert self.process.stdin is not None and self.process.stdout is not None
        try:
            for offset in range(0, len(waiting), 16):
                group = waiting[offset:offset + 16]
                # Resolve symlinked ancestors, but never follow an entry itself.
                physicals = [Path(os.path.realpath(path.parent)) / path.name for path in group]
                self.process.stdin.write(b''.join(os.fsencode(str(path)) + b'\0'
                                                  for path in physicals))
                self.process.stdin.flush()
                for path, physical in zip(group, physicals):
                    while self.pending.count(b'\0') < 4:
                        ready, _, _ = select.select([self.process.stdout], [], [], 30)
                        if not ready:
                            raise ConfigError('Controllo .gitignore senza risposta da Git.')
                        chunk = os.read(self.process.stdout.fileno(), 4096)
                        if not chunk:
                            detail = self.process.stderr.read().decode('utf-8', 'replace').strip()
                            raise ConfigError('Controllo .gitignore interrotto: ' + detail)
                        self.pending += chunk
                    fields = self.pending.split(b'\0', 4)
                    self.pending = fields[4]
                    source, line, pattern, returned = [field.decode('utf-8', 'replace')
                                                       for field in fields[:4]]
                    if returned != str(physical):
                        raise ConfigError('Risposta .gitignore incoerente da Git.')
                    ignored = bool(pattern) and not pattern.startswith('!')
                    if ignored and source and not source.startswith('/'):
                        source = '/' + source
                    rule = f'{source}:{line}:{pattern}' if ignored else None
                    self.cache[path] = (ignored, rule)
        except OSError as exc:
            raise ConfigError(f'Impossibile controllare .gitignore: {exc}') from exc

    def match(self, path: Path) -> tuple[bool, str | None]:
        self.preload([path])
        return self.cache[path]

    def close(self) -> None:
        process = getattr(self, 'process', None)
        if process is not None:
            try:
                if process.stdin is not None:
                    process.stdin.close()
                process.wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                process.kill()
                process.wait()
            for stream in (process.stdout, process.stderr):
                if stream is not None:
                    stream.close()
            self.process = None
        temporary = getattr(self, 'temporary', None)
        if temporary is not None:
            temporary.cleanup()
            self.temporary = None

    def __del__(self):
        self.close()


def absolute_path(value: str) -> Path:
    if not value.startswith("/") or ".." in value.split("/"):
        raise ConfigError("Occorre un percorso assoluto senza componenti '..'.")
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ConfigError("I percorsi non possono contenere caratteri di controllo.")
    try:
        value.encode("utf-8")
    except UnicodeError as exc:
        raise ConfigError("Il percorso non è rappresentabile correttamente in UTF-8.") from exc
    return Path("/" + os.path.normpath(value).lstrip("/"))


def inside(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


@dataclass(frozen=True)
class Rule:
    path: Path
    directory: bool
    source: str
    line: int

    def matches(self, path: Path) -> bool:
        return path == self.path or (self.directory and inside(path, self.path))


@dataclass(frozen=True)
class Decision:
    action: str
    reason: str
    rule: str | None = None
    protected_pattern: str | None = None
    explicit: bool = False


@dataclass
class Entry:
    path: str
    kind: str
    size: int
    decision: Decision
    device: int
    inode: int

    def public_dict(self) -> dict:
        return {
            "path": self.path,
            "kind": self.kind,
            "size": self.size,
            **asdict(self.decision),
        }


@dataclass
class Scan:
    entries: list[Entry]
    errors: list[str]
    warnings: list[str]

    def summary(self) -> dict:
        counts = Counter(entry.decision.action for entry in self.entries)
        return {
            "plain": counts["plain"],
            "private": counts["private"],
            "skipped": counts["skip"],
            "finder_icons": sum(entry.kind == 'finder-icon' and entry.decision.action in ('plain', 'private') for entry in self.entries),
            "selected_bytes": sum(
                entry.size for entry in self.entries
                if entry.decision.action in ("plain", "private")
            ),
        }


def read_lines(file: Path) -> list[tuple[int, str]]:
    try:
        # These files are user policy, not data selected for backup.
        lines = file.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        raise ConfigError(f"Impossibile leggere {file}: {exc}") from exc
    result = []
    for number, value in enumerate(lines, 1):
        if not value.strip() or value.startswith("#"):
            continue
        if value != value.strip():
            raise ConfigError(f"{file}:{number}: spazi iniziali o finali ambigui.")
        result.append((number, value))
    return result


class Policy:
    def __init__(self, config_dir: Path, home: Path):
        self.config_dir = config_dir
        self.home = home
        self.state_dir = home / ".local/state/macbackup"
        self.state_physical = Path(os.path.realpath(self.state_dir))
        self.plain = self._rules("plain-paths.txt")
        self.private = self._rules("private-paths.txt")
        self.excluded = self._rules("exclude-paths.txt", exclusions=True)
        try:
            import tomllib
        except ImportError as exc:
            raise ConfigError('Le regole per nome richiedono Python 3.11 o successivo.') from exc
        try:
            settings = tomllib.loads((config_dir / 'settings.toml').read_text())
        except (OSError, ValueError) as exc:
            raise ConfigError(f'Impossibile leggere settings.toml: {exc}') from exc
        policy_settings = settings.get('policy', {})
        target_names = settings.get('targets', {})
        if not isinstance(target_names, dict):
            raise ConfigError('settings.toml: targets deve essere una tabella.')
        self.mount_roots = tuple(
            home / 'Desktop' / (name if area == 'all' else f'{name}-{area}')
            for name in target_names for area in ('plain', 'private', 'all')
        )
        if not isinstance(policy_settings, dict):
            raise ConfigError('settings.toml: policy deve essere una tabella.')
        names = policy_settings.get('private_directory_names', [])
        if not isinstance(names, list) or any(
            not isinstance(name, str) or not name or name in ('.', '..')
            or name.strip() != name or '/' in name
            or any(char in name for char in '*?[]{}\\')
            or any(ord(char) < 32 or ord(char) == 127 for char in name)
            for name in names
        ):
            raise ConfigError('settings.toml: private_directory_names richiede nomi letterali di directory.')
        self.private_directory_names = {name.casefold() for name in names}
        ignored = policy_settings.get('ignored_file_names', [])
        if not isinstance(ignored, list) or any(
            not isinstance(name, str) or not name or name in ('.', '..')
            or '/' in name
            or any(char in name for char in '*?[]{}\\')
            or any(ord(char) < 32 or ord(char) == 127 for char in name)
            for name in ignored
        ):
            raise ConfigError('settings.toml: ignored_file_names richiede nomi letterali di file.')
        self.ignored_file_names = {name.casefold() for name in ignored}
        use_gitignore = policy_settings.get('use_gitignore', False)
        if type(use_gitignore) is not bool:
            raise ConfigError('settings.toml: use_gitignore deve essere true o false.')
        self.gitignore = GitIgnoreMatcher() if use_gitignore else None
        self.patterns = []
        for number, pattern in read_lines(config_dir / PATTERN_FILE):
            invalid = (
                "/" in pattern or "**" in pattern
                or any(char in pattern for char in "?[]{}\\")
                or pattern.startswith(("+", "-"))
                or any(ord(char) < 32 or ord(char) == 127 for char in pattern)
            )
            if invalid:
                raise ConfigError(
                    f"{PATTERN_FILE}:{number}: ammessi soltanto nomi e '*'; "
                    "nessun percorso o altro operatore."
                )
            self.patterns.append(pattern)
        self.credential_roots = (
            home / ".config/rclone",
            home / "Library/Preferences/rclone",
        )
        self.credential_roots = tuple({
            *self.credential_roots,
            *(Path(os.path.realpath(root)) for root in self.credential_roots),
        })

    def _rules(self, filename: str, exclusions: bool = False) -> list[Rule]:
        result = []
        for line, value in read_lines(self.config_dir / filename):
            try:
                path = absolute_path(value)
            except ConfigError as exc:
                raise ConfigError(f"{filename}:{line}: {exc}") from exc
            if path == Path("/"):
                raise ConfigError(f"{filename}:{line}: la radice '/' non è ammessa.")
            try:
                info = path.lstat()
                directory = stat.S_ISDIR(info.st_mode)
            except OSError:
                directory = value.endswith("/")
            # Exclusions match a complete subtree, even when the source is absent.
            result.append(Rule(path, exclusions or directory, filename, line))
        return result

    @property
    def roots(self) -> list[Rule]:
        return self.plain + self.private

    def decide(self, path: Path, directory: bool = False,
               check_gitignore: bool = True) -> Decision:
        physical = Path(os.path.realpath(path))
        if inside(path, self.state_dir) or inside(physical, self.state_physical):
            return Decision("skip", "Stato operativo escluso automaticamente.", str(self.state_dir))
        mount_root = next((root for root in self.mount_roots if inside(path, root)), None)
        if mount_root:
            return Decision('skip', 'Punto di montaggio escluso automaticamente.', str(mount_root))
        excluded = next((rule for rule in self.excluded if rule.matches(path)), None)
        if excluded:
            return Decision("skip", "Esclusione assoluta.", str(excluded.path))
        private = next((rule for rule in self.private if rule.matches(path)), None)
        plain = next((rule for rule in self.plain if rule.matches(path)), None)
        if not (private or plain):
            return Decision("skip", "Percorso non selezionato.")
        exact = any(rule.path == path for rule in self.roots)
        if not directory and path.name.casefold() in self.ignored_file_names and not exact:
            return Decision('skip', 'Nome file ignorato dalla policy.',
                            'settings.toml:[policy].ignored_file_names')
        named_directories = ([path] if directory else []) + list(path.parents)
        private_by_name = any(
            ancestor != Path('/')
            and ancestor.name.casefold() in self.private_directory_names
            and not any(rule.path == ancestor for rule in self.plain)
            for ancestor in named_directories
        )
        # Classify remote files using the same directory pruning as the local
        # scanner. Otherwise an older cloud copy under a newly protected
        # directory would be mistaken for a local deletion and archived.
        for ancestor in path.parents:
            if ancestor == Path('/'):
                break
            protected_ancestor = next(
                (pattern for pattern in self.patterns
                 if fnmatch.fnmatchcase(ancestor.name.casefold(), pattern.casefold())), None
            )
            if (protected_ancestor and ancestor.name.casefold() not in self.private_directory_names
                    and not any(rule.path == ancestor for rule in self.roots)):
                return Decision(
                    "skip", "Directory antenata protetta: richiede inclusione esatta.",
                    protected_pattern=protected_ancestor,
                )
        protected = next(
            (pattern for pattern in self.patterns
             if fnmatch.fnmatchcase(path.name.casefold(), pattern.casefold())), None
        )
        if protected and not exact and not (directory and path.name.casefold() in self.private_directory_names):
            return Decision(
                "skip", "Richiede un'inclusione esatta del percorso (explicit-only).",
                protected_pattern=protected,
            )
        if check_gitignore and self.gitignore is not None and not exact and not private_by_name:
            ignored, source = self.gitignore.match(path)
            if ignored:
                return Decision('skip', 'Escluso da .gitignore.', source)
        if private:
            return Decision("private", "Inclusione privata.", str(private.path), protected, exact)
        if private_by_name:
            return Decision("private", "Directory cifrata per nome.",
                            'settings.toml:[policy].private_directory_names', protected, exact)
        if not directory and any(inside(path, root) or inside(physical, root) for root in self.credential_roots):
            return Decision(
                "error", "Configurazione rclone selezionata in chiaro: aggiungere "
                "il percorso a private-paths.txt o escluderlo.", str(plain.path)
            )
        return Decision("plain", "Inclusione normale.", str(plain.path), protected, exact)


def file_kind(info: os.stat_result) -> str:
    if stat.S_ISDIR(info.st_mode):
        return "directory"
    if stat.S_ISREG(info.st_mode):
        return "file"
    if stat.S_ISLNK(info.st_mode):
        return "symlink"
    return "special"


class MacXattrs:
    """Use fd-based native APIs: Python's os xattr APIs are absent on macOS."""
    def __init__(self):
        if sys.platform != "darwin":
            raise ConfigError("Le icone Finder richiedono macOS.")
        import ctypes
        self.c = ctypes
        self.lib = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
        self.lib.fgetxattr.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_void_p,
                                      ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
        self.lib.fgetxattr.restype = ctypes.c_ssize_t
        self.lib.fsetxattr.argtypes = self.lib.fgetxattr.argtypes
        self.lib.fsetxattr.restype = ctypes.c_int

    def get(self, fd: int, name: str) -> bytes | None:
        size = self.lib.fgetxattr(fd, name.encode(), None, 0, 0, 0)
        if size < 0:
            error = self.c.get_errno()
            if error == 93:  # ENOATTR on Darwin
                return None
            raise OSError(error, "Impossibile leggere il metadato " + name)
        if size > 64 * 1024 * 1024:
            raise ConfigError("Metadato icona oltre 64 MiB: operazione bloccata.")
        buffer = self.c.create_string_buffer(size)
        if self.lib.fgetxattr(fd, name.encode(), buffer, size, 0, 0) != size:
            raise OSError("Il metadato dell'icona è cambiato durante la lettura.")
        return buffer.raw

    def set(self, fd: int, name: str, value: bytes) -> None:
        if self.lib.fsetxattr(fd, name.encode(), value, len(value), 0, 0):
            raise OSError(self.c.get_errno(), "Impossibile ripristinare il metadato " + name)


def icon_snapshot(entry: Entry) -> dict:
    api = MacXattrs()
    path = Path(entry.path)
    parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open(FINDER_ICON, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            before = os.fstat(fd)
            if not stat.S_ISREG(before.st_mode) or (before.st_dev, before.st_ino) != (entry.device, entry.inode):
                raise ConfigError("L'icona è stata sostituita dopo la scansione.")
            if before.st_size > 64 * 1024 * 1024:
                raise ConfigError("File icona oltre 64 MiB: operazione bloccata.")
            with os.fdopen(os.dup(fd), "rb") as stream:
                data = stream.read(64 * 1024 * 1024 + 1)
            if len(data) > 64 * 1024 * 1024:
                raise ConfigError("File icona cresciuto oltre 64 MiB durante la lettura.")
            attrs = {name: api.get(fd, name) for name in ('com.apple.ResourceFork', 'com.apple.FinderInfo')}
            finder = api.get(parent, 'com.apple.FinderInfo')
            after = os.fstat(fd)
            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ConfigError("L'icona è cambiata durante la lettura.")
        finally:
            os.close(fd)
    finally:
        os.close(parent)
    if any(value is not None and len(value) != 32 for value in (finder, attrs['com.apple.FinderInfo'])):
        raise ConfigError("FinderInfo non ha la dimensione attesa: operazione bloccata.")
    encode = lambda value: None if value is None else base64.b64encode(value).decode('ascii')
    return {'schema_version': 1, 'kind': 'macos-finder-icon', 'source': entry.path,
            'data_base64': encode(data), 'file_xattrs': {k: encode(v) for k, v in attrs.items()},
            'folder_finder_info': encode(finder)}


def restore_icon(file: Path, folder: Path, replace: bool) -> dict:
    if file.stat().st_size > 180 * 1024 * 1024:
        raise ConfigError("File di recupero icona troppo grande.")
    snapshot = json.loads(file.read_text())
    if (not isinstance(snapshot, dict) or type(snapshot.get('schema_version')) is not int or snapshot.get('schema_version') != 1
            or snapshot.get('kind') != 'macos-finder-icon'):
        raise ConfigError("Formato di recupero icona non riconosciuto.")
    try:
        decode = lambda value: base64.b64decode(value, validate=True)
        data = decode(snapshot['data_base64'])
        attrs = snapshot['file_xattrs']
        if not isinstance(attrs, dict) or set(attrs) != {'com.apple.ResourceFork', 'com.apple.FinderInfo'}:
            raise ValueError("Attributi inattesi")
        attrs = {k: None if v is None else decode(v) for k, v in attrs.items()}
        finder = snapshot['folder_finder_info']
        finder = None if finder is None else decode(finder)
        if any(value is not None and len(value) != 32 for value in (finder, attrs['com.apple.FinderInfo'])):
            raise ValueError("FinderInfo non valido")
    except (KeyError, TypeError, ValueError) as exc:
        raise ConfigError("Dati di recupero icona non validi.") from exc
    api = MacXattrs()
    directory = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = '.macbackup-icon-' + uuid.uuid4().hex
    try:
        current = api.get(directory, 'com.apple.FinderInfo') or bytes(32)
        if len(current) != 32:
            raise ConfigError("FinderInfo della cartella di destinazione non valido.")
        flags = int.from_bytes(current[8:10], 'big') & ~0x0400
        flags |= int.from_bytes((finder or bytes(32))[8:10], 'big') & 0x0400
        updated = current[:8] + flags.to_bytes(2, 'big') + current[10:]
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            with os.fdopen(os.dup(fd), 'wb') as stream:
                stream.write(data)
            for name, value in attrs.items():
                if value is not None:
                    api.set(fd, name, value)
        finally:
            os.close(fd)
        if replace:
            os.rename(temporary, FINDER_ICON, src_dir_fd=directory, dst_dir_fd=directory)
        else:
            try:
                os.link(temporary, FINDER_ICON, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
            except FileExistsError as exc:
                raise ConfigError("Icona già presente: usare --replace per sostituire soltanto l'icona.") from exc
            os.unlink(temporary, dir_fd=directory)
        api.set(directory, 'com.apple.FinderInfo', updated)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)
    return {'ok': True, 'folder': str(folder), 'note': 'Icona ripristinata; nessun accesso cloud.'}


def scan_policy(policy: Policy) -> Scan:
    result = Scan([], [], [])
    seen: set[Path] = set()

    def visit(path: Path, parent_fd: int | None = None, child: str | None = None) -> None:
        if path in seen:
            return
        seen.add(path)
        # Absolute exclusions are authoritative, even for missing included roots.
        preliminary = policy.decide(path, directory=True, check_gitignore=False)
        if preliminary.action == "skip" and preliminary.rule:
            result.entries.append(Entry(str(path), "excluded-subtree", 0, preliminary, 0, 0))
            return
        try:
            info = (os.stat(child, dir_fd=parent_fd, follow_symlinks=False)
                    if parent_fd is not None else path.lstat())
            kind = file_kind(info)
            if path.name == FINDER_ICON:
                if kind != 'file':
                    result.errors.append(f"{path.parent}: Icon\\r deve essere un file regolare.")
                    return
                kind = 'finder-icon'
            decision = policy.decide(path, directory=kind == "directory")
            if decision.action == "error":
                result.errors.append(f"{path}: {decision.reason}")
                return
            if kind == "directory":
                if decision.action == "skip":
                    if decision.protected_pattern or decision.reason == 'Escluso da .gitignore.':
                        result.entries.append(Entry(str(path), "excluded-subtree", 0, decision, 0, 0))
                    return
                # Anchor traversal to directory descriptors and refuse replaced
                # symlinks. Explicit root paths may have symlinked ancestors.
                flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                fd = (os.open(child, flags, dir_fd=parent_fd)
                      if parent_fd is not None else os.open(path, flags))
                try:
                    opened = os.fstat(fd)
                    if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                        raise OSError("La directory è cambiata durante il controllo.")
                    with os.scandir(fd) as iterator:
                        names = sorted(entry.name for entry in iterator)
                    valid_names = []
                    for name in names:
                        try:
                            absolute_path(str(path)) if name == FINDER_ICON else absolute_path(str(path / name))
                        except ConfigError as exc:
                            result.errors.append(f"Nome non rappresentabile in {path}: {exc}")
                            continue
                        valid_names.append(name)
                    if policy.gitignore is not None:
                        policy.gitignore.preload([path / name for name in valid_names])
                    for name in valid_names:
                        visit(path / name, fd, name)
                finally:
                    os.close(fd)
                return
            if kind == "special":
                if any(rule.path == path for rule in policy.roots):
                    result.errors.append(f"{path}: sorgente speciale non supportata.")
                else:
                    result.warnings.append(f"{path}: socket, FIFO o dispositivo saltato.")
                    decision = Decision("skip", "File speciale non supportato.")
            if decision.action in ("plain", "private"):
                if kind in ("file", "finder-icon") and not os.access(path, os.R_OK):
                    result.errors.append(f"{path}: file non leggibile.")
                if kind == "file" and path.name.endswith(".rclonelink"):
                    result.errors.append(f"{path}: nome riservato alla rappresentazione dei link rclone.")
                if kind == "symlink":
                    result.warnings.append(f"{path}: collegamento; destinazione non attraversata.")
                if decision.action == "plain" and decision.protected_pattern:
                    result.warnings.append(f"{path}: nome protetto autorizzato ESPLICITAMENTE in chiaro.")
            result.entries.append(Entry(
                str(path), kind, info.st_size, decision, info.st_dev, info.st_ino
            ))
        except OSError as exc:
            result.errors.append(f"{path}: {exc}")

    for rule in sorted(policy.roots, key=lambda item: (len(item.path.parts), str(item.path))):
        visit(rule.path)

    identities: dict[tuple[int, int], list[Entry]] = defaultdict(list)
    for entry in result.entries:
        if entry.kind in ("file", "finder-icon"):
            identities[(entry.device, entry.inode)].append(entry)
    for aliases in identities.values():
        selected = [entry for entry in aliases if entry.decision.action in ("plain", "private")]
        if {entry.decision.action for entry in selected} == {"plain", "private"}:
            result.errors.append(
                "Stesso file raggiunto come normale e privato: "
                + ", ".join(entry.path for entry in selected)
            )
        protected = [entry for entry in aliases if entry.decision.protected_pattern]
        for entry in selected:
            if protected and not entry.decision.explicit and not entry.decision.protected_pattern:
                result.errors.append(
                    f"{entry.path}: alias di un file con nome protetto; "
                    "serve un'inclusione esatta anche per questo percorso."
                )
    result.entries.sort(key=lambda entry: entry.path)
    result.errors = sorted(set(result.errors))
    result.warnings = sorted(set(result.warnings))
    return result


def split_layout(policy: Policy, root: Path) -> dict:
    if not root.is_dir() or root.is_symlink():
        raise ConfigError('layout richiede una directory locale reale.')
    if policy.decide(root, directory=True).action != 'plain':
        raise ConfigError('layout richiede una directory selezionata in plain.')
    scan = scan_policy(policy)
    if scan.errors:
        return {'scope': 'local-only', 'ok': False, 'path': str(root),
                'errors': scan.errors, 'warnings': scan.warnings, 'private_subtrees': []}
    groups: dict[str, dict] = {}
    plain_count = 0
    private_count = 0
    action_cache: dict[Path, str] = {}

    def directory_action(path: Path) -> str:
        if path not in action_cache:
            action_cache[path] = policy.decide(path, directory=True).action
        return action_cache[path]

    for entry in scan.entries:
        path = Path(entry.path)
        if not inside(path, root) or entry.decision.action not in ('plain', 'private'):
            continue
        if entry.decision.action == 'plain':
            plain_count += 1
            continue
        private_count += 1
        boundary = path
        while boundary.parent != boundary and inside(boundary.parent, root):
            parent_action = directory_action(boundary.parent)
            if parent_action == 'plain':
                key = str(boundary)
                item = groups.setdefault(key, {
                    'path': key, 'kind': entry.kind if boundary == path else 'directory',
                    'private_items': 0, 'selected_bytes': 0,
                    'logical_destination': 'private/current' + key,
                })
                item['private_items'] += 1
                item['selected_bytes'] += entry.size
                break
            if parent_action != 'private':
                break
            boundary = boundary.parent
    return {'scope': 'local-only', 'ok': True, 'path': str(root),
            'plain_items': plain_count, 'private_items': private_count,
            'private_subtrees': [groups[key] for key in sorted(groups)],
            'warnings': scan.warnings,
            'note': 'Classificazione locale attuale; nessun accesso cloud. Le copie storiche non sono elencate.'}


def init_config(directory: Path, home: Path) -> list[str]:
    templates = {
        "plain-paths.txt": "# Percorsi assoluti da salvare consultabili; nessuna inclusione attiva.\n"
        f"# {home}/Desktop/\n# {home}/Documents/\n# {home}/.config/\n# {home}/.dotfiles/\n",
        "private-paths.txt": "# Percorsi assoluti da salvare cifrati; nessuna inclusione attiva.\n"
        f"# {home}/.ssh/\n# {home}/.config/rclone/\n",
        "exclude-paths.txt": "# Esclusioni assolute, prevalgono sulle inclusioni esatte; nessuna esclusione attiva.\n",
        PATTERN_FILE: "# File e cartelle ammessi soltanto tramite inclusione esatta, anche nell'area privata.\n.env\n.env.*\n",
    }
    templates["settings.toml"] = SETTINGS_TEMPLATE
    if any(os.path.lexists(directory / name) for name in templates):
        raise ConfigError("Configurazione già presente, anche parzialmente: nessun file sovrascritto.")
    if directory.is_symlink():
        raise ConfigError("La directory di configurazione non può essere un collegamento per init.")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    created = []
    try:
        for name, contents in templates.items():
            path = directory / name
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            created.append(path)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(contents)
    except OSError:
        for path in created:
            path.unlink(missing_ok=True)
        raise
    return [str(path) for path in created]


class TransportError(Exception):
    pass


class TransferProblem(TransportError):
    def __init__(self, message: str, stats: dict | None = None):
        super().__init__(message)
        self.stats = stats


class TransferInterrupted(Exception):
    def __init__(self, stats: dict | None = None):
        self.stats = stats


def active_directories(stats: dict, home: Path, depth: int) -> list[str]:
    groups = set()
    prefix = str(home).lstrip('/') + '/'
    for item in stats.get('transferring', []):
        name = item.get('name') if isinstance(item, dict) else None
        if not isinstance(name, str):
            continue
        if name.startswith(prefix):
            parts = name[len(prefix):].split('/')
            folders = parts[:-1] or parts
            groups.add('~/' + '/'.join(folders[:depth]))
        elif name:
            parts = name.lstrip('/').split('/')
            folders = parts[:-1] or parts
            groups.add('/' + '/'.join(folders[:depth]))
    return sorted(groups)


def progress_quantity(value: object, binary: bool) -> str:
    if not isinstance(value, (int, float)) or value < 0:
        return '?'
    base = 1024 if binary else 1000
    units = ('B', 'KiB', 'MiB', 'GiB', 'TiB') if binary else ('B', 'kB', 'MB', 'GB', 'TB')
    number = float(value)
    unit = 0
    while number >= base and unit < len(units) - 1:
        number /= base
        unit += 1
    return f'{number:.1f} {units[unit]}' if unit else f'{int(number)} B'


def progress_duration(value: object) -> str:
    if not isinstance(value, (int, float)) or value < 0:
        return '?'
    seconds = int(value)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    parts = []
    for amount, suffix in ((days, 'd'), (hours, 'h'), (minutes, 'm')):
        if amount or parts:
            parts.append(f'{amount}{suffix}')
    parts.append(f'{seconds}s')
    return ' '.join(parts)


def progress_bar(done: object, total: object, width: int = 28) -> str:
    if not isinstance(done, (int, float)) or not isinstance(total, (int, float)) or total <= 0:
        return '[' + '-' * width + ']  ?%'
    ratio = max(0.0, min(1.0, done / total))
    filled = min(width, int(ratio * width))
    return '[' + '#' * filled + '-' * (width - filled) + f'] {ratio * 100:5.1f}%'


def progress_lines(stats: dict | None, home: Path, depth: int, binary: bool,
                   legend: bool, label: str, width: int = 90) -> list[str]:
    stats = stats or {}
    bar_width = max(12, min(36, width - 55))
    lines = [f'macbackup  {label}  |  Tempo {progress_duration(stats.get("elapsedTime"))}', '']
    byte_count = stats.get('bytes', 0)
    total_bytes = stats.get('totalBytes')
    transfers = stats.get('transfers', 0)
    total_transfers = stats.get('totalTransfers')
    lines.extend((
        f'Dati       {progress_bar(byte_count, total_bytes, bar_width)}  '
        f'{progress_quantity(byte_count, binary)} / {progress_quantity(total_bytes, binary)}',
        f'File       {progress_bar(transfers, total_transfers, bar_width)}  '
        f'{transfers} / {total_transfers if isinstance(total_transfers, int) else "?"}',
        '',
        f'VELOCITÀ  {progress_quantity(stats.get("speed"), binary)}/s'
        f'     Tempo stimato {progress_duration(stats.get("eta"))}',
        f'Verifiche {stats.get("checks", 0)} / {stats.get("totalChecks", "?")}'
        f'     Esaminati {stats.get("listed", "?")}',
        f'Spostati sul cloud {stats.get("serverSideMoves", 0)}'
        f' ({progress_quantity(stats.get("serverSideMoveBytes", 0), binary)})'
        f'     Rinominati {stats.get("renames", 0)}',
        '',
    ))
    folders = active_directories(stats, home, depth)
    lines.append('Cartelle attive: ' + (', '.join(folders) if folders else 'nessuna'))
    lines.append('File attivi:')
    active = stats.get('transferring', [])
    if not active:
        lines.append('  nessuno')
    for item in active:
        if not isinstance(item, dict):
            continue
        name = item.get('name', '?')
        lines.append('  ' + str(name))
        lines.append('    ' + progress_bar(item.get('bytes'), item.get('size'), 12)
                     + '  ' + progress_quantity(item.get('bytes'), binary)
                     + ' / ' + progress_quantity(item.get('size'), binary)
                     + '  |  ' + progress_quantity(item.get('speed'), binary) + '/s')
    lines.extend(('', f'[u] Unità: {"binaria (KiB, MiB, GiB)" if binary else "decimale (kB, MB, GB)"}'
                  '    [?] Legenda    [Ctrl-C] Interrompi'))
    if legend:
        lines.extend((
            'Dati: byte trasferiti / byte previsti nella fase corrente.',
            'File: trasferimenti completati / previsti; può differire dalla percentuale dei dati.',
            'Verifiche: confronti eseguiti. Esaminati: file e cartelle incontrati, anche locali.',
            'Spostati sul cloud: operazioni remote, incluse vecchie copie mandate nello storico.',
            'Tempo stimato: stima variabile. Le cifre dopo Ctrl-C sono l’ultimo rapporto parziale.',
        ))
    return lines


class ProgressDisplay:
    def __init__(self, home: Path, depth: int, label: str):
        self.home, self.depth, self.label = home, depth, label
        self.binary = True
        self.legend = False
        self.stats: dict | None = None
        self.interactive = sys.stdin.isatty() and sys.stderr.isatty()
        self.terminal_settings = None

    def __enter__(self):
        if self.interactive:
            try:
                self.terminal_settings = termios.tcgetattr(sys.stdin.fileno())
                tty.setcbreak(sys.stdin.fileno())
                sys.stderr.write('\x1b[?1049h\x1b[?25l')
                self.draw()
            except (OSError, termios.error):
                self.interactive = False
                if self.terminal_settings is not None:
                    termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.terminal_settings)
                    self.terminal_settings = None
        return self

    def __exit__(self, *_exc):
        if self.interactive:
            sys.stderr.write('\x1b[?25h\x1b[?1049l')
            sys.stderr.flush()
        if self.terminal_settings is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.terminal_settings)
        if self.interactive and self.stats is not None:
            print('\n'.join(progress_lines(self.stats, self.home, self.depth,
                                           self.binary, False, self.label)), file=sys.stderr, flush=True)

    def draw(self):
        if not self.interactive:
            return
        width = shutil.get_terminal_size((90, 30)).columns
        lines = progress_lines(self.stats, self.home, self.depth,
                               self.binary, self.legend, self.label, width)
        sys.stderr.write('\x1b[H\x1b[2J' + '\n'.join(lines) + '\n')
        sys.stderr.flush()

    def update(self, stats: dict):
        self.stats = stats
        if self.interactive:
            self.draw()
        else:
            print('\n'.join(progress_lines(stats, self.home, self.depth,
                                           self.binary, False, self.label)), file=sys.stderr, flush=True)

    def key(self, data: bytes):
        if b'u' in data.lower():
            self.binary = not self.binary
        if b'?' in data:
            self.legend = not self.legend
        self.draw()


def rclone_progress_call(arguments: list[str], home: Path, depth: int, label: str = '') -> dict | None:
    executable = shutil.which('rclone')
    if executable is None:
        raise ConfigError('rclone non è disponibile nel PATH.')
    try:
        process = subprocess.Popen(
            [executable, '--ask-password=false', *arguments],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            env=transport_env(),
        )
    except OSError as exc:
        raise TransferProblem(f'Impossibile avviare rclone: {exc}') from exc
    latest = None
    errors: list[str] = []
    try:
        assert process.stderr is not None
        pending = b''
        with ProgressDisplay(home, depth, label) as display:
            while True:
                watched = [process.stderr.fileno()]
                if display.interactive:
                    watched.append(sys.stdin.fileno())
                ready, _, _ = select.select(watched, [], [], 0.5)
                if display.interactive and sys.stdin.fileno() in ready:
                    display.key(os.read(sys.stdin.fileno(), 32))
                if process.stderr.fileno() not in ready:
                    continue
                chunk = os.read(process.stderr.fileno(), 65536)
                if not chunk:
                    break
                pending += chunk
                while b'\n' in pending:
                    raw, pending = pending.split(b'\n', 1)
                    line = raw.decode('utf-8', 'replace')
                    try:
                        event = json.loads(line)
                    except ValueError:
                        if line.strip():
                            errors.append(line.rstrip())
                            errors = errors[-5:]
                        continue
                    stats = event.get('stats') if isinstance(event, dict) else None
                    if isinstance(stats, dict):
                        latest = stats
                        display.update(stats)
                    elif isinstance(event, dict) and event.get('level') in ('error', 'fatal'):
                        message = str(event.get('msg', line.rstrip()))
                        errors.append(message)
                        errors = errors[-5:]
                        if not display.interactive:
                            print(message, file=sys.stderr, flush=True)
            code = process.wait()
    except KeyboardInterrupt as exc:
        if process.poll() is None:
            process.send_signal(signal.SIGINT)
        try:
            process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            process.terminate()
            process.communicate()
        raise TransferInterrupted(latest) from exc
    finally:
        if process.stderr is not None:
            process.stderr.close()
    if code:
        raise TransferProblem(f'rclone è terminato con codice {code}: '
                              + ('; '.join(errors)[-1500:] if errors else 'vedere i messaggi sopra.'), latest)
    return latest


def transfer_metrics(stats: dict | None, complete: bool) -> dict:
    fields = {'transferred_files': 'transfers', 'transferred_bytes': 'bytes',
              'checked_files': 'checks', 'listed_items': 'listed',
              'renamed_files': 'renames', 'server_side_moves': 'serverSideMoves',
              'server_side_move_bytes': 'serverSideMoveBytes'}
    if not isinstance(stats, dict) or any(type(stats.get(name)) is not int or stats[name] < 0
                                          for name in ('transfers', 'bytes', 'checks')):
        return {name: None for name in fields} | {'counts_complete': False}
    return {name: stats[key] if type(stats.get(key)) is int and stats[key] >= 0 else None
            for name, key in fields.items()} | {'counts_complete': complete}


def transport_env() -> dict[str, str]:
    # Ambient rclone filter/delete overrides must not change the selected scope.
    allowed = {"RCLONE_CONFIG", "RCLONE_CONFIG_PASS", "RCLONE_PASSWORD_COMMAND"}
    return {key: value for key, value in os.environ.items()
            if not key.startswith("RCLONE_") or key in allowed}


def rclone_call(*args: str, missing_ok: bool = False, allowed_codes: tuple = (0,)) -> str:
    executable = shutil.which("rclone")
    if executable is None:
        raise ConfigError("rclone non è disponibile nel PATH.")
    try:
        result = subprocess.run(
            [executable, "--ask-password=false", *args],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, env=transport_env(),
        )
    except OSError as exc:
        raise TransportError(f"Impossibile avviare rclone: {exc}") from exc
    if result.returncode not in allowed_codes:
        if missing_ok and result.returncode == 3:
            try:
                empty = (result.stdout.strip() in ("", "[", "[]")
                         or json.loads(result.stdout) == [])
            except ValueError:
                empty = False
            if empty and "directory not found" in result.stderr.lower():
                return "[]"
        detail = result.stderr.strip()[-3000:] if result.stderr else 'vedere i messaggi rclone nel terminale.'
        raise TransportError(f"rclone è terminato con codice {result.returncode}: " + detail)
    return result.stdout or ''


def load_targets(config: Path, target: str, require_enabled: bool = True) -> tuple[dict, int]:
    try:
        import tomllib
    except ImportError as exc:
        raise ConfigError("Le operazioni rclone richiedono Python 3.11 o successivo.") from exc
    try:
        settings = tomllib.loads((config / "settings.toml").read_text())
    except (OSError, ValueError) as exc:
        raise ConfigError(f"Impossibile leggere settings.toml: {exc}") from exc
    if type(settings.get("schema_version")) is not int or settings.get("schema_version") != 1:
        raise ConfigError("settings.toml: schema_version deve essere 1.")
    limit = settings.get("max_delete", 25)
    if type(limit) is not int or not 0 <= limit <= 10000:
        raise ConfigError("max_delete deve essere un intero fra 0 e 10000.")
    names = ("google", "proton") if target == "all" else (target,)
    configured = settings.get("targets", {})
    if not isinstance(configured, dict):
        raise ConfigError("settings.toml: targets deve essere una tabella.")
    chosen = {}
    for name in names:
        item = configured.get(name, {})
        if not isinstance(item, dict):
            raise ConfigError(f"settings.toml: targets.{name} deve essere una tabella.")
        if require_enabled and item.get("enabled") is not True:
            raise ConfigError(f"Destinazione {name} non abilitata in settings.toml.")
        for area in ("plain", "private"):
            value = item.get(area)
            if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]+:[^\x00-\x1f\x7f]*", value):
                raise ConfigError(f"Destinazione {name}/{area} non valida.")
            tail = value.split(":", 1)[1]
            if ":" in tail or tail.startswith("/") or ".." in tail.split("/"):
                raise ConfigError(f"Destinazione {name}/{area}: usare un percorso remoto relativo sicuro.")
            if area == "plain" and not tail.rstrip("/").endswith("/plain"):
                raise ConfigError("L'area normale deve essere dedicata e terminare con '/plain'.")
        chosen[name] = {area: item[area].rstrip("/") for area in ("plain", "private")}
    remotes = {item["name"]: item["type"] for item in json.loads(rclone_call("listremotes", "--json"))}
    for name, areas in chosen.items():
        for area, remote in areas.items():
            key = remote.split(":", 1)[0]
            if key not in remotes:
                raise ConfigError(f"Remote {key} non configurato. Completa prima rclone config.")
            if area == "private" and remotes[key] != "crypt":
                raise ConfigError(f"{name}/private deve usare un remote di tipo crypt; trasferimento bloccato.")
            if area == "plain":
                features = json.loads(rclone_call("backend", "features", key + ":"))
                if not features.get("Hashes"):
                    raise ConfigError(f"{name}/plain non offre hash per un confronto affidabile; operazione bloccata.")
    return chosen, limit


def remote_join(root: str, relative: str) -> str:
    return root + ("" if root.endswith(":") else "/") + relative


def terminal_can_color(stream) -> bool:
    if not stream.isatty() or os.environ.get('PYTHON_COLORS') == '0':
        return False
    if os.environ.get('PYTHON_COLORS') == '1':
        return True
    if os.environ.get('NO_COLOR'):
        return False
    return bool(os.environ.get('FORCE_COLOR')) or os.environ.get('TERM') != 'dumb'


def terminal_style(value: str, code: str, stream) -> str:
    return f'\x1b[{code}m{value}\x1b[0m' if terminal_can_color(stream) else value


class MountPulse:
    """An indeterminate bar: inventory size and mount time are not known ahead."""

    def __init__(self, label: str):
        self.label = label
        self.started = time.monotonic()
        self.interactive = sys.stderr.isatty()
        if not self.interactive:
            print(f'{label}: in corso...', file=sys.stderr, flush=True)

    def draw(self, metadata_bytes: int | None = None) -> None:
        if not self.interactive:
            return
        width, block = 22, 5
        offset = int((time.monotonic() - self.started) * 5) % (width + block)
        bar = ''.join('#' if (index - offset) % (width + block) < block else '.'
                      for index in range(width))
        elapsed = int(time.monotonic() - self.started)
        detail = (f'  metadati {metadata_bytes / 1048576:.1f} MiB'
                  if metadata_bytes is not None else '')
        title = terminal_style(self.label, '1;36', sys.stderr)
        progress = terminal_style(f'[{bar}]', '34', sys.stderr)
        sys.stderr.write(f'\r\x1b[2K{title} {progress} {elapsed}s{detail}')
        sys.stderr.flush()

    def done(self, detail: str) -> None:
        if self.interactive:
            sys.stderr.write('\r\x1b[2K')
        elapsed = int(time.monotonic() - self.started)
        color = '31' if detail == 'errore' else '33' if detail == 'interrotto' else '32'
        status = terminal_style(detail, color, sys.stderr)
        title = terminal_style(self.label, '1;36', sys.stderr)
        print(f'{title}: {status} ({elapsed}s).', file=sys.stderr, flush=True)


def mount_input_wait(input_fd: int | None, timeout: float) -> None:
    """Wait for the next mount check while discarding typed characters."""
    if input_fd is None:
        time.sleep(timeout)
    elif select.select([input_fd], [], [], timeout)[0]:
        os.read(input_fd, 4096)


def mount_inventory(root: str, label: str, input_fd: int | None = None) -> list[dict]:
    executable = shutil.which('rclone')
    if executable is None:
        raise ConfigError('rclone non è disponibile nel PATH.')
    pulse = MountPulse(f'Inventario {label}')
    with tempfile.TemporaryFile(mode='w+t', encoding='utf-8') as output, \
            tempfile.TemporaryFile(mode='w+t', encoding='utf-8') as errors:
        try:
            process = subprocess.Popen(
                [executable, '--ask-password=false', 'lsjson', root,
                 '--recursive', '--links'],
                stdout=output, stderr=errors, env=transport_env(),
                start_new_session=True)
        except OSError as exc:
            pulse.done('errore')
            raise TransportError(f'Impossibile avviare rclone: {exc}') from exc
        try:
            while process.poll() is None:
                pulse.draw(os.fstat(output.fileno()).st_size)
                mount_input_wait(input_fd, 0.2)
            code = process.wait()
        except KeyboardInterrupt as exc:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
            pulse.done('interrotto')
            raise ConfigError('Montaggio interrotto dall’utente.') from exc
        output.seek(0)
        errors.seek(0)
        raw, detail = output.read(), errors.read()
        if code == 3 and (not raw.strip() or raw.strip() == '[]') \
                and 'directory not found' in detail.lower():
            raw = '[]'
        elif code != 0:
            pulse.done('errore')
            raise TransportError(f'Inventario {label}: rclone è terminato con codice {code}: '
                                 + detail.strip()[-1200:])
    try:
        items = json.loads(raw)
    except ValueError as exc:
        pulse.done('errore')
        raise TransportError(f'Inventario {label}: risposta JSON non valida.') from exc
    if not isinstance(items, list):
        pulse.done('errore')
        raise TransportError(f'Inventario {label}: formato inatteso.')
    pulse.done(f'{len(items)} voci lette')
    return items


def mount_current_conflicts(roots: dict[str, str], target: str = '',
                            input_fd: int | None = None) -> None:
    """Refuse a merged view if an object could mask one from the other area."""
    inventories = []
    for area in ('plain', 'private'):
        objects = {}
        for item in mount_inventory(remote_join(roots[area], 'current'),
                                    f'{target}/{area}' if target else area, input_fd):
            path = item.get('Path')
            if (not isinstance(path, str) or not path or path.startswith('/')
                    or any(part in ('', '.', '..') for part in path.split('/'))):
                raise TransportError('Il cloud ha restituito un percorso non valido; montaggio bloccato.')
            objects[path] = bool(item.get('IsDir'))
        inventories.append(objects)
    plain, private = inventories
    conflicts = sorted(path for path in plain.keys() & private.keys()
                       if not plain[path] or not private[path])
    if conflicts:
        examples = ', '.join('/' + path for path in conflicts[:5])
        remaining = f' (e altri {len(conflicts) - 5})' if len(conflicts) > 5 else ''
        raise ConfigError(
            f'current contiene {len(conflicts)} percorsi in conflitto fra plain e private: '
            f'{examples}{remaining}. Il volume unificato non è stato montato; '
            'consultare le aree con --area plain e --area private.')


def mount_merged_env(roots: dict[str, str]) -> tuple[str, dict[str, str]]:
    suffix = uuid.uuid4().hex[:12]
    names = {part: f'macbackup_mount_{suffix}_{part}'
             for part in ('current', 'history', 'icons', 'view')}
    prefix = lambda part: 'RCLONE_CONFIG_' + names[part].upper() + '_'
    env = {
        prefix('current') + 'TYPE': 'union',
        prefix('current') + 'UPSTREAMS': ' '.join(
            json.dumps(remote_join(roots[area], 'current') + ':ro')
            for area in ('private', 'plain')),
        prefix('current') + 'SEARCH_POLICY': 'epall',
        prefix('history') + 'TYPE': 'combine',
        prefix('history') + 'UPSTREAMS': ' '.join(
            json.dumps(f'{area}={remote_join(roots[area], "history")}')
            for area in ('plain', 'private')),
        prefix('icons') + 'TYPE': 'combine',
        prefix('icons') + 'UPSTREAMS': ' '.join(
            json.dumps(f'{area}={remote_join(roots[area], "macos-icons")}')
            for area in ('plain', 'private')),
        prefix('view') + 'TYPE': 'combine',
        prefix('view') + 'UPSTREAMS': ' '.join(
            f'{part}={names[part]}:' for part in ('current', 'history', 'icons')),
    }
    return names['view'] + ':', env


@contextmanager
def discard_mount_input():
    """Hide and discard terminal input while a foreground mount is active."""
    if not sys.stdin.isatty():
        yield None
        return
    fd = sys.stdin.fileno()
    original = termios.tcgetattr(fd)
    active = termios.tcgetattr(fd)
    active[3] &= ~(termios.ECHO | termios.ICANON)
    active[0] &= ~termios.IXON
    active[6][termios.VMIN] = 1
    active[6][termios.VTIME] = 0
    disabled = os.fpathconf(fd, 'PC_VDISABLE')
    for name in ('VQUIT', 'VSUSP', 'VDSUSP'):
        index = getattr(termios, name, None)
        if index is not None:
            active[6][index] = bytes((disabled,))
    try:
        termios.tcsetattr(fd, termios.TCSAFLUSH, active)
        yield fd
    finally:
        termios.tcsetattr(fd, termios.TCSAFLUSH, original)


def mount_operation(args, config: Path, home: Path) -> int:
    with discard_mount_input() as input_fd:
        return _mount_operation(args, config, home, input_fd)


def _mount_operation(args, config: Path, home: Path, input_fd: int | None) -> int:
    if sys.platform != 'darwin':
        raise ConfigError('Il montaggio macbackup richiede macOS.')
    targets, _ = load_targets(config, args.target)
    policy = Policy(config, home)
    base = absolute_path(args.mountpoint) if args.mountpoint else home / 'Desktop'
    if args.area == 'all':
        mounts = []
        for name, roots in targets.items():
            mount_current_conflicts(roots, name, input_fd)
            view, env = mount_merged_env(roots)
            mounts.append((name, 'all', view, base / name, env))
    else:
        mounts = [(name, args.area, roots[args.area], base / f'{name}-{args.area}', {})
                  for name, roots in targets.items()]
    for _, _, _, point, _ in mounts:
        if point not in policy.mount_roots and any(
                inside(point, rule.path) or inside(rule.path, point) for rule in policy.roots):
            raise ConfigError(f'{point}: il montaggio si sovrappone a una sorgente del backup.')
        ancestors_below_home = []
        for ancestor in (point, *point.parents):
            if ancestor == home:
                break
            ancestors_below_home.append(ancestor)
        if any(ancestor.is_symlink() for ancestor in ancestors_below_home):
            raise ConfigError(f'{point}: il percorso del montaggio attraversa un collegamento simbolico.')
        if os.path.ismount(point):
            raise ConfigError(f'{point}: già montato.')
        if point.exists() and (not point.is_dir() or any(point.iterdir())):
            raise ConfigError(f'{point}: occorre una directory vuota.')
    state = home / '.local/state/macbackup'
    if state.is_symlink():
        raise ConfigError('La directory di stato non può essere un collegamento.')
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(state, 0o700)
    processes = []
    created_points = []
    mounted_points = set()
    interrupted = False
    try:
        for name, area, remote, point, extra_env in mounts:
            created = not point.exists()
            if created:
                point.mkdir(parents=True, mode=0o700)
            if created:
                info = point.stat()
                created_points.append((point, info.st_dev, info.st_ino))
            log = state / f'mount-{name}-{area}.log'
            fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, 'w') as output:
                process = subprocess.Popen(
                    ['rclone', 'nfsmount', remote, str(point), '--read-only',
                     '--vfs-cache-mode', 'off', '--addr', '127.0.0.1:0'],
                    stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                    start_new_session=True, env=transport_env() | extra_env)
            processes.append((process, point, log))
            deadline = time.monotonic() + 30
            pulse = MountPulse(f'Avvio {name}/{area}')
            try:
                while not os.path.ismount(point):
                    code = process.poll()
                    if code is not None:
                        detail = log.read_text(errors='replace')[-1200:]
                        if code == 0 and 'Unmounted rclone mount' in detail:
                            pulse.done('smontato')
                            print(f'{terminal_style("Volume smontato:", "1;32", sys.stdout)} '
                                  f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
                            return 0
                    if code is not None or time.monotonic() >= deadline:
                        pulse.done('errore')
                        detail = log.read_text(errors='replace')[-1200:]
                        raise TransportError(f'Montaggio {name}/{area} fallito: {detail or "nessuna risposta da rclone."}')
                    pulse.draw()
                    mount_input_wait(input_fd, 0.2)
            except KeyboardInterrupt:
                pulse.done('interrotto')
                raise
            pulse.done('completato')
            mounted_points.add(point)
            print(f'{terminal_style(f"Montato {name}/{area} in sola lettura:", "1;32", sys.stdout)} '
                  f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
        print(terminal_style('Lascia questo terminale aperto; premi Ctrl-C o espelli il volume dal Finder (⌘E).',
                             '2', sys.stdout), flush=True)
        while True:
            for process, point, log in processes:
                code = process.poll()
                if code is not None:
                    if code == 0:
                        deadline = time.monotonic() + 3
                        while os.path.ismount(point) and time.monotonic() < deadline:
                            mount_input_wait(input_fd, 0.1)
                        if not os.path.ismount(point):
                            print(f'{terminal_style("Volume smontato:", "1;32", sys.stdout)} '
                                  f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
                            return 0
                    detail = log.read_text(errors='replace')[-1200:]
                    raise TransportError(f'Montaggio terminato con codice {code}: {point}. {detail}')
            mount_input_wait(input_fd, 1)
    except KeyboardInterrupt:
        interrupted = True
        print('\nSmontaggio in corso...', flush=True)
    finally:
        for process, _, _ in reversed(processes):
            if process.poll() is None:
                process.terminate()
        for process, point, _ in reversed(processes):
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                print(f'{terminal_style("AVVISO:", "1;33", sys.stderr)} '
                      f'{point} non si è smontato; controllare con mount.', file=sys.stderr)
        for point, device, inode in reversed(created_points):
            try:
                info = point.lstat()
                if (not os.path.ismount(point) and stat.S_ISDIR(info.st_mode)
                        and (info.st_dev, info.st_ino) == (device, inode)):
                    point.rmdir()
            except (FileNotFoundError, OSError):
                # An active mount, changed directory or nonempty folder is left intact.
                pass
        if interrupted:
            for _, point, _ in processes:
                if point in mounted_points and not os.path.ismount(point):
                    print(f'{terminal_style("Volume smontato:", "1;32", sys.stdout)} '
                          f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
    return 0


def remote_files(root: str) -> list[str]:
    text = rclone_call("lsjson", root, "--recursive", "--files-only", "--links", missing_ok=True)
    files = []
    seen = set()
    for item in json.loads(text):
        path = item.get("Path")
        if not isinstance(path, str) or not path or path.startswith("/") or any(part in ("", ".", "..") for part in path.split("/")):
            raise TransportError("Il cloud ha restituito un percorso non valido; operazione bloccata.")
        absolute_path("/" + path)
        if path in seen:
            raise TransportError("Il cloud contiene percorsi duplicati; risolverli prima del backup.")
        seen.add(path)
        files.append(path)
    return files


@contextmanager
def operation_lock(state: Path):
    if state.is_symlink():
        raise ConfigError("La directory di stato non può essere un collegamento.")
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(state, 0o700)
    fd = os.open(state / "operation.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ConfigError("Un'altra operazione macbackup è già in corso.") from exc
        yield
    finally:
        os.close(fd)


def selected_names(scan: Scan, area: str) -> set[str]:
    return {entry.path.lstrip("/") + (".rclonelink" if entry.kind == "symlink" else "")
            for entry in scan.entries if entry.decision.action == area and entry.kind != 'finder-icon'}


def transfer_plan(policy: Policy, scan: Scan, targets: dict, limit: int,
                  enforce_limit: bool = True) -> list[dict]:
    if scan.errors:
        raise ConfigError("La selezione locale contiene errori. Eseguire macbackup check.")
    plans = []
    any_existing = False
    for target, areas in targets.items():
        for area, root in areas.items():
            local = selected_names(scan, area)
            managed = set()
            policy_archives = []
            existing = remote_files(remote_join(root, "current"))
            any_existing = any_existing or bool(existing)
            if policy.gitignore is not None:
                policy.gitignore.preload([
                    absolute_path('/' + (name[:-len('.rclonelink')]
                                         if name.endswith('.rclonelink') else name))
                    for name in existing
                ])
            for name in existing:
                logical = name[:-len(".rclonelink")] if name.endswith(".rclonelink") else name
                decision = policy.decide(absolute_path("/" + logical))
                if decision.action == "error":
                    raise ConfigError(decision.reason)
                if decision.action == area:
                    managed.add(name)
                else:
                    policy_archives.append({
                        'path': '/' + logical, 'relative': name,
                        'remote_path': remote_join(root, 'current/' + name),
                        'reason': decision.reason, 'rule': decision.rule,
                        'current_area': area, 'new_action': decision.action,
                    })
            deletions = managed - local
            file_plan = {"target": target, "area": area, "root": root,
                         "files": sorted(local | managed), "selected": len(local),
                         "local": sorted(local), "existing": existing,
                         "deletions": sorted(deletions),
                         "archive_deleted": len(deletions),
                         "policy_archives": policy_archives,
                         "archive_policy": len(policy_archives)}
            plans.append(file_plan)
            icons = [entry for entry in scan.entries if entry.kind == 'finder-icon' and entry.decision.action == area]
            icon_local = {str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR for entry in icons}
            icon_root = remote_join(root, 'macos-icons')
            icon_existing = remote_files(remote_join(icon_root, 'current'))
            any_existing = any_existing or bool(icon_existing)
            icon_managed = set()
            icon_policy_archives = []
            for name in icon_existing:
                if not name.endswith(ICON_SIDECAR):
                    raise TransportError("Percorso inatteso nell'area riservata alle icone.")
                parent = absolute_path('/' + name[:-len(ICON_SIDECAR)])
                decision = policy.decide(parent / FINDER_ICON)
                if decision.action == 'error':
                    raise ConfigError(decision.reason)
                if decision.action == area:
                    icon_managed.add(name)
                else:
                    icon_policy_archives.append({
                        'path': str(parent / FINDER_ICON),
                        'relative': name,
                        'remote_path': remote_join(icon_root, 'current/' + name),
                        'reason': decision.reason, 'rule': decision.rule,
                        'current_area': area, 'new_action': decision.action,
                    })
            icon_deleted = icon_managed - icon_local
            total_archives = (len(deletions) + len(policy_archives) +
                              len(icon_deleted) + len(icon_policy_archives))
            exceeded = total_archives > limit
            file_plan['archive_limit_exceeded'] = exceeded
            if exceeded and enforce_limit:
                raise ConfigError(f"{target}/{area}: {total_archives} archiviazioni tra file e icone "
                                  f"superano max_delete={limit}; nessun trasferimento avviato.")
            if icons or icon_existing:
                plans.append({'target': target, 'area': area, 'root': icon_root, 'kind': 'macos-icons',
                              'icons': icons, 'files': sorted(icon_local | icon_managed),
                              'local': sorted(icon_local), 'existing': icon_existing,
                              'selected': len(icon_local), 'deletions': sorted(icon_deleted),
                              'archive_deleted': len(icon_deleted),
                              'policy_archives': icon_policy_archives,
                              'archive_policy': len(icon_policy_archives),
                              'archive_limit_exceeded': exceeded})
    if not policy.roots and not any_existing:
        raise ConfigError("Nessuna sorgente selezionata né copia corrente da archiviare: operazione rclone bloccata.")
    return plans


def write_manifest(directory: Path, names: list[str]) -> Path:
    path = directory / "files.list0"
    with path.open("xb") as stream:
        os.chmod(path, 0o600)
        for name in names:
            stream.write(name.encode("utf-8") + b"\0")
    return path


def private_changes(plan: dict, state: Path) -> list[str]:
    local = set(plan["local"])
    existing = set(plan["existing"])
    to_check = local & existing
    changed = local - existing
    if to_check:
        with tempfile.TemporaryDirectory(prefix="cryptcheck-", dir=state) as directory:
            directory = Path(directory)
            manifest = write_manifest(directory, sorted(to_check))
            report = directory / "report"
            report.touch(mode=0o600)
            rclone_call(
                "cryptcheck", plan.get('source', '/'), remote_join(plan["root"], "current"),
                "--files-from0", str(manifest), "--links", "--one-way",
                "--combined", str(report), "--log-level", "ERROR",
                allowed_codes=(0, 1),
            )
            checked = set()
            for line in report.read_text().splitlines():
                if len(line) < 3 or line[1] != " " or line[0] not in "=*+":
                    raise TransportError("Verifica cifrata incompleta o con errori; nessun aggiornamento dell'area privata.")
                name = line[2:]
                if name not in to_check or name in checked:
                    raise TransportError("Verifica cifrata incoerente; operazione bloccata.")
                checked.add(name)
                if line[0] != "=":
                    changed.add(name)
            if checked != to_check:
                raise TransportError("Non tutti i file privati sono stati verificati; operazione bloccata.")
    return sorted(changed | set(plan["deletions"]))


def perform_sync(plan: dict, state: Path, run_id: str, limit: int, dry_run: bool,
                 home: Path | None = None, progress_depth: int = 2) -> dict | None:
    if plan.get('kind') == 'macos-icons' and 'source' not in plan:
        with tempfile.TemporaryDirectory(prefix='icons-', dir=state) as directory:
            source = Path(directory)
            for entry in plan['icons']:
                relative = str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR
                file = source / relative
                file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                with file.open('x') as stream:
                    os.chmod(file, 0o600)
                    json.dump(icon_snapshot(entry), stream, sort_keys=True, ensure_ascii=False, indent=2)
            return perform_sync(plan | {'source': str(source)}, state, run_id, limit,
                                dry_run, home, progress_depth)
    names = private_changes(plan, state) if plan["area"] == "private" else plan["files"]
    if not names:
        return {'transfers': 0, 'bytes': 0, 'checks': 0, 'listed': 0,
                'renames': 0, 'serverSideMoves': 0, 'serverSideMoveBytes': 0} if not dry_run else None
    with tempfile.TemporaryDirectory(prefix="manifest-", dir=state) as directory:
        manifest = write_manifest(Path(directory), names)
        arguments = [
            "sync", plan.get('source', '/'), remote_join(plan["root"], "current"),
            "--files-from0", str(manifest), "--links", "--copy-links=false",
            "--backup-dir", remote_join(plan["root"], "history/" + run_id),
            "--delete-excluded=false", "--max-delete", str(max(limit, len(plan['deletions'])) if dry_run else limit),
            "--log-level", "ERROR" if dry_run else "NOTICE", "--retries", "1",
        ]
        arguments.append("--ignore-times" if plan["area"] == "private" else "--checksum")
        if dry_run:
            arguments.append("--dry-run")
            rclone_call(*arguments)
            return None
        arguments.extend(("--stats", "5s", "--stats-file-name-length", "0",
                          "--stats-log-level", "NOTICE", "--use-json-log"))
        return rclone_progress_call(arguments, home or Path.home(), progress_depth,
                                   f"{plan['target']}/{plan['area']}/{plan.get('kind', 'files')}")


def archive_policy_copies(plan: dict, run_id: str, completed: list[dict]) -> None:
    """Move policy-revoked current copies into the same area's run history."""
    for item in plan['policy_archives']:
        destination = remote_join(plan['root'], 'history/' + run_id + '/' + item['relative'])
        rclone_call('moveto', item['remote_path'], destination, '--retries', '1')
        completed.append({key: value for key, value in item.items() if key != 'relative'} |
                         {'history_path': destination})


def transport_operation(args, policy: Policy) -> int:
    if getattr(args, 'progress_depth', 2) not in range(1, 6):
        raise ConfigError('--progress-depth deve essere un intero fra 1 e 5.')
    targets, limit = load_targets(policy.config_dir, args.target)
    with operation_lock(policy.state_dir):
        scan = scan_policy(policy)
        plans = transfer_plan(policy, scan, targets, limit, enforce_limit=args.command == 'run')
        if args.command == "check":
            result = {"scope": "remote-read-only", "ok": True,
                      "note": "Accesso e tipi dei remotes verificati; inventari letti senza modificare il cloud."}
            print(json.dumps(result, ensure_ascii=False) if getattr(args, "json", False) else result["note"])
            return 0
        run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ-") + uuid.uuid4().hex[:12]
        results = []
        for plan in plans:
            result = {key: plan[key] for key in ("target", "area", "selected", "archive_deleted", "archive_policy")}
            result['archive_limit_exceeded'] = plan['archive_limit_exceeded']
            result['kind'] = plan.get('kind', 'files')
            result['policy_archives'] = [
                {key: value for key, value in item.items() if key != 'relative'}
                for item in plan['policy_archives']
            ]
            if args.command == 'run':
                result['policy_archived'] = []
            if args.command == 'run':
                print(f"Avvio {plan['target']}/{plan['area']}/{result['kind']}: "
                      f"{plan['selected']} elementi selezionati.", file=sys.stderr, flush=True)
            try:
                stats = perform_sync(plan, policy.state_dir, run_id, limit,
                                     args.command == "preview", policy.home,
                                     getattr(args, 'progress_depth', 2))
                if args.command == 'run':
                    result.update(transfer_metrics(stats, True))
                    archive_policy_copies(plan, run_id, result['policy_archived'])
                result["ok"] = True
            except TransferInterrupted as exc:
                result.update(transfer_metrics(exc.stats, False))
                result.update(ok=False, error="Interrotto dall'utente; i file già caricati restano sul cloud.")
                results.append(result)
                break
            except KeyboardInterrupt:
                if args.command == 'run':
                    result.update(transfer_metrics(None, False))
                result.update(ok=False, error="Interrotto dall'utente; i file già caricati restano sul cloud.")
                results.append(result)
                break
            except (ConfigError, TransportError, OSError) as exc:
                if args.command == 'run' and 'transferred_files' not in result:
                    result.update(transfer_metrics(getattr(exc, 'stats', None), False))
                result.update(ok=False, error=str(exc))
            results.append(result)
        data = {"operation": args.command, "run_id": run_id, "ok": all(item["ok"] for item in results),
                "results": results, "note": "Anteprima, nessuna modifica cloud." if args.command == "preview" else "Esiti distinti per destinazione e area."}
        if args.command == "run":
            fd, temporary = tempfile.mkstemp(prefix="status-", dir=policy.state_dir)
            try:
                with os.fdopen(fd, "w") as stream:
                    json.dump(data, stream, ensure_ascii=False, indent=2)
                os.replace(temporary, policy.state_dir / "last-run.json")
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
        if getattr(args, "json", False):
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print(data["note"])
            for result in results:
                print(f"{result['target']}/{result['area']}/{result['kind']}: {'OK' if result['ok'] else 'ERRORE'}; "
                      f"selezionati {result['selected']}; da archiviare per cancellazione {result['archive_deleted']}; "
                      f"da archiviare per policy {result['archive_policy']}.")
                for item in result['policy_archives']:
                    print(f"  Policy: {item['path']} → {item['new_action']}; {item['reason']}" +
                          (f" Regola: {item['rule']}" if item['rule'] else ''))
                if result['archive_limit_exceeded']:
                    print(f"  AVVISO: supera max_delete={limit}; una run si fermerebbe prima dei trasferimenti.")
                if args.command == 'run':
                    if result['archive_policy']:
                        print(f"Archiviati per policy: {len(result['policy_archived'])}/{result['archive_policy']}.")
                    if result.get('transferred_files') is None:
                        print('Trasferimenti: conteggio non disponibile.')
                    else:
                        label = ' (ultimo rapporto, incompleto)' if not result['counts_complete'] else ''
                        print(f"Trasferiti {result['transferred_files']} file, "
                              f"{result['transferred_bytes']} byte; "
                              f"controllati {result['checked_files']}{label}.")
                        if result.get('server_side_moves') is not None:
                            print(f"Spostamenti sul cloud: {result['server_side_moves']} file, "
                                  f"{result['server_side_move_bytes']} byte{label}.")
                if not result["ok"]:
                    print(result["error"])
        return 0 if data["ok"] else 1


def forget_inventory(targets: dict, requested: str, subtree: bool, area_filter: str) -> list[dict]:
    """List exact current/history objects, independent of the active selector."""
    wanted = requested.lstrip('/')
    matches = []
    for target, areas in targets.items():
        for area, root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in ('files', 'macos-icons'):
                prefix = root if kind == 'files' else remote_join(root, 'macos-icons')
                for location in ('current', 'history'):
                    inventory_root = remote_join(prefix, location)
                    listing = json.loads(rclone_call(
                        'lsjson', inventory_root, '--recursive', '--files-only',
                        '--links', '--hash', '--original', missing_ok=True,
                    ))
                    seen = set()
                    for item in listing:
                        relative = item.get('Path')
                        if not isinstance(relative, str) or not relative or relative.startswith('/') or any(
                            part in ('', '.', '..') for part in relative.split('/')
                        ):
                            raise TransportError('Inventario cloud con percorso non valido.')
                        absolute_path('/' + relative)
                        if relative in seen:
                            raise TransportError('Percorsi duplicati nel cloud: forget bloccato.')
                        seen.add(relative)
                        if location == 'history':
                            version, sep, logical = relative.partition('/')
                            if not sep or not version:
                                raise TransportError('Versione storica con percorso non valido.')
                        else:
                            version, logical = None, relative
                        if kind == 'macos-icons':
                            if not logical.endswith(ICON_SIDECAR):
                                raise TransportError('Elemento inatteso nell’area delle icone.')
                            logical = logical[:-len(ICON_SIDECAR)]
                            selected = subtree and (logical == wanted or logical.startswith(wanted + '/'))
                        else:
                            if logical.endswith('.rclonelink'):
                                logical = logical[:-len('.rclonelink')]
                            selected = (logical == wanted or subtree and logical.startswith(wanted + '/'))
                        if not selected:
                            continue
                        size = item.get('Size')
                        if type(size) is not int or size < 0:
                            raise TransportError('Dimensione cloud non valida: forget bloccato.')
                        hashes = item.get('Hashes') or {}
                        if not isinstance(hashes, dict):
                            raise TransportError('Hash cloud non valido: forget bloccato.')
                        matches.append({
                            'target': target, 'area': area, 'kind': kind,
                            'location': location, 'version': version,
                            'remote_path': remote_join(inventory_root, relative),
                            'relative': relative, 'size': size,
                            'modtime': item.get('ModTime'), 'id': item.get('ID'),
                            'original_id': item.get('OrigID'),
                            'hashes': hashes,
                        })
    matches.sort(key=lambda item: (item['target'], item['area'], item['remote_path']))
    return matches


def write_private_json(path: Path, data: dict) -> None:
    with path.open('x') as stream:
        os.chmod(path, 0o600)
        json.dump(data, stream, ensure_ascii=False, indent=2)
        stream.flush()
        os.fsync(stream.fileno())


def check_permanent_google(targets: dict) -> None:
    remotes = {item['name']: item['type'] for item in json.loads(rclone_call('listremotes', '--json'))}
    plain_remote = targets['google']['plain'].split(':', 1)[0]
    if remotes.get(plain_remote) != 'drive':
        raise ConfigError('La rimozione definitiva richiede un remote Google Drive reale.')


def forget_directory_present(root: str) -> bool:
    parent, name = root.rsplit('/', 1)
    listing = json.loads(rclone_call('lsjson', parent, '--dirs-only',
                                     '--original', missing_ok=True))
    matches = [item for item in listing if item.get('Name') == name]
    if len(matches) > 1:
        raise TransportError('Directory duplicate nel cloud: forget bloccato.')
    return bool(matches)


def forget_cleanup_roots(targets: dict, requested: str, area_filter: str) -> list[str]:
    """Find the exact requested directory in current and each history version."""
    roots = set()
    for areas in targets.values():
        for area, area_root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in ('files', 'macos-icons'):
                prefix = area_root if kind == 'files' else remote_join(area_root, 'macos-icons')
                current = remote_join(remote_join(prefix, 'current'), requested.lstrip('/'))
                if forget_directory_present(current):
                    roots.add(current)
                history = remote_join(prefix, 'history')
                versions = json.loads(rclone_call('lsjson', history, '--dirs-only',
                                                  '--original', missing_ok=True))
                seen = set()
                for version in versions:
                    name = version.get('Name')
                    if not isinstance(name, str) or not name or '/' in name or name in ('.', '..'):
                        raise TransportError('Versione storica con percorso non valido.')
                    if name in seen:
                        raise TransportError('Versioni storiche duplicate nel cloud.')
                    seen.add(name)
                    root = remote_join(remote_join(history, name), requested.lstrip('/'))
                    if forget_directory_present(root):
                        roots.add(root)
    return sorted(roots)


def forget_remove_empty_roots(roots: list[str], flag: str) -> list[str]:
    """Remove only empty directories, then confirm that each requested root vanished."""
    completed = []
    for root in roots:
        if forget_directory_present(root):
            rclone_call('rmdirs', root, flag, '--retries', '1')
        if forget_directory_present(root):
            raise TransportError('Directory ancora presente dopo la pulizia: ' + root)
        completed.append(root)
    return completed


def forget_operation(args, config: Path, home: Path) -> int:
    state = home / '.local/state/macbackup'
    with operation_lock(state):
        plans = state / 'forget-plans'
        plans.mkdir(mode=0o700, exist_ok=True)
        if plans.is_symlink():
            raise ConfigError('La directory dei piani non può essere un collegamento.')
        os.chmod(plans, 0o700)
        if args.plan:
            if args.path or args.area or args.target or args.mode or not args.apply:
                raise ConfigError('Per applicare un piano usare soltanto --plan ID --apply.')
            if not re.fullmatch(r'F[0-9a-f]{12}', args.plan):
                raise ConfigError('Identificativo del piano non valido.')
            file = plans / (args.plan + '.json')
            if file.is_symlink() or not file.is_file():
                raise ConfigError('Piano assente o già utilizzato.')
            data = json.loads(file.read_text())
            if data.get('schema_version') != 1 or data.get('plan_id') != args.plan:
                raise ConfigError('Formato del piano non valido.')
            if data.get('config_dir') != str(config):
                raise ConfigError('Usare la stessa directory di configurazione del piano.')
            if time.time() > data.get('expires_at', 0):
                raise ConfigError('Piano scaduto: crearne uno nuovo.')
            if data.get('mode') == 'permanent' and data.get('target') != 'google':
                raise ConfigError('Rimozione definitiva automatica disponibile solo per Google.')
            targets, _ = load_targets(config, data['target'], require_enabled=False)
            if data['mode'] == 'permanent':
                check_permanent_google(targets)
            if targets != data.get('roots'):
                raise ConfigError('Le destinazioni sono cambiate: creare un nuovo piano.')
            current = forget_inventory(targets, data['requested'], data['subtree'], data['area'])
            if current != data.get('items'):
                raise ConfigError('Le copie cloud sono cambiate: creare un nuovo piano.')
            cleanup_roots = (forget_cleanup_roots(targets, data['requested'], data['area'])
                             if data['subtree'] else [])
            if cleanup_roots != data.get('cleanup_roots', cleanup_roots):
                raise ConfigError('Le directory del piano sono cambiate: crearne uno nuovo.')
            applying = plans / (args.plan + '.applying')
            os.replace(file, applying)
            completed = []
            error = None
            flag = '--drive-use-trash=false' if data['mode'] == 'permanent' else '--drive-use-trash=true'
            for item in current:
                try:
                    rclone_call('deletefile', item['remote_path'], flag, '--retries', '1')
                    completed.append(item['remote_path'])
                except TransportError as exc:
                    error = str(exc)
                    break
            try:
                remaining = forget_inventory(targets, data['requested'], data['subtree'], data['area'])
            except (ConfigError, TransportError) as exc:
                remaining = None
                error = str(exc) if error is None else error + '; verifica finale: ' + str(exc)
            cleaned_roots = []
            if error is None and remaining == [] and cleanup_roots:
                try:
                    cleaned_roots = forget_remove_empty_roots(cleanup_roots, flag)
                except (ConfigError, TransportError) as exc:
                    error = 'Pulizia delle directory vuote: ' + str(exc)
            result = {
                'operation': 'forget-apply', 'plan_id': args.plan,
                'ok': error is None and remaining == [], 'mode': data['mode'],
                'attempted': len(completed) + (1 if error and len(completed) < len(current) else 0),
                'removed_from_active_backup': completed,
                'empty_directory_roots_removed': cleaned_roots,
                'remaining': remaining, 'error': error,
                'note': ('Cestino del servizio: non equivale a cancellazione definitiva.'
                         if data['mode'] == 'trash' else
                         'Cancellazione definitiva richiesta; revisioni native e vecchio cestino non ispezionati.'),
            }
            write_private_json(plans / (args.plan + '.result.json'), result)
            if args.json:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            else:
                print(f"Piano {args.plan}: {len(completed)}/{len(current)} file rimossi dalle cartelle del backup.")
                if cleanup_roots:
                    print(f"Directory vuote ripulite: {len(cleaned_roots)}/{len(cleanup_roots)} radici selezionate.")
                if error:
                    print('ERRORE: ' + error)
                print(result['note'])
                if remaining:
                    print(f'Elementi ancora presenti: {len(remaining)}. Creare un nuovo piano per riprovare.')
            return 0 if result['ok'] else 1
        if args.apply or not (args.path and args.area and args.target and args.mode):
            raise ConfigError('Per creare un piano servono percorso, --area, --target e --mode.')
        requested = absolute_path(args.path)
        if requested == Path('/'):
            raise ConfigError('La radice / non è ammessa in forget.')
        subtree = args.path.endswith('/')
        if requested.is_dir() and not subtree:
            raise ConfigError('Per una directory aggiungere / alla fine del percorso.')
        if args.mode == 'permanent' and args.target != 'google':
            raise ConfigError('Rimozione definitiva automatica disponibile solo per Google.')
        targets, _ = load_targets(config, args.target, require_enabled=False)
        if args.mode == 'permanent':
            check_permanent_google(targets)
        items = forget_inventory(targets, str(requested), subtree, args.area)
        cleanup_roots = forget_cleanup_roots(targets, str(requested), args.area) if subtree else []
        if len(items) > 10000:
            raise ConfigError('Oltre 10000 file: restringere il percorso e creare più piani.')
        result = {
            'operation': 'forget-plan', 'plan_id': None, 'requested': str(requested),
            'subtree': subtree, 'area': args.area, 'target': args.target,
            'mode': args.mode, 'items': items, 'count': len(items),
            'cleanup_roots': cleanup_roots,
            'known_bytes': sum(item['size'] for item in items),
            'selected_locally': None,
            'note': ('I file verranno spostati nel cestino del servizio; le directory vuote '
                     'comprese nel piano verranno rimosse.' if args.mode == 'trash' else
                     'I file e le directory vuote compresi nel piano verranno cancellati '
                     'definitivamente tramite il provider; revisioni native e vecchio cestino '
                     'non sono inclusi.'),
        }
        if items or cleanup_roots:
            # The selector is advisory here. Forget must still find old copies
            # after exclusions or routing changes.
            try:
                policy = Policy(config, home)
                result['selected_locally'] = policy.decide(requested, directory=subtree).action in ('plain', 'private')
            except ConfigError:
                pass
            plan_id = 'F' + uuid.uuid4().hex[:12]
            data = {
                'schema_version': 1, 'plan_id': plan_id, 'config_dir': str(config),
                'requested': str(requested), 'subtree': subtree,
                'target': args.target, 'area': args.area, 'mode': args.mode,
                'roots': targets, 'items': items,
                'cleanup_roots': cleanup_roots,
                'expires_at': time.time() + 3600,
            }
            write_private_json(plans / (plan_id + '.json'), data)
            result['plan_id'] = plan_id
            result['expires_at'] = data['expires_at']
        if args.json:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        else:
            print(f"Corrispondenze: {len(items)} file, {result['known_bytes']} byte noti.")
            for item in items:
                print(f"{item['target']}/{item['area']}/{item['location']}: {item['remote_path']}")
            if cleanup_roots:
                print(f"Directory da ripulire se vuote: {len(cleanup_roots)} radici.")
                for root in cleanup_roots:
                    print(f"Directory: {root}")
            if result['selected_locally']:
                print('AVVISO: il percorso è ancora selezionato e potrebbe essere ricaricato dalla prossima run.')
            print(result['note'])
            if result['plan_id']:
                print(f"Per applicare entro un'ora: macbackup forget --plan {result['plan_id']} --apply")
        return 0


def versions_inventory(targets: dict, requested: str, subtree: bool, area_filter: str) -> list[dict]:
    """Read only the requested current subtree and matching subtrees in each history run."""
    wanted = requested.lstrip('/')
    found = []
    for target, areas in targets.items():
        for area, root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in (('files', 'macos-icons') if subtree else ('files',)):
                prefix = root if kind == 'files' else remote_join(root, 'macos-icons')
                history_root = remote_join(prefix, 'history')
                runs = json.loads(rclone_call('lsjson', history_root, '--dirs-only',
                                              missing_ok=True))
                if not isinstance(runs, list):
                    raise TransportError('Elenco delle run storiche non valido.')
                versions = [None]
                for run in runs:
                    name = run.get('Name') if isinstance(run, dict) else None
                    if not isinstance(name, str) or not name or '/' in name or name in ('.', '..'):
                        raise TransportError('Nome della run storica non valido.')
                    versions.append(name)
                for version in versions:
                    location = 'history' if version else 'current'
                    inventory_root = remote_join(prefix, location)
                    base = remote_join(inventory_root, version) if version else inventory_root
                    scope = wanted if subtree else wanted.rpartition('/')[0]
                    search_root = remote_join(base, scope) if scope else base
                    options = ['--files-only', '--links']
                    if subtree:
                        options.append('--recursive')
                    listing = json.loads(rclone_call('lsjson', search_root, *options,
                                                     missing_ok=True))
                    if not isinstance(listing, list):
                        raise TransportError('Inventario delle versioni non valido.')
                    seen = set()
                    for entry in listing:
                        path = entry.get('Path') if isinstance(entry, dict) else None
                        if not isinstance(path, str) or not path or path.startswith('/') or any(
                            part in ('', '.', '..') for part in path.split('/')
                        ):
                            raise TransportError('Inventario cloud con percorso non valido.')
                        logical = scope + '/' + path if scope else path
                        absolute_path('/' + logical)
                        if logical in seen:
                            raise TransportError('Percorsi duplicati nel cloud: versions bloccato.')
                        seen.add(logical)
                        if kind == 'macos-icons':
                            if not logical.endswith(ICON_SIDECAR):
                                raise TransportError('Elemento inatteso nell’area delle icone.')
                            original = logical[:-len(ICON_SIDECAR)]
                        else:
                            original = logical[:-len('.rclonelink')] if logical.endswith('.rclonelink') else logical
                        if not (original == wanted or subtree and original.startswith(wanted + '/')):
                            continue
                        size = entry.get('Size')
                        if type(size) is not int or size < 0:
                            raise TransportError('Dimensione cloud non valida: versions bloccato.')
                        relative = version + '/' + logical if version else logical
                        found.append({
                            'target': target, 'area': area, 'kind': kind,
                            'location': location, 'version': version,
                            'remote_path': remote_join(inventory_root, relative),
                            'relative': relative, 'size': size,
                            'modtime': entry.get('ModTime'),
                        })
    found.sort(key=lambda item: (item['target'], item['area'], item['remote_path']))
    return found


def versions_operation(args, config: Path, home: Path) -> int:
    requested = absolute_path(args.path)
    directory = args.path.endswith('/') or (requested.is_dir() and not requested.is_symlink())
    if directory and requested.is_file():
        raise ConfigError('Il percorso indicato come directory è un file.')
    if not directory and args.files:
        raise ConfigError('--files si usa soltanto con una directory.')
    targets, _ = load_targets(config, args.target, require_enabled=False)
    with operation_lock(home / '.local/state/macbackup'):
        items = versions_inventory(targets, str(requested), directory, args.area)
    if directory:
        groups = {}
        for item in items:
            version = item['version'] or 'current'
            key = (item['target'], item['area'], version)
            group = groups.setdefault(key, {'target': item['target'], 'area': item['area'],
                                            'version': version, 'location': item['location'],
                                            'count': 0, 'bytes': 0, 'items': []})
            logical = item['relative'].split('/', 1)[1] if item['location'] == 'history' else item['relative']
            if item['kind'] == 'macos-icons':
                logical = logical[:-len(ICON_SIDECAR)]
            elif logical.endswith('.rclonelink'):
                logical = logical[:-len('.rclonelink')]
            group['count'] += 1
            group['bytes'] += item['size']
            group['items'].append({'path': '/' + logical, 'kind': item['kind'],
                                   'size': item['size'], 'modtime': item['modtime'],
                                   'remote_path': item['remote_path']})
        versions = sorted(groups.values(), key=lambda group: (
            group['target'], group['area'], group['version'] != 'current', group['version']))
        for group in versions:
            group['items'].sort(key=lambda item: (item['path'], item['kind']))
        data = {
            'operation': 'versions', 'requested': str(requested), 'kind': 'directory',
            'target': args.target, 'area': args.area, 'versions': versions,
            'note': 'current è la copia attuale; ogni history contiene solo gli elementi spostati in quella run, non una fotografia completa della directory.',
        }
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print(f"Versioni della directory {requested}: {len(versions)} gruppi; "
                  f"{len(items)} elementi complessivi.")
            for group in versions:
                print(f"{group['target']}/{group['area']} {group['version']}: "
                      f"{group['count']} elementi, {group['bytes']} byte")
                if args.files and group['location'] == 'history':
                    for item in group['items']:
                        print(f"  {item['path']} [{item['kind']}; {item['size']} byte]")
            print(data['note'])
        return 0
    items = [item for item in items if item['kind'] == 'files']
    data = {
        'operation': 'versions', 'requested': str(requested),
        'target': args.target, 'area': args.area,
        'versions': [
            {'target': item['target'], 'area': item['area'],
             'version': item['version'] or 'current',
             'location': item['location'], 'size': item['size'],
             'modtime': item['modtime'], 'remote_path': item['remote_path']}
            for item in items
        ],
        'note': 'Le date di modifica non sono date di archiviazione; ogni history contiene solo i file spostati in quella run.',
    }
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(f"Versioni trovate: {len(items)} per {requested}.")
        for item in data['versions']:
            print(f"{item['target']}/{item['area']} {item['version']} "
                  f"{item['size']} byte {item['modtime'] or 'data ignota'}")
        print(data['note'])
    return 0


def restore_operation(args, config: Path, home: Path) -> int:
    if args.path.endswith('/'):
        raise ConfigError('restore supporta un file alla volta; indicare il percorso esatto del file.')
    requested = absolute_path(args.path)
    destination = absolute_path(args.to)
    if destination == requested:
        raise ConfigError('Non ripristinare direttamente sopra il percorso originale.')
    if destination.is_symlink():
        raise ConfigError('La destinazione non può essere un collegamento simbolico.')
    if not destination.parent.is_dir():
        raise ConfigError('La directory di destinazione deve già esistere.')
    for ancestor in (destination.parent, *destination.parent.parents):
        if ancestor.is_symlink():
            raise ConfigError('Il percorso di destinazione attraversa un collegamento simbolico.')
    if destination.exists() and not args.replace:
        raise ConfigError('Destinazione già presente: scegliere un altro nome o usare --replace.')
    targets, _ = load_targets(config, args.target, require_enabled=False)
    with operation_lock(home / '.local/state/macbackup'):
        items = [item for item in forget_inventory(targets, str(requested), False, args.area)
                 if item['kind'] == 'files' and item['target'] == args.target
                 and item['area'] == args.area and (item['version'] or 'current') == args.version]
        if len(items) != 1:
            raise ConfigError('Versione assente o ambigua: consultare macbackup versions.')
        item = items[0]
        is_link = item['relative'].endswith('.rclonelink')
        if is_link and not args.links:
            raise ConfigError('Questa versione è un collegamento simbolico: aggiungere --links per ricrearlo.')
        if args.links and not is_link:
            raise ConfigError('--links è valido soltanto per un collegamento simbolico.')
        if is_link and item['size'] > 64 * 1024:
            raise ConfigError('Collegamento simbolico oltre 64 KiB: ripristino bloccato.')
        executable = shutil.which('rclone')
        if executable is None:
            raise ConfigError('rclone non è disponibile nel PATH.')
        fd, temporary = tempfile.mkstemp(prefix='.macbackup-restore-', dir=destination.parent)
        try:
            with os.fdopen(fd, 'wb') as output:
                os.fchmod(output.fileno(), 0o600)
                transfer = subprocess.run(
                    [executable, '--ask-password=false', 'cat', item['remote_path'],
                     '--retries', '1'], stdout=output, stderr=subprocess.PIPE,
                    text=True, env=transport_env(),
                )
                output.flush()
                os.fsync(output.fileno())
            if transfer.returncode:
                raise TransportError('Download fallito: ' + transfer.stderr.strip()[-1500:])
            if os.path.getsize(temporary) != item['size']:
                raise TransportError('Dimensione scaricata diversa dall’inventario; nessun file ripristinato.')
            supported = {'md5': 'md5', 'sha1': 'sha1', 'sha-1': 'sha1',
                         'sha256': 'sha256', 'sha-256': 'sha256'}
            expected = {name: value for name, value in item['hashes'].items()
                        if name.lower() in supported and isinstance(value, str) and value}
            if expected:
                digesters = {name: hashlib.new(supported[name.lower()]) for name in expected}
                with open(temporary, 'rb') as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                        for hasher in digesters.values():
                            hasher.update(chunk)
                if any(digesters[name].hexdigest().lower() != value.lower()
                       for name, value in expected.items()):
                    raise TransportError('Hash del download diverso dall’inventario; nessun file ripristinato.')
            refreshed = [new for new in forget_inventory(targets, str(requested), False, args.area)
                         if new['remote_path'] == item['remote_path']]
            if refreshed != [item]:
                raise TransportError('La versione cloud è cambiata durante il download; nessun file ripristinato.')
            if destination.is_symlink():
                raise ConfigError('La destinazione è diventata un collegamento simbolico.')
            if is_link:
                try:
                    link_target = Path(temporary).read_bytes().decode('utf-8')
                except UnicodeError as exc:
                    raise ConfigError('Destinazione del collegamento non rappresentabile in UTF-8.') from exc
                if not link_target or '\x00' in link_target:
                    raise ConfigError('Destinazione del collegamento vuota o non valida.')
                if args.replace:
                    if destination.exists() and not destination.is_file():
                        raise ConfigError('Con --replace si può sostituire soltanto un file regolare.')
                    temporary_link = destination.parent / ('.macbackup-link-' + uuid.uuid4().hex)
                    try:
                        os.symlink(link_target, temporary_link)
                        os.replace(temporary_link, destination)
                    finally:
                        temporary_link.unlink(missing_ok=True)
                else:
                    try:
                        os.symlink(link_target, destination)
                    except FileExistsError as exc:
                        raise ConfigError('Destinazione creata durante il download; nessuna sovrascrittura.') from exc
            elif args.replace:
                if destination.exists() and not destination.is_file():
                    raise ConfigError('Con --replace si può sostituire soltanto un file regolare.')
                os.replace(temporary, destination)
            else:
                try:
                    os.link(temporary, destination, follow_symlinks=False)
                except FileExistsError as exc:
                    raise ConfigError('Destinazione creata durante il download; nessuna sovrascrittura.') from exc
                os.unlink(temporary)
            data = {'operation': 'restore', 'ok': True, 'requested': str(requested),
                    'destination': str(destination), 'target': args.target,
                    'area': args.area, 'version': args.version, 'bytes': item['size'],
                    'hash_verified': bool(expected), 'kind': 'symlink' if is_link else 'file',
                    'link_target': link_target if is_link else None,
                    'note': ('Hash remoto verificato.' if expected else
                             'Hash del contenuto non disponibile dal backend; dimensione e inventario verificati.')}
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        label = 'Collegamento ricreato' if data['kind'] == 'symlink' else 'File ripristinato'
        print(f"{label} in {destination} ({data['bytes']} byte). {data['note']}")
    return 0


def verify_report(source: str, destination: str, names: list[str],
                  state: Path, private: bool, download: bool) -> dict:
    if not names:
        return {'selected': 0, 'matched': 0, 'different': [], 'missing': [], 'errors': []}
    with tempfile.TemporaryDirectory(prefix='verify-', dir=state) as directory:
        directory = Path(directory)
        manifest = write_manifest(directory, names)
        report = directory / 'combined.txt'
        report.touch(mode=0o600)
        command = 'check' if download or not private else 'cryptcheck'
        options = [command, source, destination, '--files-from0', str(manifest),
                   '--links', '--one-way', '--combined', str(report), '--log-level', 'ERROR']
        if download:
            options.append('--download')
        rclone_call(*options, allowed_codes=(0, 1))
        found = {}
        expected = set(names)
        for line in report.read_text().splitlines():
            if len(line) < 3 or line[1] != ' ' or line[0] not in '=+*!':
                raise TransportError('Rapporto di verifica incompleto o inatteso.')
            name = line[2:]
            if name not in expected or name in found:
                raise TransportError('Rapporto di verifica incoerente.')
            found[name] = line[0]
        if set(found) != expected:
            raise TransportError('Non tutti i file selezionati sono stati verificati.')
        return {
            'selected': len(names),
            'matched': sum(value == '=' for value in found.values()),
            'different': sorted(name for name, value in found.items() if value == '*'),
            'missing': sorted(name for name, value in found.items() if value == '+'),
            'errors': sorted(name for name, value in found.items() if value == '!'),
        }


def verify_operation(args, config: Path, home: Path) -> int:
    targets, _ = load_targets(config, args.target, require_enabled=False)
    policy = Policy(config, home)
    with operation_lock(policy.state_dir):
        scan = scan_policy(policy)
        if scan.errors:
            raise ConfigError('La selezione locale contiene errori: eseguire macbackup check.')
        results = []
        for target, areas in targets.items():
            for area, root in areas.items():
                if args.area != 'all' and args.area != area:
                    continue
                local = sorted(selected_names(scan, area))
                try:
                    checked = verify_report('/', remote_join(root, 'current'), local,
                                            policy.state_dir, area == 'private', args.download)
                    results.append({'target': target, 'area': area, 'kind': 'files',
                                    'method': ('download' if args.download else
                                               'cryptcheck' if area == 'private' else 'check'),
                                    **checked})
                except (ConfigError, TransportError, OSError) as exc:
                    results.append({'target': target, 'area': area, 'kind': 'files',
                                    'selected': len(local), 'error': str(exc)})
                icons = [entry for entry in scan.entries
                         if entry.kind == 'finder-icon' and entry.decision.action == area]
                if icons:
                    try:
                        with tempfile.TemporaryDirectory(prefix='verify-icons-', dir=policy.state_dir) as directory:
                            source = Path(directory)
                            names = []
                            for entry in icons:
                                relative = str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR
                                path = source / relative
                                path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                                with path.open('x') as stream:
                                    os.chmod(path, 0o600)
                                    json.dump(icon_snapshot(entry), stream, sort_keys=True,
                                              ensure_ascii=False, indent=2)
                                names.append(relative)
                            checked = verify_report(str(source),
                                remote_join(remote_join(root, 'macos-icons'), 'current'),
                                sorted(names), policy.state_dir, area == 'private', args.download)
                            results.append({'target': target, 'area': area, 'kind': 'macos-icons',
                                            'method': ('download' if args.download else
                                                       'cryptcheck' if area == 'private' else 'check'),
                                            **checked})
                    except (ConfigError, TransportError, OSError) as exc:
                        results.append({'target': target, 'area': area, 'kind': 'macos-icons',
                                        'selected': len(icons), 'error': str(exc)})
        ok = all(not item.get('error') and not item.get('different')
                 and not item.get('missing') and not item.get('errors') for item in results)
        data = {'operation': 'verify', 'ok': ok, 'target': args.target, 'area': args.area,
                'download': args.download, 'scope': 'selected-local-versus-remote-current',
                'results': results,
                'note': 'Confronto con le sorgenti locali attuali; una differenza non prova corruzione. '
                        'Lo storico e le copie già escluse non sono coperti.'}
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            for item in results:
                print(f"{item['target']}/{item['area']}/{item['kind']}: "
                      f"{item.get('matched', 0)}/{item['selected']} corrispondenti; "
                      f"diversi {len(item.get('different', []))}; "
                      f"mancanti {len(item.get('missing', []))}; "
                      f"errori {len(item.get('errors', []))}.")
                if item.get('error'):
                    print('ERRORE: ' + item['error'])
            print(data['note'])
        return 0 if ok else 1


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="macbackup: selezione protetta, anteprima e backup tramite rclone."
    )
    parser.add_argument("--version", action="version", version=f"macbackup {VERSION}")
    parser.add_argument("--config-dir", metavar="PATH", help="directory assoluta con elenchi e settings.toml")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("init", help="crea quattro elenchi senza inclusioni attive")
    check = commands.add_parser("check", help="controlla gli elenchi e le sorgenti locali")
    check.add_argument("--json", action="store_true", help="risultato strutturato")
    check.add_argument("--remote", action="store_true", help="controlla anche i remotes, senza scrivere sul cloud")
    check.add_argument("--target", choices=("google", "proton", "all"), help="destinazione del controllo remoto; richiede --remote (predefinita: google)")
    explain = commands.add_parser("explain", help="spiega la classificazione di un singolo percorso")
    explain.add_argument("path", metavar="PATH")
    explain.add_argument("--json", action="store_true", help="stampa la classificazione in JSON")
    layout = commands.add_parser('layout', help='mostra le parti private dentro una directory plain')
    layout.add_argument('path', nargs='?', metavar='PATH', help='cartella plain; predefinita: directory corrente')
    layout.add_argument('--json', action='store_true', help='stampa il risultato in JSON')
    preview = commands.add_parser("preview", help="anteprima locale o confronto remoto senza modifiche cloud")
    mode = preview.add_mutually_exclusive_group(required=True)
    mode.add_argument("--local", action="store_true", help="mostra la selezione locale senza accesso cloud")
    mode.add_argument("--target", choices=("google", "proton", "all"), help="confronta il cloud in sola lettura e mostra le archiviazioni previste")
    preview.add_argument("--json", action="store_true", help="stampa il piano in JSON")
    run = commands.add_parser("run", help="esegue il backup; richiede destinazioni abilitate e sorgenti valide")
    run.add_argument("--target", choices=("google", "proton", "all"), required=True,
                     help="destinazione del backup; applica le archiviazioni entro max_delete")
    run.add_argument('--progress-depth', type=int, default=2, metavar='N',
                     help='livelli di cartelle attive da mostrare rispetto alla home (1-5; predefinito 2)')
    run.add_argument("--json", action="store_true", help="stampa il riepilogo finale in JSON; il progresso resta su stderr")
    mount = commands.add_parser('mount', help='monta le copie cloud in sola lettura per consultazione')
    mount.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                       help='servizio da montare; deve essere abilitato in settings.toml')
    mount.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                       help='aree da mostrare (predefinita: all)')
    mount.add_argument('--mountpoint', metavar='ABS_PATH',
                       help='cartella base; predefinita: ~/Desktop')
    status = commands.add_parser("status", help="mostra l'esito memorizzato dell'ultima run")
    status.add_argument("--json", action="store_true", help="compatibilità: status stampa già JSON")
    icon = commands.add_parser('restore-icon', help='ripristina una sola icona Finder da un file di metadati locale')
    icon.add_argument('--file', required=True, metavar='PATH', help='snapshot icon.json scaricato dal backup')
    icon.add_argument('--folder', required=True, metavar='PATH', help='cartella locale esistente su cui applicare l\'icona')
    icon.add_argument('--replace', action='store_true', help='consente di sostituire un\'icona già presente')
    icon.add_argument('--json', action='store_true', help='stampa il risultato in JSON')
    forget = commands.add_parser('forget', help='prepara o applica una rimozione selettiva da current e history')
    forget.add_argument('path', nargs='?', metavar='ABS_PATH', help='percorso originale; / finale per una directory')
    forget.add_argument('--area', choices=('plain', 'private', 'all'), help='area da cui rimuovere copie correnti e storiche')
    forget.add_argument('--target', choices=('google', 'proton', 'all'), help='destinazione da cui rimuovere le copie')
    forget.add_argument('--mode', choices=('trash', 'permanent'), help='cestino o rimozione definitiva; permanent solo su Google')
    forget.add_argument('--plan', metavar='ID', help='piano da applicare')
    forget.add_argument('--apply', action='store_true', help='applica il piano verificato')
    forget.add_argument('--json', action='store_true', help='stampa il piano o il risultato in JSON')
    versions = commands.add_parser('versions', help='elenca current e gli storici di un file o una directory')
    versions.add_argument('path', metavar='ABS_PATH')
    versions.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                          help='destinazione in cui cercare le versioni')
    versions.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                          help='area in cui cercare (predefinita: all)')
    versions.add_argument('--files', action='store_true', help='per una directory, elenca solo i file presenti negli storici')
    versions.add_argument('--json', action='store_true', help='stampa le versioni in JSON')
    restore = commands.add_parser('restore', help='scarica una versione di un file in un percorso esplicito')
    restore.add_argument('path', metavar='ABS_PATH')
    restore.add_argument('--target', choices=('google', 'proton'), required=True,
                         help='destinazione da cui recuperare il file')
    restore.add_argument('--area', choices=('plain', 'private'), required=True,
                         help='area in cui si trova la versione')
    restore.add_argument('--version', required=True, metavar='VERSION',
                         help='current o ID di history restituito da versions')
    restore.add_argument('--to', required=True, metavar='ABS_PATH',
                         help='percorso locale assoluto di destinazione')
    restore.add_argument('--replace', action='store_true', help='sostituisce un file locale già presente')
    restore.add_argument('--links', action='store_true', help='ricrea un .rclonelink come collegamento simbolico')
    restore.add_argument('--json', action='store_true', help='stampa il risultato in JSON')
    verify = commands.add_parser('verify', help='confronta le sorgenti locali attuali con current nel cloud')
    verify.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                        help='destinazione da confrontare')
    verify.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                        help='area da confrontare (predefinita: all)')
    verify.add_argument('--download', action='store_true', help='legge i dati remoti per confrontarli')
    verify.add_argument('--json', action='store_true', help='stampa il confronto in JSON')
    return parser


def main(argv: list[str] | None = None) -> int:
    args = make_parser().parse_args(argv)
    try:
        home = Path.home()
        config = absolute_path(args.config_dir) if args.config_dir else home / ".config/macbackup"
        if args.command == 'restore-icon':
            with operation_lock(home / '.local/state/macbackup'):
                data = restore_icon(absolute_path(args.file), absolute_path(args.folder), args.replace)
            print(json.dumps(data, ensure_ascii=False) if args.json else data['note'])
            return 0
        if args.command == 'forget':
            return forget_operation(args, config, home)
        if args.command == 'versions':
            return versions_operation(args, config, home)
        if args.command == 'restore':
            return restore_operation(args, config, home)
        if args.command == 'verify':
            return verify_operation(args, config, home)
        if args.command == 'mount':
            return mount_operation(args, config, home)
        if args.command == "init":
            files = init_config(config, home)
            print("Configurazione inizializzata. Nessun percorso incluso e nessun accesso cloud.")
            print("\n".join(files))
            return 0
        if args.command == "status":
            file = home / ".local/state/macbackup/last-run.json"
            if file.is_symlink():
                raise ConfigError("Il file di stato non può essere un collegamento.")
            if not file.exists():
                data = {"ok": None, "note": "Nessuna run registrata. Nessun backup certificato."}
            else:
                data = json.loads(file.read_text())
            print(json.dumps(data, ensure_ascii=False, indent=2))
            return 1 if data.get("ok") is False else 0
        policy = Policy(config, home)
        if args.command == 'layout':
            data = split_layout(policy, absolute_path(args.path) if args.path else Path.cwd())
            if args.json:
                print(json.dumps(data, ensure_ascii=False, indent=2))
            else:
                if not data['ok']:
                    for error in data['errors']:
                        print('ERRORE: ' + error.replace('\r', '\\r'), file=sys.stderr)
                else:
                    print(f"{data['path']}: {data['plain_items']} elementi plain, "
                          f"{data['private_items']} privati.")
                    for item in data['private_subtrees']:
                        print(f"PRIVATE {item['path']} "
                              f"({item['private_items']} elementi, {item['selected_bytes']} byte)")
                    if not data['private_subtrees']:
                        print('Nessuna parte privata trovata al suo interno.')
                    print(data['note'])
            return 0 if data['ok'] else 1
        if args.command == "check" and args.target and not args.remote:
            raise ConfigError("check --target richiede anche --remote.")
        if args.command == "run" or (args.command == "preview" and not args.local) or (args.command == "check" and args.remote):
            if args.command == "check" and args.target is None:
                args.target = "google"
            return transport_operation(args, policy)
        if args.command == "explain":
            path = absolute_path(args.path)
            try:
                info = path.lstat()
                kind = file_kind(info)
                exists = True
            except FileNotFoundError:
                kind, exists = "missing", False
            decision = policy.decide(path, directory=kind == "directory")
            data = {
                "scope": "single-path", "path": str(path), "kind": kind,
                "exists": exists, **asdict(decision),
                "note": "Classificazione del solo percorso; usare check per controllare l'intera selezione.",
            }
            if args.json:
                print(json.dumps(data, ensure_ascii=False, indent=2))
            else:
                print(f"{decision.action.upper()}: {path}\n{decision.reason}")
                if decision.rule:
                    print(f"Regola: {decision.rule}")
                if decision.protected_pattern:
                    print(f"Pattern protetto: {decision.protected_pattern}; inclusione esatta: {decision.explicit}")
                if kind == "symlink":
                    print("Collegamento: la destinazione non viene attraversata.")
                if not exists:
                    print("Il percorso non esiste attualmente; questa è solo una classificazione.")
                print(data["note"])
            return 1 if decision.action == "error" else 0
        scan = scan_policy(policy)
        if not policy.roots:
            scan.warnings.append("Nessun percorso selezionato: gli elenchi di inclusione sono vuoti.")
        data = {
            "scope": "local-only", "ok": not scan.errors,
            "config_dir": str(config), "summary": scan.summary(),
            "errors": scan.errors, "warnings": scan.warnings,
        }
        if args.command == "preview":
            # Fail closed: never present a partial scan as an executable plan.
            data["entries"] = [] if scan.errors else [entry.public_dict() for entry in scan.entries]
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print("Controllo locale completato." if data["ok"] else "Controllo locale FALLITO.")
            print("Nessun accesso cloud; nessun file trasferito o cancellato.")
            for error in scan.errors:
                print(f"ERRORE: {error}".replace('\r', '\\r'))
            for warning in scan.warnings:
                print(f"AVVISO: {warning}".replace('\r', '\\r'))
            if args.command == "preview" and not scan.errors:
                for entry in scan.entries:
                    print(f"{entry.decision.action.upper():7} {entry.path} [{entry.kind}] — {entry.decision.reason}".replace('\r', '\\r'))
            counts = data["summary"]
            print(f"Normali: {counts['plain']}; privati: {counts['private']}; "
                  f"saltati: {counts['skipped']}; byte selezionati: {counts['selected_bytes']}.")
            if counts['finder_icons']:
                print(f"Icone Finder da conservare separatamente: {counts['finder_icons']}; "
                      "i byte dei resource fork non sono inclusi nella stima.")
        return 0 if data["ok"] else 1
    except (ConfigError, OSError, TransportError, json.JSONDecodeError) as exc:
        if getattr(args, "json", False):
            print(json.dumps({"scope": "operation-error", "ok": False, "errors": [str(exc)]}, ensure_ascii=False))
        else:
            print(f'{terminal_style("ERRORE:", "1;31", sys.stderr)} {exc}', file=sys.stderr)
        return 1 if isinstance(exc, TransportError) else 2


if __name__ == "__main__":
    raise SystemExit(main())
