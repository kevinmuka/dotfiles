VERSION = "0.15.0"

# English is the source language. Italian is an optional, separate catalog.
def macbackup_language() -> str:
    return 'it' if os.environ.get('MACBACKUP_LANG', 'en').lower() == 'it' else 'en'


_ITALIAN_TRANSLATOR = None


def localized(value: str) -> str:
    if macbackup_language() != 'it':
        return value
    global _ITALIAN_TRANSLATOR
    if _ITALIAN_TRANSLATOR is None:
        import runpy
        catalog = Path(__file__).resolve().with_name('macbackup_locale_it.py')
        _ITALIAN_TRANSLATOR = runpy.run_path(str(catalog))['translate']
    return _ITALIAN_TRANSLATOR(value)


def message(template: str, **values) -> str:
    """Translate a whole template before inserting paths or other user data."""
    return localized(template).format(**values)


_TRANSLATED_JSON_FIELDS = {'reason', 'note', 'error', 'errors', 'warnings'}


def localized_json(value, key: str = ''):
    if isinstance(value, dict):
        return {name: localized_json(item, name) for name, item in value.items()}
    if isinstance(value, list):
        return [localized_json(item, key) for item in value]
    if isinstance(value, str) and key in _TRANSLATED_JSON_FIELDS:
        return localized(value)
    return value


def print(*values, **kwargs):
    """Translate presentation text and explanatory JSON values, never JSON keys."""
    if macbackup_language() != 'it':
        return builtins.print(*values, **kwargs)
    rendered = []
    for value in values:
        if isinstance(value, str):
            try:
                data = json.loads(value) if value.lstrip().startswith(('{', '[')) else None
            except json.JSONDecodeError:
                data = None
            if isinstance(data, (dict, list)):
                value = json.dumps(localized_json(data), ensure_ascii=False,
                                   indent=2 if '\n' in value else None)
            else:
                value = localized(value)
        rendered.append(value)
    return builtins.print(*rendered, **kwargs)
FINDER_ICON = "Icon\r"
ICON_SIDECAR = "/icon.json"
PATH_LISTS = ("plain-paths.txt", "private-paths.txt", "exclude-paths.txt")
PATTERN_FILE = "explicit-only-patterns.txt"
CONFIG_FILES = (*PATH_LISTS, PATTERN_FILE)
SETTINGS_TEMPLATE = '''# No passwords: credentials remain in the rclone configuration.
schema_version = 1
max_delete = 25

[policy]
private_directory_names = []
ignored_file_names = [".DS_Store"]
use_gitignore = false

[targets.google]
enabled = false
plain = "gdrive:MacBackup/plain"
private = "gdrive-private:"

[targets.proton]
enabled = false
plain = "pdrive:MacBackup/plain"
private = "pdrive-private:"
'''


class ConfigError(Exception):
    pass


class GitIgnoreMatcher:
    """Ask Git to evaluate only .gitignore files, without a repository index."""
    def __init__(self):
        executable = shutil.which('git')
        if executable is None:
            raise ConfigError('use_gitignore requires Git in PATH.')
        self.temporary = tempfile.TemporaryDirectory(prefix='macbackup-gitignore-')
        gitdir = str(Path(self.temporary.name) / 'repo.git')
        self.environment = {key: value for key, value in os.environ.items()
                            if not key.startswith('GIT_')}
        initialized = subprocess.run([executable, 'init', '--bare', '-q', gitdir],
                                     env=self.environment, capture_output=True)
        if initialized.returncode:
            self.temporary.cleanup()
            raise ConfigError('Could not initialize .gitignore checking: '
                              + initialized.stderr.decode('utf-8', 'replace').strip())
        command = [executable, '--git-dir', gitdir, '--work-tree', '/',
                   '-c', 'core.bare=false', '-c', 'core.excludesFile=/dev/null',
                   'check-ignore', '--no-index', '-z', '-v', '-n', '--stdin']
        try:
            self.process = subprocess.Popen(command, env=self.environment,
                                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                            stderr=subprocess.PIPE)
        except OSError as exc:
            self.temporary.cleanup()
            raise ConfigError(f'Could not start .gitignore checking: {exc}') from exc
        self.pending = b''
        self.cache: dict[Path, tuple[bool, str | None]] = {}
        atexit.register(self.close)

    def preload(self, paths: list[Path]) -> None:
        waiting = list(dict.fromkeys(path for path in paths if path not in self.cache))
        assert self.process.stdin is not None and self.process.stdout is not None
        try:
            for offset in range(0, len(waiting), 16):
                group = waiting[offset:offset + 16]
                # Resolve symlinked ancestors, but never follow an entry itself.
                physicals = [Path(os.path.realpath(path.parent)) / path.name for path in group]
                self.process.stdin.write(b''.join(os.fsencode(str(path)) + b'\0'
                                                  for path in physicals))
                self.process.stdin.flush()
                for path, physical in zip(group, physicals):
                    while self.pending.count(b'\0') < 4:
                        ready, _, _ = select.select([self.process.stdout], [], [], 30)
                        if not ready:
                            raise ConfigError('No response from Git during .gitignore checking.')
                        chunk = os.read(self.process.stdout.fileno(), 4096)
                        if not chunk:
                            detail = self.process.stderr.read().decode('utf-8', 'replace').strip()
                            raise ConfigError('.gitignore checking stopped: ' + detail)
                        self.pending += chunk
                    fields = self.pending.split(b'\0', 4)
                    self.pending = fields[4]
                    source, line, pattern, returned = [field.decode('utf-8', 'replace')
                                                       for field in fields[:4]]
                    if returned != str(physical):
                        raise ConfigError('Inconsistent .gitignore response from Git.')
                    ignored = bool(pattern) and not pattern.startswith('!')
                    if ignored and source and not source.startswith('/'):
                        source = '/' + source
                    rule = f'{source}:{line}:{pattern}' if ignored else None
                    self.cache[path] = (ignored, rule)
        except OSError as exc:
            raise ConfigError(f'Could not check .gitignore: {exc}') from exc

    def match(self, path: Path) -> tuple[bool, str | None]:
        self.preload([path])
        return self.cache[path]

    def close(self) -> None:
        process = getattr(self, 'process', None)
        if process is not None:
            try:
                if process.stdin is not None:
                    process.stdin.close()
                process.wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                process.kill()
                process.wait()
            for stream in (process.stdout, process.stderr):
                if stream is not None:
                    stream.close()
            self.process = None
        temporary = getattr(self, 'temporary', None)
        if temporary is not None:
            temporary.cleanup()
            self.temporary = None

    def __del__(self):
        self.close()


def absolute_path(value: str) -> Path:
    if not value.startswith("/") or ".." in value.split("/"):
        raise ConfigError("An absolute path without '..' components is required.")
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ConfigError("Paths cannot contain control characters.")
    try:
        value.encode("utf-8")
    except UnicodeError as exc:
        raise ConfigError("The path cannot be represented correctly in UTF-8.") from exc
    return Path("/" + os.path.normpath(value).lstrip("/"))


def inside(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


@dataclass(frozen=True)
class Rule:
    path: Path
    directory: bool
    source: str
    line: int

    def matches(self, path: Path) -> bool:
        return path == self.path or (self.directory and inside(path, self.path))


@dataclass(frozen=True)
class NamePattern:
    value: str
    directory: bool
    line: int

    def matches(self, name: str) -> bool:
        return fnmatch.fnmatchcase(name.casefold(), self.value.casefold())

    @property
    def display(self) -> str:
        return self.value + ('/' if self.directory else '')


def _glob_states(pattern: str, states: frozenset[int]) -> frozenset[int]:
    expanded = set(states)
    for position in sorted(states):
        while position < len(pattern) and pattern[position] == '*':
            position += 1
            expanded.add(position)
    return frozenset(expanded)


def _glob_step(pattern: str, states: frozenset[int], char: str) -> frozenset[int]:
    following = set()
    for position in states:
        if position == len(pattern):
            continue
        if pattern[position] == '*':
            following.add(position)
        elif pattern[position] == char:
            following.add(position + 1)
    return _glob_states(pattern, frozenset(following))


def _glob_relation(first: str, second: str) -> tuple[bool, bool, bool]:
    """Return overlap, first subset of second, second subset of first for * globs."""
    first, second = first.casefold(), second.casefold()
    alphabet = set(first + second) - {'*'}
    other = '\0'
    while other in alphabet:
        other = chr(ord(other) + 1)
    alphabet.add(other)
    initial = (_glob_states(first, frozenset({0})),
               _glob_states(second, frozenset({0})))
    pending = [initial]
    seen = {initial}
    first_subset = second_subset = True
    intersection = False
    while pending:
        left, right = pending.pop()
        left_accept, right_accept = len(first) in left, len(second) in right
        intersection |= left_accept and right_accept
        if left_accept and not right_accept:
            first_subset = False
        if right_accept and not left_accept:
            second_subset = False
        for char in alphabet:
            successor = (_glob_step(first, left, char), _glob_step(second, right, char))
            if successor not in seen:
                seen.add(successor)
                pending.append(successor)
    return intersection, first_subset, second_subset


@dataclass(frozen=True)
class Decision:
    action: str
    reason: str
    rule: str | None = None
    protected_pattern: str | None = None
    explicit: bool = False


@dataclass
class Entry:
    path: str
    kind: str
    size: int
    decision: Decision
    device: int
    inode: int

    def public_dict(self) -> dict:
        return {
            "path": self.path,
            "kind": self.kind,
            "size": self.size,
            **asdict(self.decision),
        }


@dataclass
class Scan:
    entries: list[Entry]
    errors: list[str]
    warnings: list[str]

    def summary(self) -> dict:
        counts = Counter(entry.decision.action for entry in self.entries)
        return {
            "plain": counts["plain"],
            "private": counts["private"],
            "skipped": counts["skip"],
            "finder_icons": sum(entry.kind == 'finder-icon' and entry.decision.action in ('plain', 'private') for entry in self.entries),
            "selected_bytes": sum(
                entry.size for entry in self.entries
                if entry.decision.action in ("plain", "private")
            ),
        }


def read_lines(file: Path) -> list[tuple[int, str]]:
    try:
        # These files are user policy, not data selected for backup.
        lines = file.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        raise ConfigError(f"Could not read {file}: {exc}") from exc
    result = []
    for number, value in enumerate(lines, 1):
        if not value.strip() or value.startswith("#"):
            continue
        if value != value.strip():
            raise ConfigError(f"{file}:{number}: ambiguous leading or trailing spaces.")
        result.append((number, value))
    return result


class Policy:
    def __init__(self, config_dir: Path, home: Path):
        self.config_dir = config_dir
        self.home = home
        self.state_dir = home / ".local/state/macbackup"
        self.state_physical = Path(os.path.realpath(self.state_dir))
        self.plain = self._rules("plain-paths.txt")
        self.private = self._rules("private-paths.txt")
        self.excluded = self._rules("exclude-paths.txt")
        self.warnings: list[str] = []
        paths: dict[Path, Rule] = {}
        for rule in self.plain + self.private + self.excluded:
            prior = paths.get(rule.path)
            if prior is not None:
                raise ConfigError(f'{prior.source}:{prior.line} and {rule.source}:{rule.line}: '
                                  f'duplicate path: {rule.path}')
            paths[rule.path] = rule
        for root in self.roots:
            ancestor = next((excluded for excluded in self.excluded
                             if excluded.directory and excluded.path != root.path
                             and inside(root.path, excluded.path)), None)
            if ancestor is not None:
                self.warnings.append(message(
                    '{source}:{line}: {path} suspended by {other_source}:{other_line}: {other_path}.',
                    source=root.source, line=root.line, path=root.path,
                    other_source=ancestor.source, other_line=ancestor.line,
                    other_path=ancestor.path,
                ))
        try:
            import tomllib
        except ImportError as exc:
            raise ConfigError('Name rules require Python 3.11 or later.') from exc
        try:
            settings = tomllib.loads((config_dir / 'settings.toml').read_text())
        except (OSError, ValueError) as exc:
            raise ConfigError(f'Could not read settings.toml: {exc}') from exc
        policy_settings = settings.get('policy', {})
        target_names = settings.get('targets', {})
        if not isinstance(target_names, dict):
            raise ConfigError('settings.toml: targets must be a table.')
        self.mount_roots = tuple(
            home / 'Desktop' / (name if area == 'all' else f'{name}-{area}')
            for name in target_names for area in ('plain', 'private', 'all')
        )
        if not isinstance(policy_settings, dict):
            raise ConfigError('settings.toml: policy must be a table.')
        names = policy_settings.get('private_directory_names', [])
        if not isinstance(names, list) or any(
            not isinstance(name, str) or not name or name in ('.', '..')
            or name.strip() != name or '/' in name
            or any(char in name for char in '*?[]{}\\')
            or any(ord(char) < 32 or ord(char) == 127 for char in name)
            for name in names
        ):
            raise ConfigError('settings.toml: private_directory_names requires literal directory names.')
        if len({name.casefold() for name in names}) != len(names):
            raise ConfigError('settings.toml: private_directory_names contains duplicate names.')
        self.private_directory_names = {name.casefold() for name in names}
        ignored = policy_settings.get('ignored_file_names', [])
        if not isinstance(ignored, list) or any(
            not isinstance(name, str) or not name or name in ('.', '..')
            or '/' in name
            or any(char in name for char in '*?[]{}\\')
            or any(ord(char) < 32 or ord(char) == 127 for char in name)
            for name in ignored
        ):
            raise ConfigError('settings.toml: ignored_file_names requires literal file names.')
        if len({name.casefold() for name in ignored}) != len(ignored):
            raise ConfigError('settings.toml: ignored_file_names contains duplicate names.')
        self.ignored_file_names = {name.casefold() for name in ignored}
        use_gitignore = policy_settings.get('use_gitignore', False)
        if type(use_gitignore) is not bool:
            raise ConfigError('settings.toml: use_gitignore must be true or false.')
        self.patterns: list[NamePattern] = []
        for number, pattern in read_lines(config_dir / PATTERN_FILE):
            directory = pattern.endswith('/')
            name = pattern[:-1] if directory else pattern
            invalid = (
                not name or "/" in name or "**" in name
                or any(char in pattern for char in "?[]{}\\")
                or pattern.startswith(("+", "-"))
                or any(ord(char) < 32 or ord(char) == 127 for char in pattern)
            )
            if invalid:
                raise ConfigError(
                    f"{PATTERN_FILE}:{number}: only names and '*' are allowed, "
                    "with a trailing '/' for directories."
                )
            candidate = NamePattern(name, directory, number)
            if directory:
                for private_name in names:
                    if candidate.matches(private_name):
                        raise ConfigError(f'{PATTERN_FILE}:{number} ({candidate.display}) and '
                                          f'settings.toml:[policy].private_directory_names '
                                          f'({private_name}): redundant rules.')
            else:
                for ignored_name in ignored:
                    if candidate.matches(ignored_name):
                        raise ConfigError(f'{PATTERN_FILE}:{number} ({candidate.display}) and '
                                          f'settings.toml:[policy].ignored_file_names '
                                          f'({ignored_name}): overlapping protections.')
            for prior in self.patterns:
                if prior.directory != candidate.directory:
                    continue
                intersects, prior_subset, candidate_subset = _glob_relation(
                    prior.value, candidate.value)
                if prior_subset or candidate_subset:
                    raise ConfigError(f'{PATTERN_FILE}:{prior.line} ({prior.display}) and '
                                      f'{PATTERN_FILE}:{number} ({candidate.display}): '
                                      'redundant patterns.')
                if intersects:
                    self.warnings.append(f'{PATTERN_FILE}:{prior.line} ({prior.display}) and '
                                         f'{PATTERN_FILE}:{number} ({candidate.display}): '
                                         'partially overlapping patterns.')
            self.patterns.append(candidate)
        self.gitignore = GitIgnoreMatcher() if use_gitignore else None
        credential_roots = [
            home / ".config/rclone",
            home / "Library/Preferences/rclone",
        ]
        custom_config = os.environ.get('RCLONE_CONFIG')
        if custom_config:
            credential_roots.append(Path(os.path.abspath(custom_config)))
        self.credential_roots = tuple({
            *credential_roots,
            *(Path(os.path.realpath(root)) for root in credential_roots),
        })

    def _rules(self, filename: str) -> list[Rule]:
        result = []
        seen: dict[Path, int] = {}
        for line, value in read_lines(self.config_dir / filename):
            try:
                path = absolute_path(value)
            except ConfigError as exc:
                raise ConfigError(f"{filename}:{line}: {exc}") from exc
            if path == Path("/"):
                raise ConfigError(f"{filename}:{line}: the root '/' is not allowed.")
            if path in seen:
                raise ConfigError(f'{filename}:{seen[path]} and {filename}:{line}: '
                                  f'duplicate path: {path}')
            seen[path] = line
            directory = value.endswith('/')
            try:
                info = path.lstat()
            except FileNotFoundError:
                pass
            except OSError as exc:
                raise ConfigError(f'{filename}:{line}: {path}: {exc}') from exc
            else:
                if stat.S_ISDIR(info.st_mode) != directory:
                    expected = 'directory with trailing /' if stat.S_ISDIR(info.st_mode) else 'file or symlink without trailing /'
                    raise ConfigError(f'{filename}:{line}: {path}: type mismatch; '
                                      f'expected {expected}.')
            result.append(Rule(path, directory, filename, line))
        return result

    @property
    def roots(self) -> list[Rule]:
        return self.plain + self.private

    def decide(self, path: Path, directory: bool = False,
               check_gitignore: bool = True) -> Decision:
        physical = Path(os.path.realpath(path))
        if inside(path, self.state_dir) or inside(physical, self.state_physical):
            return Decision("skip", "Operational state excluded automatically.", str(self.state_dir))
        mount_root = next((root for root in self.mount_roots if inside(path, root)), None)
        if mount_root:
            return Decision('skip', 'Mountpoint excluded automatically.', str(mount_root))
        excluded = next((rule for rule in self.excluded if rule.matches(path)), None)
        if excluded:
            return Decision("skip", "Absolute exclusion.", str(excluded.path))
        private = next((rule for rule in self.private if rule.matches(path)), None)
        plain = next((rule for rule in self.plain if rule.matches(path)), None)
        if not (private or plain):
            return Decision("skip", "Path not selected.")
        exact = any(rule.path == path for rule in self.roots)
        if not directory and path.name.casefold() in self.ignored_file_names and not exact:
            return Decision('skip', 'Filename ignored by policy.',
                            'settings.toml:[policy].ignored_file_names')
        named_directories = ([path] if directory else []) + list(path.parents)
        private_by_name = any(
            ancestor != Path('/')
            and ancestor.name.casefold() in self.private_directory_names
            and not any(rule.path == ancestor for rule in self.plain)
            for ancestor in named_directories
        )
        # Classify remote files using the same directory pruning as the local
        # scanner. Otherwise an older cloud copy under a newly protected
        # directory would be mistaken for a local deletion and archived.
        for ancestor in path.parents:
            if ancestor == Path('/'):
                break
            protected_ancestor = next(
                (pattern for pattern in self.patterns
                 if pattern.directory and pattern.matches(ancestor.name)), None
            )
            if (protected_ancestor and ancestor.name.casefold() not in self.private_directory_names
                    and not any(rule.path == ancestor for rule in self.roots)):
                return Decision(
                    "skip", "Protected parent directory: exact inclusion required.",
                    protected_pattern=protected_ancestor.display,
                )
        protected = next(
            (pattern for pattern in self.patterns
             if pattern.directory == directory and pattern.matches(path.name)), None
        )
        if protected and not exact and not (directory and path.name.casefold() in self.private_directory_names):
            return Decision(
                "skip", "Exact path inclusion required (explicit-only).",
                protected_pattern=protected.display,
            )
        if check_gitignore and self.gitignore is not None and not exact and not private_by_name:
            ignored, source = self.gitignore.match(path)
            if ignored:
                return Decision('skip', 'Excluded by .gitignore.', source)
        if private:
            return Decision("private", "Private inclusion.", str(private.path),
                            protected.display if protected else None, exact)
        if private_by_name:
            return Decision("private", "Directory encrypted by name.",
                            'settings.toml:[policy].private_directory_names',
                            protected.display if protected else None, exact)
        if not directory and any(inside(path, root) or inside(physical, root) for root in self.credential_roots):
            return Decision(
                "error", "rclone configuration selected as plain: add "
                "the path to private-paths.txt or exclude it.", str(plain.path)
            )
        return Decision("plain", "Plain inclusion.", str(plain.path),
                        protected.display if protected else None, exact)


def file_kind(info: os.stat_result) -> str:
    if stat.S_ISDIR(info.st_mode):
        return "directory"
    if stat.S_ISREG(info.st_mode):
        return "file"
    if stat.S_ISLNK(info.st_mode):
        return "symlink"
    return "special"


class MacXattrs:
    """Use fd-based native APIs: Python's os xattr APIs are absent on macOS."""
    def __init__(self):
        if sys.platform != "darwin":
            raise ConfigError("Finder icons require macOS.")
        import ctypes
        self.c = ctypes
        self.lib = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
        self.lib.fgetxattr.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_void_p,
                                      ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
        self.lib.fgetxattr.restype = ctypes.c_ssize_t
        self.lib.fsetxattr.argtypes = self.lib.fgetxattr.argtypes
        self.lib.fsetxattr.restype = ctypes.c_int

    def get(self, fd: int, name: str) -> bytes | None:
        size = self.lib.fgetxattr(fd, name.encode(), None, 0, 0, 0)
        if size < 0:
            error = self.c.get_errno()
            if error == 93:  # ENOATTR on Darwin
                return None
            raise OSError(error, "Could not read metadata " + name)
        if size > 64 * 1024 * 1024:
            raise ConfigError("Icon metadata exceeds 64 MiB; operation blocked.")
        buffer = self.c.create_string_buffer(size)
        if self.lib.fgetxattr(fd, name.encode(), buffer, size, 0, 0) != size:
            raise OSError("Icon metadata changed while being read.")
        return buffer.raw

    def set(self, fd: int, name: str, value: bytes) -> None:
        if self.lib.fsetxattr(fd, name.encode(), value, len(value), 0, 0):
            raise OSError(self.c.get_errno(), "Could not restore metadata " + name)


def icon_snapshot(entry: Entry) -> dict:
    api = MacXattrs()
    path = Path(entry.path)
    parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open(FINDER_ICON, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            before = os.fstat(fd)
            if not stat.S_ISREG(before.st_mode) or (before.st_dev, before.st_ino) != (entry.device, entry.inode):
                raise ConfigError("The icon was replaced after the scan.")
            if before.st_size > 64 * 1024 * 1024:
                raise ConfigError("Icon file exceeds 64 MiB; operation blocked.")
            with os.fdopen(os.dup(fd), "rb") as stream:
                data = stream.read(64 * 1024 * 1024 + 1)
            if len(data) > 64 * 1024 * 1024:
                raise ConfigError("Icon file grew beyond 64 MiB while being read.")
            attrs = {name: api.get(fd, name) for name in ('com.apple.ResourceFork', 'com.apple.FinderInfo')}
            finder = api.get(parent, 'com.apple.FinderInfo')
            after = os.fstat(fd)
            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ConfigError("The icon changed while being read.")
        finally:
            os.close(fd)
    finally:
        os.close(parent)
    if any(value is not None and len(value) != 32 for value in (finder, attrs['com.apple.FinderInfo'])):
        raise ConfigError("FinderInfo has an unexpected size; operation blocked.")
    encode = lambda value: None if value is None else base64.b64encode(value).decode('ascii')
    return {'schema_version': 1, 'kind': 'macos-finder-icon', 'source': entry.path,
            'data_base64': encode(data), 'file_xattrs': {k: encode(v) for k, v in attrs.items()},
            'folder_finder_info': encode(finder)}


def restore_icon(file: Path, folder: Path, replace: bool) -> dict:
    if file.stat().st_size > 180 * 1024 * 1024:
        raise ConfigError("Icon restore file is too large.")
    snapshot = json.loads(file.read_text())
    if (not isinstance(snapshot, dict) or type(snapshot.get('schema_version')) is not int or snapshot.get('schema_version') != 1
            or snapshot.get('kind') != 'macos-finder-icon'):
        raise ConfigError("Unrecognized icon restore format.")
    try:
        decode = lambda value: base64.b64decode(value, validate=True)
        data = decode(snapshot['data_base64'])
        attrs = snapshot['file_xattrs']
        if not isinstance(attrs, dict) or set(attrs) != {'com.apple.ResourceFork', 'com.apple.FinderInfo'}:
            raise ValueError("Attributi inattesi")
        attrs = {k: None if v is None else decode(v) for k, v in attrs.items()}
        finder = snapshot['folder_finder_info']
        finder = None if finder is None else decode(finder)
        if any(value is not None and len(value) != 32 for value in (finder, attrs['com.apple.FinderInfo'])):
            raise ValueError("Invalid FinderInfo")
    except (KeyError, TypeError, ValueError) as exc:
        raise ConfigError("Invalid icon restore data.") from exc
    api = MacXattrs()
    directory = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = '.macbackup-icon-' + uuid.uuid4().hex
    try:
        current = api.get(directory, 'com.apple.FinderInfo') or bytes(32)
        if len(current) != 32:
            raise ConfigError("Invalid FinderInfo on destination folder.")
        flags = int.from_bytes(current[8:10], 'big') & ~0x0400
        flags |= int.from_bytes((finder or bytes(32))[8:10], 'big') & 0x0400
        updated = current[:8] + flags.to_bytes(2, 'big') + current[10:]
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            with os.fdopen(os.dup(fd), 'wb') as stream:
                stream.write(data)
            for name, value in attrs.items():
                if value is not None:
                    api.set(fd, name, value)
        finally:
            os.close(fd)
        if replace:
            os.rename(temporary, FINDER_ICON, src_dir_fd=directory, dst_dir_fd=directory)
        else:
            try:
                os.link(temporary, FINDER_ICON, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
            except FileExistsError as exc:
                raise ConfigError("Icon already present; use --replace to replace only the icon.") from exc
            os.unlink(temporary, dir_fd=directory)
        api.set(directory, 'com.apple.FinderInfo', updated)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)
    return {'ok': True, 'folder': str(folder), 'note': 'Icon restored; no cloud access.'}


def scan_policy(policy: Policy, pulse: 'MountPulse | None' = None) -> Scan:
    result = Scan([], [], list(policy.warnings))
    seen: set[Path] = set()

    def visit(path: Path, parent_fd: int | None = None, child: str | None = None) -> None:
        if path in seen:
            return
        seen.add(path)
        if pulse is not None:
            pulse.completed += 1
        # Absolute exclusions are authoritative, even for missing included roots.
        preliminary = policy.decide(path, directory=True, check_gitignore=False)
        if preliminary.action == "skip" and preliminary.rule:
            result.entries.append(Entry(str(path), "excluded-subtree", 0, preliminary, 0, 0))
            return
        try:
            info = (os.stat(child, dir_fd=parent_fd, follow_symlinks=False)
                    if parent_fd is not None else path.lstat())
            kind = file_kind(info)
            if path.name == FINDER_ICON:
                if kind != 'file':
                    result.errors.append(f"{path.parent}: Icon\\r must be a regular file.")
                    return
                kind = 'finder-icon'
            decision = policy.decide(path, directory=kind == "directory")
            if (policy.gitignore is not None and decision.action in ('plain', 'private')
                    and (any(rule.path == path for rule in policy.roots)
                         or (kind == 'directory'
                             and path.name.casefold() in policy.private_directory_names
                             and decision.action == 'private'))):
                ignored, source = policy.gitignore.match(path)
                if ignored:
                    direct = next((rule for rule in policy.roots if rule.path == path), None)
                    overriding = (f'{direct.source}:{direct.line}' if direct else
                                  'settings.toml:[policy].private_directory_names')
                    result.warnings.append(f'{path}: {overriding} overrides '
                                           f'.gitignore {source}.')
            if decision.action == "error":
                result.errors.append(f"{path}: {decision.reason}")
                return
            if kind == "directory":
                if decision.action == "skip":
                    if decision.protected_pattern or decision.reason == 'Excluded by .gitignore.':
                        result.entries.append(Entry(str(path), "excluded-subtree", 0, decision, 0, 0))
                    return
                # Anchor traversal to directory descriptors and refuse replaced
                # symlinks. Explicit root paths may have symlinked ancestors.
                flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                fd = (os.open(child, flags, dir_fd=parent_fd)
                      if parent_fd is not None else os.open(path, flags))
                try:
                    opened = os.fstat(fd)
                    if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                        raise OSError("The directory changed during the check.")
                    with os.scandir(fd) as iterator:
                        names = sorted(entry.name for entry in iterator)
                    valid_names = []
                    for name in names:
                        try:
                            absolute_path(str(path)) if name == FINDER_ICON else absolute_path(str(path / name))
                        except ConfigError as exc:
                            result.errors.append(f"Name cannot be represented in {path}: {exc}")
                            continue
                        valid_names.append(name)
                    if policy.gitignore is not None:
                        policy.gitignore.preload([path / name for name in valid_names])
                    for name in valid_names:
                        visit(path / name, fd, name)
                finally:
                    os.close(fd)
                return
            if kind == "special":
                if any(rule.path == path for rule in policy.roots):
                    result.errors.append(f"{path}: unsupported special source.")
                else:
                    result.warnings.append(f"{path}: socket, FIFO or device skipped.")
                    decision = Decision("skip", "Unsupported special file.")
            if decision.action in ("plain", "private"):
                if kind in ("file", "finder-icon") and not os.access(path, os.R_OK):
                    result.errors.append(f"{path}: unreadable file.")
                if kind == "file" and path.name.endswith(".rclonelink"):
                    result.errors.append(f"{path}: name reserved for rclone link representation.")
                if kind == "symlink":
                    result.warnings.append(f"{path}: symlink; target not traversed.")
                if decision.action == "plain" and decision.protected_pattern:
                    result.warnings.append(f"{path}: protected name EXPLICITLY allowed as plain.")
            result.entries.append(Entry(
                str(path), kind, info.st_size, decision, info.st_dev, info.st_ino
            ))
        except OSError as exc:
            result.errors.append(f"{path}: {exc}")

    for rule in sorted(policy.roots, key=lambda item: (len(item.path.parts), str(item.path))):
        visit(rule.path)

    identities: dict[tuple[int, int], list[Entry]] = defaultdict(list)
    for entry in result.entries:
        if entry.kind in ("file", "finder-icon"):
            identities[(entry.device, entry.inode)].append(entry)
    for aliases in identities.values():
        selected = [entry for entry in aliases if entry.decision.action in ("plain", "private")]
        if {entry.decision.action for entry in selected} == {"plain", "private"}:
            result.errors.append(
                "Same file reached as both plain and private: "
                + ", ".join(entry.path for entry in selected)
            )
        protected = [entry for entry in aliases if entry.decision.protected_pattern]
        for entry in selected:
            if protected and not entry.decision.explicit and not entry.decision.protected_pattern:
                result.errors.append(
                    f"{entry.path}: alias of a protected filename; "
                    "this path also requires exact inclusion."
                )
    result.entries.sort(key=lambda entry: entry.path)
    result.errors = sorted(set(result.errors))
    result.warnings = sorted(set(result.warnings))
    return result


def split_layout(policy: Policy, root: Path, pulse: MountPulse | None = None) -> dict:
    if not root.is_dir() or root.is_symlink():
        raise ConfigError('layout requires a real local directory.')
    if policy.decide(root, directory=True).action != 'plain':
        raise ConfigError('layout requires a directory selected as plain.')
    scan = scan_policy(policy, pulse)
    if scan.errors:
        return {'scope': 'local-only', 'ok': False, 'path': str(root),
                'errors': scan.errors, 'warnings': scan.warnings, 'private_subtrees': []}
    groups: dict[str, dict] = {}
    plain_count = 0
    private_count = 0
    action_cache: dict[Path, str] = {}

    def directory_action(path: Path) -> str:
        if path not in action_cache:
            action_cache[path] = policy.decide(path, directory=True).action
        return action_cache[path]

    for entry in scan.entries:
        path = Path(entry.path)
        if not inside(path, root) or entry.decision.action not in ('plain', 'private'):
            continue
        if entry.decision.action == 'plain':
            plain_count += 1
            continue
        private_count += 1
        boundary = path
        while boundary.parent != boundary and inside(boundary.parent, root):
            parent_action = directory_action(boundary.parent)
            if parent_action == 'plain':
                key = str(boundary)
                item = groups.setdefault(key, {
                    'path': key, 'kind': entry.kind if boundary == path else 'directory',
                    'private_items': 0, 'selected_bytes': 0,
                    'logical_destination': 'private/current' + key,
                })
                item['private_items'] += 1
                item['selected_bytes'] += entry.size
                break
            if parent_action != 'private':
                break
            boundary = boundary.parent
    return {'scope': 'local-only', 'ok': True, 'path': str(root),
            'plain_items': plain_count, 'private_items': private_count,
            'private_subtrees': [groups[key] for key in sorted(groups)],
            'warnings': scan.warnings,
            'note': 'Current local classification; no cloud access. Historical copies are not listed.'}


def init_config(directory: Path, home: Path) -> list[str]:
    templates = {
        "plain-paths.txt": "# Directories have trailing /; files and symlinks do not. No active inclusions.\n"
        f"# {home}/Desktop/\n# {home}/Documents/\n# {home}/.config/\n# {home}/.dotfiles/\n",
        "private-paths.txt": "# Directories have trailing /; files and symlinks do not. No active inclusions.\n"
        f"# {home}/.ssh/\n# {home}/.config/rclone/\n",
        "exclude-paths.txt": "# Absolute exclusions; directories have trailing /, files do not. No active exclusions.\n",
        PATTERN_FILE: "# Directory names have trailing /; file/symlink names do not. Exact inclusion required.\n.env\n.env.*\n.env/\n.env.*/\n",
    }
    templates["settings.toml"] = SETTINGS_TEMPLATE
    if any(os.path.lexists(directory / name) for name in templates):
        raise ConfigError("Configuration already exists, even partially; no files overwritten.")
    if directory.is_symlink():
        raise ConfigError("The configuration directory cannot be a symlink for init.")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    created = []
    try:
        for name, contents in templates.items():
            path = directory / name
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            created.append(path)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(localized(contents))
    except OSError:
        for path in created:
            path.unlink(missing_ok=True)
        raise
    return [str(path) for path in created]


class TransportError(Exception):
    pass


class TransferProblem(TransportError):
    def __init__(self, message: str, stats: dict | None = None):
        super().__init__(message)
        self.stats = stats


class TransferInterrupted(Exception):
    def __init__(self, stats: dict | None = None):
        self.stats = stats


def active_directories(stats: dict, home: Path, depth: int) -> list[str]:
    groups = set()
    prefix = str(home).lstrip('/') + '/'
    for item in stats.get('transferring', []):
        name = item.get('name') if isinstance(item, dict) else None
        if not isinstance(name, str):
            continue
        if name.startswith(prefix):
            parts = name[len(prefix):].split('/')
            folders = parts[:-1] or parts
            groups.add('~/' + '/'.join(folders[:depth]))
        elif name:
            parts = name.lstrip('/').split('/')
            folders = parts[:-1] or parts
            groups.add('/' + '/'.join(folders[:depth]))
    return sorted(groups)


def progress_quantity(value: object, binary: bool) -> str:
    if not isinstance(value, (int, float)) or value < 0:
        return '?'
    base = 1024 if binary else 1000
    units = ('B', 'KiB', 'MiB', 'GiB', 'TiB') if binary else ('B', 'kB', 'MB', 'GB', 'TB')
    number = float(value)
    unit = 0
    while number >= base and unit < len(units) - 1:
        number /= base
        unit += 1
    return f'{number:.1f} {units[unit]}' if unit else f'{int(number)} B'


def progress_duration(value: object) -> str:
    if not isinstance(value, (int, float)) or value < 0:
        return '?'
    seconds = int(value)
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    parts = [f'{amount}{suffix}' for amount, suffix in
             ((days, 'd'), (hours, 'h'), (minutes, 'm'), (seconds, 's')) if amount]
    if not parts:
        parts.append('0s')
    return ''.join(parts)


def progress_bar(done: object, total: object, width: int = 28) -> str:
    if not isinstance(done, (int, float)) or not isinstance(total, (int, float)) or total <= 0:
        return '[' + '-' * width + ']  ?%'
    ratio = max(0.0, min(1.0, done / total))
    filled = min(width, int(ratio * width))
    return '[' + '#' * filled + '-' * (width - filled) + f'] {ratio * 100:5.1f}%'


def progress_lines(stats: dict | None, home: Path, depth: int, binary: bool,
                   legend: bool, label: str, width: int = 90) -> list[str]:
    stats = stats or {}
    bar_width = max(12, min(36, width - 55))
    lines = [f'macbackup  {label}  |  Elapsed {progress_duration(stats.get("elapsedTime"))}', '']
    byte_count = stats.get('bytes', 0)
    total_bytes = stats.get('totalBytes')
    transfers = stats.get('transfers', 0)
    total_transfers = stats.get('totalTransfers')
    lines.extend((
        f'Data       {progress_bar(byte_count, total_bytes, bar_width)}  '
        f'{progress_quantity(byte_count, binary)} / {progress_quantity(total_bytes, binary)}',
        f'File       {progress_bar(transfers, total_transfers, bar_width)}  '
        f'{transfers} / {total_transfers if isinstance(total_transfers, int) else "?"}',
        '',
        f'SPEED  {progress_quantity(stats.get("speed"), binary)}/s'
        f'     ETA {progress_duration(stats.get("eta"))}',
        f'Checks {stats.get("checks", 0)} / {stats.get("totalChecks", "?")}'
        f'     Listed {stats.get("listed", "?")}',
        f'Server-side moves {stats.get("serverSideMoves", 0)}'
        f' ({progress_quantity(stats.get("serverSideMoveBytes", 0), binary)})'
        f'     Renamed {stats.get("renames", 0)}',
        '',
    ))
    folders = active_directories(stats, home, depth)
    lines.append('Active folders: ' + (', '.join(folders) if folders else 'none'))
    lines.append('Active files:')
    active = stats.get('transferring', [])
    if not active:
        lines.append('  none')
    for item in active:
        if not isinstance(item, dict):
            continue
        name = item.get('name', '?')
        lines.append('  ' + str(name))
        lines.append('    ' + progress_bar(item.get('bytes'), item.get('size'), 12)
                     + '  ' + progress_quantity(item.get('bytes'), binary)
                     + ' / ' + progress_quantity(item.get('size'), binary)
                     + '  |  ' + progress_quantity(item.get('speed'), binary) + '/s')
    current_unit = 'binary (KiB, MiB, GiB)' if binary else 'decimal (kB, MB, GB)'
    next_unit = 'decimal' if binary else 'binary'
    lines.extend(('', f'Keys  [u] Switch to {next_unit} units  |  '
                   f'[?] {"Hide" if legend else "Show"} legend  |  '
                   '[Ctrl-C] Stop backup',
                  f'Current units: {current_unit}'))
    if legend:
        lines.extend((
            '', 'Legend (current phase only: plain, icons or private)',
            '  Data: bytes transferred / expected. The percentage is based on bytes.',
            '  Files: transfers completed / expected. The percentage is based on files.',
            '  SPEED: current overall rate; ETA: estimate may change.',
            '  Checks: files compared with existing copies; Listed: entries enumerated.',
            '  Server-side moves: files moved by the provider without downloading.',
            '  Renamed: files recognized under a new name.',
            '  Active folders and files: in-progress operations; several may run at once.',
        ))
    return lines


def styled_progress_lines(lines: list[str], stream) -> str:
    """Highlight dashboard landmarks without changing redirected output."""
    if not terminal_can_color(stream):
        return localized('\n'.join(lines))
    lines = [localized(line) for line in lines]
    labels = {'macbackup': '1;36', 'Data': '1;36',
              'Active files:': '1;36', 'File': '1;36',
              'SPEED': '1;32', 'Checks': '1;36',
              'Server-side moves': '1;36', 'Active folders:': '1;36'}
    rendered = []
    active_files = False
    secondary = False
    for line in lines:
        if line == 'Active files:':
            active_files = True
        elif line.startswith('Keys'):
            active_files = False
            secondary = True
        if secondary:
            rendered.append(terminal_style(line, '2;90', stream) if line else line)
            continue
        if active_files and line.startswith('  ') and not line.startswith('    '):
            rendered.append('  ' + terminal_style(line[2:], '2;90', stream))
            continue
        label = next((name for name in labels if line.startswith(name)), None)
        rendered.append(terminal_style(label, labels[label], stream) + line[len(label):]
                        if label else line)
    return '\n'.join(rendered)


class ProgressDisplay:
    def __init__(self, home: Path, depth: int, label: str):
        self.home, self.depth, self.label = home, depth, label
        self.binary = True
        self.legend = False
        self.stats: dict | None = None
        self.interactive = sys.stdin.isatty() and sys.stderr.isatty()
        self.terminal_settings = None

    def __enter__(self):
        if self.interactive:
            try:
                self.terminal_settings = termios.tcgetattr(sys.stdin.fileno())
                tty.setcbreak(sys.stdin.fileno())
                sys.stderr.write('\x1b[?1049h\x1b[?25l')
                self.draw()
            except (OSError, termios.error):
                self.interactive = False
                if self.terminal_settings is not None:
                    termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.terminal_settings)
                    self.terminal_settings = None
        return self

    def __exit__(self, *_exc):
        if self.interactive:
            sys.stderr.write('\x1b[?25h\x1b[?1049l')
            sys.stderr.flush()
        if self.terminal_settings is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.terminal_settings)
        if self.interactive and self.stats is not None:
            print(styled_progress_lines(progress_lines(self.stats, self.home, self.depth,
                                                       self.binary, False, self.label), sys.stderr),
                  file=sys.stderr, flush=True)

    def draw(self):
        if not self.interactive:
            return
        width = shutil.get_terminal_size((90, 30)).columns
        lines = progress_lines(self.stats, self.home, self.depth,
                               self.binary, self.legend, self.label, width)
        sys.stderr.write('\x1b[H\x1b[2J' + styled_progress_lines(lines, sys.stderr) + '\n')
        sys.stderr.flush()

    def update(self, stats: dict):
        self.stats = stats
        if self.interactive:
            self.draw()
        else:
            print('\n'.join(progress_lines(stats, self.home, self.depth,
                                           self.binary, False, self.label)), file=sys.stderr, flush=True)

    def key(self, data: bytes):
        if b'u' in data.lower():
            self.binary = not self.binary
        if b'?' in data:
            self.legend = not self.legend
        self.draw()


def rclone_progress_call(arguments: list[str], home: Path, depth: int, label: str = '') -> dict | None:
    executable = shutil.which('rclone')
    if executable is None:
        raise ConfigError('rclone is not available in PATH.')
    try:
        process = subprocess.Popen(
            [executable, '--ask-password=false', *arguments],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
            env=transport_env(),
        )
    except OSError as exc:
        raise TransferProblem(f'Could not start rclone: {exc}') from exc
    latest = None
    errors: list[str] = []
    try:
        assert process.stderr is not None
        pending = b''
        with ProgressDisplay(home, depth, label) as display:
            while True:
                watched = [process.stderr.fileno()]
                if display.interactive:
                    watched.append(sys.stdin.fileno())
                ready, _, _ = select.select(watched, [], [], 0.5)
                if display.interactive and sys.stdin.fileno() in ready:
                    display.key(os.read(sys.stdin.fileno(), 32))
                if process.stderr.fileno() not in ready:
                    continue
                chunk = os.read(process.stderr.fileno(), 65536)
                if not chunk:
                    break
                pending += chunk
                while b'\n' in pending:
                    raw, pending = pending.split(b'\n', 1)
                    line = raw.decode('utf-8', 'replace')
                    try:
                        event = json.loads(line)
                    except ValueError:
                        if line.strip():
                            errors.append(line.rstrip())
                            errors = errors[-5:]
                        continue
                    stats = event.get('stats') if isinstance(event, dict) else None
                    if isinstance(stats, dict):
                        latest = stats
                        display.update(stats)
                    elif isinstance(event, dict) and event.get('level') in ('error', 'fatal'):
                        message = str(event.get('msg', line.rstrip()))
                        errors.append(message)
                        errors = errors[-5:]
                        if not display.interactive:
                            print(message, file=sys.stderr, flush=True)
            code = process.wait()
    except KeyboardInterrupt as exc:
        if process.poll() is None:
            process.send_signal(signal.SIGINT)
        try:
            process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            process.terminate()
            process.communicate()
        raise TransferInterrupted(latest) from exc
    finally:
        if process.stderr is not None:
            process.stderr.close()
    if code:
        raise TransferProblem(f'rclone exited with code {code}: '
                              + ('; '.join(errors)[-1500:] if errors else 'see messages above.'), latest)
    return latest


def transfer_metrics(stats: dict | None, complete: bool) -> dict:
    fields = {'transferred_files': 'transfers', 'transferred_bytes': 'bytes',
              'checked_files': 'checks', 'listed_items': 'listed',
              'renamed_files': 'renames', 'server_side_moves': 'serverSideMoves',
              'server_side_move_bytes': 'serverSideMoveBytes'}
    if not isinstance(stats, dict) or any(type(stats.get(name)) is not int or stats[name] < 0
                                          for name in ('transfers', 'bytes', 'checks')):
        return {name: None for name in fields} | {'counts_complete': False}
    return {name: stats[key] if type(stats.get(key)) is int and stats[key] >= 0 else None
            for name, key in fields.items()} | {'counts_complete': complete}


def transport_env() -> dict[str, str]:
    # Ambient rclone filter/delete overrides must not change the selected scope.
    allowed = {"RCLONE_CONFIG", "RCLONE_CONFIG_PASS", "RCLONE_PASSWORD_COMMAND"}
    return {key: value for key, value in os.environ.items()
            if not key.startswith("RCLONE_") or key in allowed}


def rclone_call(*args: str, missing_ok: bool = False, allowed_codes: tuple = (0,)) -> str:
    executable = shutil.which("rclone")
    if executable is None:
        raise ConfigError("rclone is not available in PATH.")
    try:
        result = subprocess.run(
            [executable, "--ask-password=false", *args],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, env=transport_env(),
        )
    except OSError as exc:
        raise TransportError(f"Could not start rclone: {exc}") from exc
    if result.returncode not in allowed_codes:
        if missing_ok and result.returncode == 3:
            try:
                empty = (result.stdout.strip() in ("", "[", "[]")
                         or json.loads(result.stdout) == [])
            except ValueError:
                empty = False
            if empty and "directory not found" in result.stderr.lower():
                return "[]"
        detail = result.stderr.strip()[-3000:] if result.stderr else 'see rclone messages in the terminal.'
        raise TransportError(f"rclone exited with code {result.returncode}: " + detail)
    return result.stdout or ''


def load_targets(config: Path, target: str, require_enabled: bool = True) -> tuple[dict, int]:
    try:
        import tomllib
    except ImportError as exc:
        raise ConfigError("rclone operations require Python 3.11 or later.") from exc
    try:
        settings = tomllib.loads((config / "settings.toml").read_text())
    except (OSError, ValueError) as exc:
        raise ConfigError(f"Could not read settings.toml: {exc}") from exc
    if type(settings.get("schema_version")) is not int or settings.get("schema_version") != 1:
        raise ConfigError("settings.toml: schema_version must be 1.")
    limit = settings.get("max_delete", 25)
    if type(limit) is not int or not 0 <= limit <= 10000:
        raise ConfigError("max_delete must be an integer from 0 to 10000.")
    names = ("google", "proton") if target == "all" else (target,)
    configured = settings.get("targets", {})
    if not isinstance(configured, dict):
        raise ConfigError("settings.toml: targets must be a table.")
    chosen = {}
    for name in names:
        item = configured.get(name, {})
        if not isinstance(item, dict):
            raise ConfigError(f"settings.toml: targets.{name} must be a table.")
        if require_enabled and item.get("enabled") is not True:
            raise ConfigError(f"Target {name} is not enabled in settings.toml.")
        for area in ("plain", "private"):
            value = item.get(area)
            if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]+:[^\x00-\x1f\x7f]*", value):
                raise ConfigError(f"Target {name}/{area} is invalid.")
            tail = value.split(":", 1)[1]
            if ":" in tail or tail.startswith("/") or ".." in tail.split("/"):
                raise ConfigError(f"Target {name}/{area}: use a safe relative remote path.")
            if area == "plain" and not tail.rstrip("/").endswith("/plain"):
                raise ConfigError("The plain area must be dedicated and end with '/plain'.")
        chosen[name] = {area: item[area].rstrip("/") for area in ("plain", "private")}
    remotes = {item["name"]: item["type"] for item in json.loads(rclone_call("listremotes", "--json"))}
    for name, areas in chosen.items():
        for area, remote in areas.items():
            key = remote.split(":", 1)[0]
            if key not in remotes:
                raise ConfigError(f"Remote {key} is not configured. Complete rclone config first.")
            if area == "private" and remotes[key] != "crypt":
                raise ConfigError(f"{name}/private must use a crypt remote; transfer blocked.")
            if area == "plain":
                features = json.loads(rclone_call("backend", "features", key + ":"))
                if not features.get("Hashes"):
                    raise ConfigError(f"{name}/plain does not provide hashes for a reliable comparison; operation blocked.")
    return chosen, limit


def remote_join(root: str, relative: str) -> str:
    return root + ("" if root.endswith(":") else "/") + relative


def terminal_can_color(stream) -> bool:
    if not stream.isatty() or os.environ.get('PYTHON_COLORS') == '0':
        return False
    if os.environ.get('PYTHON_COLORS') == '1':
        return True
    if os.environ.get('NO_COLOR'):
        return False
    return bool(os.environ.get('FORCE_COLOR')) or os.environ.get('TERM') != 'dumb'


def terminal_style(value: str, code: str, stream) -> str:
    return f'\x1b[{code}m{value}\x1b[0m' if terminal_can_color(stream) else value


def ui(value: str, kind: str = 'info', stream=None) -> str:
    """Style only human-readable labels; structured output remains plain JSON."""
    # The shared WezTerm palette maps ANSI blue (34) to gray in both themes.
    remote_color = ('1;38;2;37;86;152' if os.environ.get('ZSH_THEME_MODE') == 'light'
                    else '1;38;2;139;181;236')
    colors = {'info': '1;36', 'success': '1;32', 'warning': '1;33',
              'error': '1;31', 'private': '1;35', 'muted': '2',
              'subtle': '2;90', 'remote': remote_color}
    return terminal_style(value, colors[kind], stream if stream is not None else sys.stdout)


def issue_line(label: str, message: str, kind: str) -> str:
    """Keep the warning prominent while muting the path it refers to."""
    path, separator, detail = message.partition(': ')
    if separator and path.startswith('/'):
        message = ui(path, 'muted') + separator + detail
    return (ui(label, kind) + ' ' + message).replace('\r', '\\r')


def print_selection_summary(counts: dict) -> None:
    """Use the same local selection summary for both check modes."""
    print()
    print(f"{ui('Plain:', 'info')} {counts['plain']}; "
          f"{ui('private:', 'private')} {counts['private']}; "
          f"{ui('skipped:', 'warning')} {counts['skipped']}; "
          f"{ui('selected size:', 'info')} "
          f"{progress_quantity(counts['selected_bytes'], False)}.")
    if counts['finder_icons']:
        print(f"Finder icons to preserve separately: {counts['finder_icons']}; "
              "resource fork bytes are not included in the estimate.")


class MountPulse:
    """An activity bar, or a file-count bar when the caller knows the total."""

    def __init__(self, label: str, total: int | None = None, show_count: bool | str = False):
        self.label = label
        self.started = time.monotonic()
        self.interactive = sys.stderr.isatty()
        self.total = total
        self.show_count = show_count
        self.completed = 0
        self.matches = None
        self.count_verb = None
        self.byte_fd = None
        self.byte_total = None
        self.report_path = None
        self.report_offset = 0
        self.report_expected = None
        self.report_seen = set()
        self.report_pending = b''
        if not self.interactive:
            print(f'{label}: in progress...', file=sys.stderr, flush=True)

    def refresh_report(self) -> None:
        report_path = self.report_path
        if report_path is not None:
            try:
                with report_path.open('rb') as stream:
                    stream.seek(self.report_offset)
                    new_data = stream.read()
                    self.report_offset = stream.tell()
                if self.report_expected is None:
                    self.completed += new_data.count(b'\n')
                else:
                    lines = (self.report_pending + new_data).split(b'\n')
                    self.report_pending = lines.pop()
                    for line in lines:
                        if len(line) >= 3 and line[1:2] == b' ':
                            name = line[2:].decode('utf-8', errors='replace')
                            if name in self.report_expected:
                                self.report_seen.add(name)
                    self.completed = len(self.report_seen)
            except FileNotFoundError:
                pass

    def count_detail(self) -> str:
        detail = ''
        if self.total is not None:
            verb = {'removed': 'Removed', 'archived': 'Archived',
                    'processed': 'Processed'}.get(self.count_verb, 'Checked')
            count = f'{localized(verb)} {self.completed}/{self.total}'
            detail += '  ' + terminal_style(count, '2;90', sys.stderr)
        elif self.show_count:
            if self.show_count == 'entries':
                count = f'{localized("Entries read")} {self.completed}'
            else:
                count = f'{localized("Paths checked")} {self.completed}'
            detail += '  ' + terminal_style(count, '2;90', sys.stderr)
        if self.matches is not None:
            matches = f'{localized("Matches")} {self.matches}'
            detail += '  ' + terminal_style(matches, '2;90', sys.stderr)
        if self.byte_fd is not None and self.byte_total is not None:
            received = os.fstat(self.byte_fd).st_size
            label = localized('Received')
            detail += ('  ' + terminal_style(label, '2;90', sys.stderr) + ' '
                       + progress_quantity(received, False) + ' / '
                       + progress_quantity(self.byte_total, False))
        return detail

    def draw(self, metadata_bytes: int | None = None) -> None:
        if not self.interactive:
            return
        self.refresh_report()
        width, block = 22, 5
        if self.byte_fd is not None and self.byte_total is not None:
            received = os.fstat(self.byte_fd).st_size
            filled = width * min(received, self.byte_total) // max(self.byte_total, 1)
            bar = '#' * filled + '.' * (width - filled)
        elif self.total is None:
            offset = int((time.monotonic() - self.started) * 5) % (width + block)
            bar = ''.join('#' if (index - offset) % (width + block) < block else '.'
                          for index in range(width))
        else:
            filled = width * min(self.completed, self.total) // max(self.total, 1)
            bar = '#' * filled + '.' * (width - filled)
        elapsed = progress_duration(time.monotonic() - self.started)
        detail = (f'  metadata {metadata_bytes / 1048576:.1f} MiB'
                  if metadata_bytes is not None else '')
        detail += self.count_detail()
        title = terminal_style(self.label, '1;36', sys.stderr)
        progress = terminal_style(f'[{bar}]', '34', sys.stderr)
        sys.stderr.write(localized(f'\r\x1b[2K{title} {progress} {elapsed}{detail}'))
        sys.stderr.flush()

    def done(self, detail: str) -> None:
        self.refresh_report()
        if self.interactive:
            sys.stderr.write('\r\x1b[2K')
        elapsed = progress_duration(time.monotonic() - self.started)
        color = '31' if detail == 'error' else '33' if detail == 'interrupted' else '32'
        status = terminal_style(localized(detail), color, sys.stderr)
        title = terminal_style(self.label, '1;36', sys.stderr)
        counts = self.count_detail() if detail in ('complete', 'interrupted', 'error') else ''
        print(f'{title}: {status} ({elapsed}).{counts}', file=sys.stderr, flush=True)


def mount_input_wait(input_fd: int | None, timeout: float) -> None:
    """Wait for the next mount check while discarding typed characters."""
    if input_fd is None:
        time.sleep(timeout)
    elif select.select([input_fd], [], [], timeout)[0]:
        os.read(input_fd, 4096)


@contextmanager
def operation_activity(label: str, total: int | None = None,
                       report_non_tty: bool = False, show_count: bool = False):
    """Show a TTY progress bar and discard input during a long phase."""
    if not sys.stderr.isatty():
        if not report_non_tty:
            yield None
            return
        pulse = MountPulse(label, total, show_count)
        outcome = 'complete'
        try:
            yield pulse
        except KeyboardInterrupt:
            outcome = 'interrupted'
            raise
        except BaseException:
            outcome = 'error'
            raise
        finally:
            pulse.done(getattr(pulse, 'outcome', outcome))
        return
    with discard_mount_input() as input_fd:
        pulse = MountPulse(label, total, show_count)
        stopped = threading.Event()

        def animate() -> None:
            while not stopped.is_set():
                pulse.draw()
                if input_fd is None:
                    stopped.wait(0.2)
                else:
                    mount_input_wait(input_fd, 0.2)

        worker = threading.Thread(target=animate, name='macbackup-progress', daemon=True)
        worker.start()
        outcome = 'complete'
        try:
            yield pulse
        except KeyboardInterrupt:
            outcome = 'interrupted'
            raise
        except BaseException:
            outcome = 'error'
            raise
        finally:
            stopped.set()
            worker.join()
            pulse.done(getattr(pulse, 'outcome', outcome))


class JsonArrayObjectCounter:
    """Count complete top-level objects in a streamed JSON array."""

    def __init__(self):
        self.count = 0
        self.array_depth = 0
        self.object_depth = 0
        self.in_string = False
        self.escaped = False

    def feed(self, chunk: bytes) -> None:
        for byte in chunk:
            if self.in_string:
                if self.escaped:
                    self.escaped = False
                elif byte == 92:  # backslash
                    self.escaped = True
                elif byte == 34:  # quote
                    self.in_string = False
                continue
            if byte == 34:
                self.in_string = True
            elif byte == 91:
                self.array_depth += 1
            elif byte == 93:
                self.array_depth -= 1
            elif byte == 123:
                self.object_depth += 1
            elif byte == 125:
                self.object_depth -= 1
                if self.array_depth == 1 and self.object_depth == 0:
                    self.count += 1


def mount_inventory(root: str, label: str, input_fd: int | None = None,
                    live_count: bool = False, options: tuple[str, ...] = ('--recursive', '--links'),
                    activity: MountPulse | None = None) -> list[dict]:
    executable = shutil.which('rclone')
    if executable is None:
        raise ConfigError('rclone is not available in PATH.')
    own_pulse = activity is None
    pulse = activity or MountPulse(f'Inventory {label}', show_count='entries' if live_count else False)
    starting_count = pulse.completed
    if activity is not None:
        pulse.label = f'Inventory {label}'
        pulse.total = None
        pulse.show_count = 'entries'
    counter = JsonArrayObjectCounter() if live_count or activity is not None else None
    offset = 0
    with tempfile.TemporaryFile(mode='w+t', encoding='utf-8') as output, \
            tempfile.TemporaryFile(mode='w+t', encoding='utf-8') as errors:
        try:
            process = subprocess.Popen(
                [executable, '--ask-password=false', 'lsjson', root, *options],
                stdout=output, stderr=errors, env=transport_env(),
                start_new_session=True)
        except OSError as exc:
            if own_pulse:
                pulse.done('error')
            raise TransportError(f'Could not start rclone: {exc}') from exc
        try:
            while process.poll() is None:
                size = os.fstat(output.fileno()).st_size
                if counter is not None and size > offset:
                    counter.feed(os.pread(output.fileno(), size - offset, offset))
                    offset = size
                    pulse.completed = starting_count + counter.count
                if own_pulse:
                    pulse.draw(size)
                    mount_input_wait(input_fd, 0.2)
                else:
                    try:
                        process.wait(timeout=0.2)
                    except subprocess.TimeoutExpired:
                        pass
            code = process.wait()
        except KeyboardInterrupt as exc:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
            if own_pulse:
                pulse.done('interrupted')
            if live_count or not own_pulse:
                raise
            raise ConfigError('Mount interrupted by user.') from exc
        output.seek(0)
        errors.seek(0)
        raw, detail = output.read(), errors.read()
        try:
            empty = raw.strip() in ('', '[', '[]') or json.loads(raw) == []
        except ValueError:
            empty = False
        if code == 3 and empty and 'directory not found' in detail.lower():
            raw = '[]'
        elif code != 0:
            if own_pulse:
                pulse.done('error')
            raise TransportError(f'Inventory {label}: rclone exited with code {code}: '
                                 + detail.strip()[-1200:])
    try:
        items = json.loads(raw)
    except ValueError as exc:
        if own_pulse:
            pulse.done('error')
        raise TransportError(f'Inventory {label}: invalid JSON response.') from exc
    if not isinstance(items, list):
        if own_pulse:
            pulse.done('error')
        raise TransportError(f'Inventory {label}: unexpected format.')
    pulse.completed = starting_count + len(items)
    if own_pulse:
        pulse.done(f'{len(items)} entries read')
    return items


def mount_current_conflicts(roots: dict[str, str], target: str = '',
                            input_fd: int | None = None) -> None:
    """Refuse a merged view if an object could mask one from the other area."""
    inventories = []
    for area in ('plain', 'private'):
        objects = {}
        for item in mount_inventory(remote_join(roots[area], 'current'),
                                    f'{target}/{area}' if target else area, input_fd,
                                    live_count=True):
            path = item.get('Path')
            if (not isinstance(path, str) or not path or path.startswith('/')
                    or any(part in ('', '.', '..') for part in path.split('/'))):
                raise TransportError('The cloud returned an invalid path; mount blocked.')
            try:
                absolute_path('/' + path)
            except ConfigError as exc:
                raise TransportError('The cloud returned an invalid path; mount blocked.') from exc
            if path in objects:
                raise TransportError('Cloud contains duplicate paths; mount blocked.')
            if type(item.get('IsDir')) is not bool:
                raise TransportError('Cloud returned an invalid path type; mount blocked.')
            objects[path] = item['IsDir']
        inventories.append(objects)
    plain, private = inventories
    conflicts = current_conflict_paths(plain, private)
    if conflicts:
        examples = ', '.join('/' + path for path in conflicts[:5])
        remaining = f' (and {len(conflicts) - 5} more)' if len(conflicts) > 5 else ''
        raise ConfigError(
            f'current contains {len(conflicts)} paths conflicting between plain and private: '
            f'{examples}{remaining}. The combined volume was not mounted; '
            'browse the areas with --area plain and --area private.')


def mount_merged_env(roots: dict[str, str]) -> tuple[str, dict[str, str]]:
    suffix = uuid.uuid4().hex[:12]
    names = {part: f'macbackup_mount_{suffix}_{part}'
             for part in ('current', 'history', 'icons', 'view')}
    prefix = lambda part: 'RCLONE_CONFIG_' + names[part].upper() + '_'
    env = {
        prefix('current') + 'TYPE': 'union',
        prefix('current') + 'UPSTREAMS': ' '.join(
            json.dumps(remote_join(roots[area], 'current') + ':ro')
            for area in ('private', 'plain')),
        prefix('current') + 'SEARCH_POLICY': 'epall',
        prefix('history') + 'TYPE': 'combine',
        prefix('history') + 'UPSTREAMS': ' '.join(
            json.dumps(f'{area}={remote_join(roots[area], "history")}')
            for area in ('plain', 'private')),
        prefix('icons') + 'TYPE': 'combine',
        prefix('icons') + 'UPSTREAMS': ' '.join(
            json.dumps(f'{area}={remote_join(roots[area], "macos-icons")}')
            for area in ('plain', 'private')),
        prefix('view') + 'TYPE': 'combine',
        prefix('view') + 'UPSTREAMS': ' '.join(
            f'{part}={names[part]}:' for part in ('current', 'history', 'icons')),
    }
    return names['view'] + ':', env


@contextmanager
def discard_mount_input():
    """Hide and discard terminal input while a foreground mount is active."""
    if not sys.stdin.isatty():
        yield None
        return
    fd = sys.stdin.fileno()
    original = termios.tcgetattr(fd)
    active = termios.tcgetattr(fd)
    active[3] &= ~(termios.ECHO | termios.ICANON)
    active[0] &= ~termios.IXON
    active[6][termios.VMIN] = 1
    active[6][termios.VTIME] = 0
    disabled = os.fpathconf(fd, 'PC_VDISABLE')
    for name in ('VQUIT', 'VSUSP', 'VDSUSP'):
        index = getattr(termios, name, None)
        if index is not None:
            active[6][index] = bytes((disabled,))
    try:
        termios.tcsetattr(fd, termios.TCSANOW, active)
        termios.tcflush(fd, termios.TCIFLUSH)
        yield fd
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, original)
        termios.tcflush(fd, termios.TCIFLUSH)


def mount_operation(args, config: Path, home: Path) -> int:
    with discard_mount_input() as input_fd:
        return _mount_operation(args, config, home, input_fd)


def _mount_operation(args, config: Path, home: Path, input_fd: int | None) -> int:
    if sys.platform != 'darwin':
        raise ConfigError('macbackup mounting requires macOS.')
    executable = shutil.which('rclone')
    if executable is None:
        raise ConfigError('rclone is not available in PATH.')
    state = home / '.local/state/macbackup'
    processes = []
    created_points = []
    mounted_points = set()
    interrupted = False
    try:
        with operation_lock(state):
            targets, _ = load_targets(config, args.target)
            policy = Policy(config, home)
            base = absolute_path(args.mountpoint) if args.mountpoint else home / 'Desktop'
            if args.area == 'all':
                mounts = []
                for name, roots in targets.items():
                    mount_current_conflicts(roots, name, input_fd)
                    view, env = mount_merged_env(roots)
                    mounts.append((name, 'all', view, base / name, env))
            else:
                mounts = [(name, args.area, roots[args.area], base / f'{name}-{args.area}', {})
                          for name, roots in targets.items()]
            for _, _, _, point, _ in mounts:
                if point not in policy.mount_roots and any(
                        inside(point, rule.path) or inside(rule.path, point) for rule in policy.roots):
                    raise ConfigError(f'{point}: the mount overlaps a backup source.')
                ancestors_below_home = []
                for ancestor in (point, *point.parents):
                    if ancestor == home:
                        break
                    ancestors_below_home.append(ancestor)
                if any(ancestor.is_symlink() for ancestor in ancestors_below_home):
                    raise ConfigError(f'{point}: the mount path crosses a symlink.')
                if os.path.ismount(point):
                    raise ConfigError(f'{point}: already mounted.')
                if point.exists() and (not point.is_dir() or any(point.iterdir())):
                    raise ConfigError(f'{point}: an empty directory is required.')
            for name, area, remote, point, extra_env in mounts:
                created = not point.exists()
                if created:
                    point.mkdir(parents=True, mode=0o700)
                if created:
                    info = point.stat()
                    created_points.append((point, info.st_dev, info.st_ino))
                log = state / f'mount-{name}-{area}.log'
                fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, 'w') as output:
                    process = subprocess.Popen(
                        [executable, '--ask-password=false', 'nfsmount', remote, str(point), '--read-only',
                         '--vfs-cache-mode', 'off', '--addr', '127.0.0.1:0'],
                        stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                        start_new_session=True, env=transport_env() | extra_env)
                processes.append((process, point, log))
                deadline = time.monotonic() + 30
                pulse = MountPulse(f'Starting {name}/{area}')
                try:
                    while not os.path.ismount(point):
                        code = process.poll()
                        if code is not None:
                            detail = log.read_text(errors='replace')[-1200:]
                            if code == 0 and 'Unmounted rclone mount' in detail:
                                pulse.done('unmounted')
                                print(f'{terminal_style("Volume unmounted:", "1;32", sys.stdout)} '
                                      f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
                                return 0
                        if code is not None or time.monotonic() >= deadline:
                            pulse.done('error')
                            detail = log.read_text(errors='replace')[-1200:]
                            raise TransportError(f'Mount {name}/{area} failed: {detail or "no response from rclone."}')
                        pulse.draw()
                        mount_input_wait(input_fd, 0.2)
                except KeyboardInterrupt:
                    pulse.done('interrupted')
                    raise
                pulse.done('complete')
                mounted_points.add(point)
                print(f'{terminal_style(f"Mounted {name}/{area} read-only at:", "1;32", sys.stdout)} '
                      f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
        # The mounted read-only volume stays open, but no longer holds the operation lock.
        print(terminal_style('Keep this terminal open; press Ctrl-C or eject the volume in Finder (⌘E).',
                             '2', sys.stdout), flush=True)
        while True:
            for process, point, log in processes:
                code = process.poll()
                if code is not None:
                    if code == 0:
                        deadline = time.monotonic() + 3
                        while os.path.ismount(point) and time.monotonic() < deadline:
                            mount_input_wait(input_fd, 0.1)
                        if not os.path.ismount(point):
                            print(f'{terminal_style("Volume unmounted:", "1;32", sys.stdout)} '
                                  f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
                            return 0
                    detail = log.read_text(errors='replace')[-1200:]
                    raise TransportError(f'Mount exited with code {code}: {point}. {detail}')
            mount_input_wait(input_fd, 1)
    except KeyboardInterrupt:
        interrupted = True
        print('\nUnmounting...', flush=True)
    finally:
        for process, _, _ in reversed(processes):
            if process.poll() is None:
                process.terminate()
        for process, point, _ in reversed(processes):
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                print(f'{terminal_style("WARNING:", "1;33", sys.stderr)} '
                      f'{point} did not unmount; check with mount.', file=sys.stderr)
        for point, device, inode in reversed(created_points):
            try:
                info = point.lstat()
                if (not os.path.ismount(point) and stat.S_ISDIR(info.st_mode)
                        and (info.st_dev, info.st_ino) == (device, inode)):
                    point.rmdir()
            except (FileNotFoundError, OSError):
                # An active mount, changed directory or nonempty folder is left intact.
                pass
        if interrupted:
            for _, point, _ in processes:
                if point in mounted_points and not os.path.ismount(point):
                    print(f'{terminal_style("Volume unmounted:", "1;32", sys.stdout)} '
                          f'{terminal_style(str(point), "36", sys.stdout)}', flush=True)
    return 0


def remote_current_objects(root: str, inventory_label: str | None = None) -> dict[str, bool]:
    """Read current once, keeping directories for cross-area collision checks."""
    items = (mount_inventory(root, inventory_label, live_count=True)
             if inventory_label is not None else
             json.loads(rclone_call("lsjson", root, "--recursive", "--links", missing_ok=True)))
    objects = {}
    for item in items:
        path = item.get("Path")
        if not isinstance(path, str) or not path or path.startswith("/") or any(part in ("", ".", "..") for part in path.split("/")):
            raise TransportError("The cloud returned an invalid path; operation blocked.")
        absolute_path("/" + path)
        if path in objects:
            raise TransportError("The cloud contains duplicate paths; resolve them before backup.")
        if type(item.get('IsDir')) is not bool:
            raise TransportError("The cloud returned an invalid path type; operation blocked.")
        objects[path] = item['IsDir']
    return objects


def current_conflict_paths(plain: dict[str, bool], private: dict[str, bool]) -> list[str]:
    """Directories may overlap; any shared path involving a file may not."""
    return sorted(path for path in plain.keys() & private.keys()
                  if not plain[path] or not private[path])


@contextmanager
def operation_lock(state: Path):
    if state.is_symlink():
        raise ConfigError("The state directory cannot be a symlink.")
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(state, 0o700)
    fd = os.open(state / "operation.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ConfigError("Another macbackup operation is already running.") from exc
        yield
    finally:
        os.close(fd)


def selected_names(scan: Scan, area: str) -> set[str]:
    return {entry.path.lstrip("/") + (".rclonelink" if entry.kind == "symlink" else "")
            for entry in scan.entries if entry.decision.action == area and entry.kind != 'finder-icon'}


def transfer_plan(policy: Policy, scan: Scan, targets: dict, limit: int,
                  enforce_limit: bool = True,
                  show_inventory: bool = False) -> list[dict]:
    if scan.errors:
        raise ConfigError("The local selection has errors. Run macbackup check.")
    plans = []
    any_existing = False
    for target, areas in targets.items():
        first_plan = len(plans)
        current_objects = {}
        for area, root in areas.items():
            local = selected_names(scan, area)
            managed = set()
            policy_archives = []
            objects = remote_current_objects(
                remote_join(root, "current"),
                f'{target}/{area}/current' if show_inventory else None)
            current_objects[area] = objects
            existing = sorted(path for path, is_dir in objects.items() if not is_dir)
            any_existing = any_existing or bool(existing)
            if policy.gitignore is not None:
                policy.gitignore.preload([
                    absolute_path('/' + (name[:-len('.rclonelink')]
                                         if name.endswith('.rclonelink') else name))
                    for name in existing
                ])
            for name in existing:
                logical = name[:-len(".rclonelink")] if name.endswith(".rclonelink") else name
                decision = policy.decide(absolute_path("/" + logical))
                if decision.action == "error":
                    raise ConfigError(decision.reason)
                if decision.action == area:
                    managed.add(name)
                else:
                    policy_archives.append({
                        'path': '/' + logical, 'relative': name,
                        'remote_path': remote_join(root, 'current/' + name),
                        'reason': decision.reason, 'rule': decision.rule,
                        'current_area': area, 'new_action': decision.action,
                    })
            deletions = managed - local
            file_plan = {"target": target, "area": area, "root": root,
                         "files": sorted(local | managed), "selected": len(local),
                         "local": sorted(local), "existing": existing,
                         "deletions": sorted(deletions),
                         "archive_deleted": len(deletions),
                         "policy_archives": policy_archives,
                         "archive_policy": len(policy_archives)}
            plans.append(file_plan)
            icons = [entry for entry in scan.entries if entry.kind == 'finder-icon' and entry.decision.action == area]
            icon_local = {str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR for entry in icons}
            icon_root = remote_join(root, 'macos-icons')
            icon_existing = sorted(path for path, is_dir in
                                   remote_current_objects(
                                       remote_join(icon_root, 'current'),
                                       f'{target}/{area}/macos-icons/current' if show_inventory else None
                                   ).items() if not is_dir)
            any_existing = any_existing or bool(icon_existing)
            icon_managed = set()
            icon_policy_archives = []
            for name in icon_existing:
                if not name.endswith(ICON_SIDECAR):
                    raise TransportError("Unexpected path in the area reserved for icons.")
                parent = absolute_path('/' + name[:-len(ICON_SIDECAR)])
                decision = policy.decide(parent / FINDER_ICON)
                if decision.action == 'error':
                    raise ConfigError(decision.reason)
                if decision.action == area:
                    icon_managed.add(name)
                else:
                    icon_policy_archives.append({
                        'path': str(parent / FINDER_ICON),
                        'relative': name,
                        'remote_path': remote_join(icon_root, 'current/' + name),
                        'reason': decision.reason, 'rule': decision.rule,
                        'current_area': area, 'new_action': decision.action,
                    })
            icon_deleted = icon_managed - icon_local
            total_archives = (len(deletions) + len(policy_archives) +
                              len(icon_deleted) + len(icon_policy_archives))
            exceeded = total_archives > limit
            file_plan['archive_limit_exceeded'] = exceeded
            if exceeded and enforce_limit:
                raise ConfigError(f"{target}/{area}: {total_archives} archives across files and icons "
                                  f"exceed max_delete={limit}; no transfers started.")
            if icons or icon_existing:
                plans.append({'target': target, 'area': area, 'root': icon_root, 'kind': 'macos-icons',
                              'icons': icons, 'files': sorted(icon_local | icon_managed),
                              'local': sorted(icon_local), 'existing': icon_existing,
                              'selected': len(icon_local), 'deletions': sorted(icon_deleted),
                              'archive_deleted': len(icon_deleted),
                              'policy_archives': icon_policy_archives,
                              'archive_policy': len(icon_policy_archives),
                              'archive_limit_exceeded': exceeded})
        recoverable = []
        unsafe = []
        for path in current_conflict_paths(current_objects['plain'], current_objects['private']):
            archivers = [(plan, item) for plan in plans[first_plan:]
                         if plan.get('kind', 'files') == 'files'
                         for item in plan['policy_archives']
                         if item['relative'] == path and current_objects[plan['area']].get(path) is False]
            if not archivers:
                unsafe.append(path)
                continue
            for _, item in archivers:
                item['pre_archive'] = True
            recoverable.append({'target': target, 'path': '/' + path,
                                'archive_from': sorted({plan['area'] for plan, _ in archivers})})
        if unsafe:
            examples = ', '.join('/' + path for path in unsafe[:5])
            remaining = f' (and {len(unsafe) - 5} more)' if len(unsafe) > 5 else ''
            raise ConfigError(f'{target}/current: {len(unsafe)} conflicts without a safe repair: '
                              f'{examples}{remaining}. No transfer started.')
        if recoverable:
            plans[first_plan]['cross_area_conflicts'] = recoverable
    if not policy.roots and not any_existing:
        raise ConfigError("No source selected and no current copy to archive: rclone operation blocked.")
    return plans


def write_manifest(directory: Path, names: list[str]) -> Path:
    path = directory / "files.list0"
    with path.open("xb") as stream:
        os.chmod(path, 0o600)
        for name in names:
            stream.write(name.encode("utf-8") + b"\0")
    return path


def private_changes(plan: dict, state: Path, pulse: MountPulse | None = None) -> list[str]:
    local = set(plan["local"])
    existing = set(plan["existing"])
    to_check = local & existing
    changed = local - existing
    if to_check:
        with tempfile.TemporaryDirectory(prefix="cryptcheck-", dir=state) as directory:
            directory = Path(directory)
            manifest = write_manifest(directory, sorted(to_check))
            report = directory / "report"
            report.touch(mode=0o600)
            if pulse is not None:
                pulse.report_path = report
            rclone_call(
                "cryptcheck", plan.get('source', '/'), remote_join(plan["root"], "current"),
                "--files-from0", str(manifest), "--links", "--one-way",
                "--combined", str(report), "--log-level", "ERROR",
                allowed_codes=(0, 1),
            )
            checked = set()
            for line in report.read_text().splitlines():
                if len(line) < 3 or line[1] != " " or line[0] not in "=*+":
                    raise TransportError("Encrypted check incomplete or failed; private area not updated.")
                name = line[2:]
                if name not in to_check or name in checked:
                    raise TransportError("Inconsistent encrypted check; operation blocked.")
                checked.add(name)
                if line[0] != "=":
                    changed.add(name)
            if checked != to_check:
                raise TransportError("Not all private files were checked; operation blocked.")
            if pulse is not None:
                pulse.report_path = None
                pulse.completed = len(checked)
    return sorted(changed | set(plan["deletions"]))


def perform_sync(plan: dict, state: Path, run_id: str, limit: int, dry_run: bool,
                 home: Path | None = None, progress_depth: int = 2) -> dict | None:
    if plan.get('kind') == 'macos-icons' and 'source' not in plan:
        with tempfile.TemporaryDirectory(prefix='icons-', dir=state) as directory:
            source = Path(directory)
            for entry in plan['icons']:
                relative = str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR
                file = source / relative
                file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                with file.open('x') as stream:
                    os.chmod(file, 0o600)
                    json.dump(icon_snapshot(entry), stream, sort_keys=True, ensure_ascii=False, indent=2)
            return perform_sync(plan | {'source': str(source)}, state, run_id, limit,
                                dry_run, home, progress_depth)
    if plan["area"] == "private":
        comparison = f'Comparing private {plan["target"]}/{plan["area"]}/{plan.get("kind", "files")}'
        total = len(set(plan['local']) & set(plan['existing']))
        if total:
            with operation_activity(comparison, total, report_non_tty=True) as pulse:
                names = private_changes(plan, state, pulse)
        else:
            names = private_changes(plan, state)
    else:
        names = plan["files"]
    if not names:
        return {'transfers': 0, 'bytes': 0, 'checks': 0, 'listed': 0,
                'renames': 0, 'serverSideMoves': 0, 'serverSideMoveBytes': 0} if not dry_run else None
    with tempfile.TemporaryDirectory(prefix="manifest-", dir=state) as directory:
        manifest = write_manifest(Path(directory), names)
        arguments = [
            "sync", plan.get('source', '/'), remote_join(plan["root"], "current"),
            "--files-from0", str(manifest), "--links", "--copy-links=false",
            "--backup-dir", remote_join(plan["root"], "history/" + run_id),
            "--delete-excluded=false", "--max-delete", str(max(limit, len(plan['deletions'])) if dry_run else limit),
            "--log-level", "ERROR" if dry_run else "NOTICE", "--retries", "1",
        ]
        arguments.append("--ignore-times" if plan["area"] == "private" else "--checksum")
        if dry_run:
            arguments.append("--dry-run")
            label = f'Preview {plan["target"]}/{plan["area"]}/{plan.get("kind", "files")}'
            report = Path(directory) / 'combined.txt'
            report.touch(mode=0o600)
            arguments.extend(('--combined', str(report)))
            with operation_activity(label, len(names), report_non_tty=True) as pulse:
                if pulse is not None:
                    pulse.count_verb = 'processed'
                    pulse.report_path = report
                    pulse.report_expected = set(names)
                rclone_call(*arguments)
            return None
        arguments.extend(("--stats", "5s", "--stats-file-name-length", "0",
                          "--stats-log-level", "NOTICE", "--use-json-log"))
        return rclone_progress_call(arguments, home or Path.home(), progress_depth,
                                   f"{plan['target']}/{plan['area']}/{plan.get('kind', 'files')}")


def archive_policy_copies(plan: dict, run_id: str, completed: list[dict],
                          activity: MountPulse | None = None,
                          on_complete=None) -> None:
    """Move policy-revoked current copies into the same area's run history."""
    for item in plan['policy_archives']:
        destination = remote_join(plan['root'], 'history/' + run_id + '/' + item['relative'])
        rclone_call('moveto', item['remote_path'], destination, '--retries', '1')
        completed.append({key: value for key, value in item.items() if key != 'relative'} |
                         {'history_path': destination})
        if activity is not None:
            activity.completed += 1
        if on_complete is not None:
            on_complete()


def archive_deleted_paths(plan: dict) -> list[str]:
    """Return original Mac paths, not rclone link or Finder icon sidecar names."""
    if plan.get('kind') == 'macos-icons':
        return [str(Path('/' + name[:-len(ICON_SIDECAR)]) / FINDER_ICON)
                for name in plan['deletions']]
    return ['/' + (name[:-len('.rclonelink')] if name.endswith('.rclonelink') else name)
            for name in plan['deletions']]


def completed_deleted_archive_paths(plan: dict, run_id: str) -> list[str] | None:
    """Confirm interrupted sync moves from this run's history, or return unknown."""
    if not plan['deletions']:
        return []
    try:
        label = f"Checking history {plan['target']}/{plan['area']}/{plan.get('kind', 'files')}"
        with operation_activity(label, report_non_tty=True):
            history = remote_current_objects(remote_join(plan['root'], 'history/' + run_id))
    except (ConfigError, TransportError, OSError, ValueError, KeyboardInterrupt):
        return None
    completed = [name for name in plan['deletions'] if history.get(name) is False]
    return archive_deleted_paths(plan | {'deletions': completed})


def transport_operation(args, policy: Policy) -> int:
    if getattr(args, 'progress_depth', 2) not in range(1, 6):
        raise ConfigError('--progress-depth must be an integer from 1 to 5.')
    targets, limit = load_targets(policy.config_dir, args.target)
    with operation_lock(policy.state_dir):
        run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ-") + uuid.uuid4().hex[:12]
        results = []
        if args.command == 'run':
            data = {'operation': 'run', 'run_id': run_id, 'ok': False,
                    'complete': False, 'interrupted': False, 'active_phase': 'local-scan',
                    'started_at': datetime.now(timezone.utc).isoformat(),
                    'results': results, 'note': 'Results separated by target and area.'}
            save_local_report(policy.state_dir, 'last-run.json', data)
        try:
            with operation_activity('Local scan', show_count=True) as pulse:
                scan = scan_policy(policy, pulse)
            if args.command == 'run':
                data['active_phase'] = 'planning'
                save_local_report(policy.state_dir, 'last-run.json', data)
            if args.command == 'check':
                plans = transfer_plan(policy, scan, targets, limit,
                                      enforce_limit=False,
                                      show_inventory=True)
            else:
                plans = transfer_plan(policy, scan, targets, limit,
                                      enforce_limit=args.command == 'run',
                                      show_inventory=True)
        except (KeyboardInterrupt, ConfigError, TransportError, OSError) as exc:
            if args.command == 'run':
                data.update(interrupted=isinstance(exc, KeyboardInterrupt),
                            error=("Interrupted by user." if isinstance(exc, KeyboardInterrupt)
                                   else str(exc)))
                save_local_report(policy.state_dir, 'last-run.json', data)
            raise
        conflicts = [conflict for plan in plans for conflict in plan.get('cross_area_conflicts', [])]
        if args.command == "check":
            warnings = scan.warnings + [
                f"{item['target']}/current: {item['path']}: repairable conflict; "
                f"the copy {', '.join(item['archive_from'])} must be archived before transfers. "
                "Use preview to check max_delete."
                for item in conflicts]
            result = {"scope": "remote-read-only", "ok": True,
                      "note": "Remote access and types checked; inventories read without changing the cloud.",
                      "summary": scan.summary(), "warnings": warnings, "conflicts": conflicts}
            if getattr(args, "json", False):
                print(json.dumps(result, ensure_ascii=False))
            else:
                print(ui('Remote check complete.', 'success') + ' ' + result['note'])
                for warning in warnings:
                    print(issue_line('WARNING:', warning, 'warning'))
                print_selection_summary(result['summary'])
            return 0
        for plan in plans:
            result = {key: plan[key] for key in ("target", "area", "selected", "archive_deleted", "archive_policy")}
            result['archive_limit_exceeded'] = plan['archive_limit_exceeded']
            result['kind'] = plan.get('kind', 'files')
            result['policy_archives'] = [
                {key: value for key, value in item.items() if key != 'relative'}
                for item in plan['policy_archives']
            ]
            result['archive_deleted_paths'] = archive_deleted_paths(plan)
            if args.command == 'run':
                result['archive_deleted_completed_paths'] = ([] if not plan['deletions'] else None)
                result['policy_archived'] = []
                result['ok'] = False
            results.append(result)
        if args.command == 'run':
            data['conflicts'] = conflicts
            save_local_report(policy.state_dir, 'last-run.json', data)
        prearchive_failed = False
        if args.command == 'run':
            # A reclassification must leave the old area's current before the new
            # area's sync can publish the same logical path.
            for plan, result in zip(plans, results):
                transitions = [item for item in plan['policy_archives']
                               if item['new_action'] in ('plain', 'private') or item.get('pre_archive')]
                if not transitions:
                    continue
                data['active_phase'] = f"{plan['target']}/{plan['area']}/{result['kind']}:archive-transition"
                result['in_progress'] = True
                save_local_report(policy.state_dir, 'last-run.json', data)
                try:
                    with operation_activity(
                            f'Archiving before transfer {plan["target"]}/{plan["area"]}',
                            len(transitions)) as activity:
                        if activity is not None:
                            activity.count_verb = 'archived'
                        archive_policy_copies(
                            plan | {'policy_archives': transitions}, run_id,
                            result['policy_archived'], activity,
                            lambda: save_local_report(policy.state_dir, 'last-run.json', data))
                except (KeyboardInterrupt, ConfigError, TransportError, OSError) as exc:
                    result['error'] = ("Interrupted by user during archiving."
                                       if isinstance(exc, KeyboardInterrupt) else str(exc))
                    result['policy_archive_completion_uncertain'] = True
                    data['interrupted'] = isinstance(exc, KeyboardInterrupt)
                    prearchive_failed = True
                finally:
                    result.pop('in_progress', None)
                    save_local_report(policy.state_dir, 'last-run.json', data)
                if prearchive_failed:
                    break
        attempted = 0
        for plan, result in zip(plans, results):
            if prearchive_failed:
                break
            attempted += 1
            if args.command == 'run':
                result['in_progress'] = True
                data['active_phase'] = f"{plan['target']}/{plan['area']}/{result['kind']}"
                save_local_report(policy.state_dir, 'last-run.json', data)
            if args.command == 'run':
                print(f"{ui('Starting', 'info', sys.stderr)} {plan['target']}/{plan['area']}/{result['kind']}: "
                      f"{plan['selected']} items selected.", file=sys.stderr, flush=True)
            if args.command == 'preview' and not args.simulate:
                result['ok'] = True
                continue
            try:
                stats = perform_sync(plan, policy.state_dir, run_id, limit,
                                     args.command == "preview", policy.home,
                                     getattr(args, 'progress_depth', 2))
                if args.command == 'run':
                    result.update(transfer_metrics(stats, True))
                    result['archive_deleted_completed_paths'] = result['archive_deleted_paths'][:]
                    remaining_archives = [item for item in plan['policy_archives']
                                          if item['new_action'] not in ('plain', 'private')
                                          and not item.get('pre_archive')]
                    if remaining_archives:
                        with operation_activity(
                                f'Archiving due to policy {plan["target"]}/{plan["area"]}',
                                len(remaining_archives)) as activity:
                            if activity is not None:
                                activity.count_verb = 'archived'
                            archive_policy_copies(
                                plan | {'policy_archives': remaining_archives}, run_id,
                                result['policy_archived'], activity,
                                lambda: save_local_report(policy.state_dir, 'last-run.json', data))
                result["ok"] = True
            except TransferInterrupted as exc:
                result.update(transfer_metrics(exc.stats, False))
                if args.command == 'run':
                    result['archive_deleted_completed_paths'] = completed_deleted_archive_paths(plan, run_id)
                result.update(ok=False, error="Interrupted by user; files already uploaded remain in the cloud.")
                if args.command == 'run':
                    data['interrupted'] = True
                    result.pop('in_progress', None)
                    save_local_report(policy.state_dir, 'last-run.json', data)
                break
            except KeyboardInterrupt:
                if args.command == 'run':
                    result.update(transfer_metrics(None, False))
                    if result['archive_deleted_completed_paths'] is None:
                        result['archive_deleted_completed_paths'] = completed_deleted_archive_paths(plan, run_id)
                result.update(ok=False, error="Interrupted by user; files already uploaded remain in the cloud.")
                if args.command == 'run':
                    data['interrupted'] = True
                    result.pop('in_progress', None)
                    save_local_report(policy.state_dir, 'last-run.json', data)
                break
            except (ConfigError, TransportError, OSError) as exc:
                if args.command == 'run' and 'transferred_files' not in result:
                    result.update(transfer_metrics(getattr(exc, 'stats', None), False))
                    result['archive_deleted_completed_paths'] = completed_deleted_archive_paths(plan, run_id)
                result.update(ok=False, error=str(exc))
            if args.command == 'run':
                result.pop('in_progress', None)
                save_local_report(policy.state_dir, 'last-run.json', data)
        preview_note = ("Preview; no cloud changes." if args.simulate else
                        "Plan based on local selection and current inventories; "
                        "content differences not checked. No cloud changes.") if args.command == 'preview' else None
        if args.command == "run":
            complete = not data['interrupted'] and not prearchive_failed and attempted == len(plans)
            for result in results:
                if not result['ok'] and 'error' not in result:
                    result['error'] = 'Not started: an earlier phase did not complete.'
            data.update(ok=all(item['ok'] for item in results),
                        complete=complete,
                        active_phase=None if complete else data['active_phase'],
                        finished_at=datetime.now(timezone.utc).isoformat())
            save_local_report(policy.state_dir, 'last-run.json', data)
        else:
            data = {"operation": args.command, "run_id": run_id,
                    "ok": all(item["ok"] for item in results),
                    "results": results, "note": preview_note, "conflicts": conflicts}
        if getattr(args, "json", False):
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print(ui(data["note"], 'subtle'))
            for item in conflicts:
                print(f"{ui('WARNING:', 'warning')} {ui(item['target'] + '/current', 'remote')}: "
                      f"{ui(display_safe_path(item['path']), 'muted')} in plain and private; "
                      f"the copy {', '.join(item['archive_from'])} must be archived before transfers.")
            for result in results:
                outcome = ui('OK', 'success') if result['ok'] else ui('ERROR', 'error')
                absence_label = 'to archive because absent from local selection'
                print(f"{ui(result['target'] + '/' + result['area'] + '/' + result['kind'], 'remote')}: {outcome}; "
                      f"selected {result['selected']}; {absence_label} {result['archive_deleted']}; "
                      f"to archive due to policy {result['archive_policy']}.")
                absent_paths = result['archive_deleted_paths']
                for path in absent_paths if args.command == 'preview' else absent_paths[:20]:
                    print(f"  Absent from local selection: {ui(display_safe_path(path), 'muted')}")
                if args.command == 'run' and len(absent_paths) > 20:
                    print(ui(f"  Other {len(absent_paths) - 20} paths in macbackup status.", 'subtle'))
                for item in result['policy_archives']:
                    print(f"  Policy: {item['path']} → {item['new_action']}; {item['reason']}" +
                          (f" Rule: {item['rule']}" if item['rule'] else ''))
                if result['archive_limit_exceeded']:
                    print(f"  {ui('WARNING:', 'warning')} exceeds max_delete={limit}; a run would stop before transfers.")
                if args.command == 'run':
                    archived = result['archive_deleted_completed_paths']
                    if archived is None:
                        print(ui('Archives for local selection absence: completion could not be verified.', 'warning'))
                    else:
                        print(f'Archived for absence from local selection: '
                              f'{len(archived)}/{result["archive_deleted"]}.')
                    if result['archive_policy']:
                        print(f"Archived due to policy: {len(result['policy_archived'])}/{result['archive_policy']}.")
                    if result.get('transferred_files') is None:
                        print('Transfers: count unavailable.')
                    else:
                        label = ' (latest report, incomplete)' if not result['counts_complete'] else ''
                        print(f"Transferred {result['transferred_files']} file, "
                              f"{progress_quantity(result['transferred_bytes'], False)}; "
                              f"checked {result['checked_files']}{label}.")
                        if result.get('server_side_moves') is not None:
                            print(f"Server-side moves: {result['server_side_moves']} file, "
                                  f"{progress_quantity(result['server_side_move_bytes'], False)}{label}.")
                if not result["ok"]:
                    print(f"{ui('ERROR:', 'error')} {result['error']}")
        return 0 if data["ok"] else 1


def forget_inventory(targets: dict, requested: str, subtree: bool, area_filter: str,
                     activity: MountPulse | None = None) -> list[dict]:
    """List exact current/history objects, independent of the active selector."""
    wanted = requested.lstrip('/')
    matches = []
    for target, areas in targets.items():
        for area, root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in ('files', 'macos-icons'):
                prefix = root if kind == 'files' else remote_join(root, 'macos-icons')
                for location in ('current', 'history'):
                    inventory_root = remote_join(prefix, location)
                    if activity is not None:
                        listing = mount_inventory(
                            inventory_root, f'{target}/{area}/{kind}/{location}',
                            options=('--recursive', '--files-only', '--links', '--hash', '--original'),
                            activity=activity)
                    else:
                        listing = json.loads(rclone_call(
                            'lsjson', inventory_root, '--recursive', '--files-only',
                            '--links', '--hash', '--original', missing_ok=True,
                        ))
                    seen = set()
                    for item in listing:
                        relative = item.get('Path')
                        if not isinstance(relative, str) or not relative or relative.startswith('/') or any(
                            part in ('', '.', '..') for part in relative.split('/')
                        ):
                            raise TransportError('Cloud inventory contains an invalid path.')
                        absolute_path('/' + relative)
                        if relative in seen:
                            raise TransportError('Duplicate cloud paths; forget blocked.')
                        seen.add(relative)
                        if location == 'history':
                            version, sep, logical = relative.partition('/')
                            if not sep or not version:
                                raise TransportError('History version has an invalid path.')
                        else:
                            version, logical = None, relative
                        if kind == 'macos-icons':
                            if not logical.endswith(ICON_SIDECAR):
                                raise TransportError('Unexpected item in the icon area.')
                            logical = logical[:-len(ICON_SIDECAR)]
                            selected = subtree and (logical == wanted or logical.startswith(wanted + '/'))
                        else:
                            if logical.endswith('.rclonelink'):
                                logical = logical[:-len('.rclonelink')]
                            selected = (logical == wanted or subtree and logical.startswith(wanted + '/'))
                        if not selected:
                            continue
                        size = item.get('Size')
                        if type(size) is not int or size < 0:
                            raise TransportError('Invalid cloud size; forget blocked.')
                        hashes = item.get('Hashes') or {}
                        if not isinstance(hashes, dict):
                            raise TransportError('Invalid cloud hash; forget blocked.')
                        matches.append({
                            'target': target, 'area': area, 'kind': kind,
                            'location': location, 'version': version,
                            'remote_path': remote_join(inventory_root, relative),
                            'relative': relative, 'size': size,
                            'modtime': item.get('ModTime'), 'id': item.get('ID'),
                            'original_id': item.get('OrigID'),
                            'hashes': hashes,
                        })
                        if activity is not None:
                            activity.matches += 1
    matches.sort(key=lambda item: (item['target'], item['area'], item['remote_path']))
    return matches


def write_private_json(path: Path, data: dict) -> None:
    with path.open('x') as stream:
        os.chmod(path, 0o600)
        json.dump(data, stream, ensure_ascii=False, indent=2)
        stream.flush()
        os.fsync(stream.fileno())


def check_permanent_google(targets: dict) -> None:
    remotes = {item['name']: item['type'] for item in json.loads(rclone_call('listremotes', '--json'))}
    plain_remote = targets['google']['plain'].split(':', 1)[0]
    if remotes.get(plain_remote) != 'drive':
        raise ConfigError('Permanent removal requires a real Google Drive remote.')


def forget_directory_present(root: str) -> bool:
    parent, name = root.rsplit('/', 1)
    listing = json.loads(rclone_call('lsjson', parent, '--dirs-only',
                                     '--original', missing_ok=True))
    matches = [item for item in listing if item.get('Name') == name]
    if len(matches) > 1:
        raise TransportError('Duplicate cloud directories; forget blocked.')
    return bool(matches)


def forget_cleanup_roots(targets: dict, requested: str, area_filter: str) -> list[str]:
    """Find the exact requested directory in current and each history version."""
    roots = set()
    for areas in targets.values():
        for area, area_root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in ('files', 'macos-icons'):
                prefix = area_root if kind == 'files' else remote_join(area_root, 'macos-icons')
                current = remote_join(remote_join(prefix, 'current'), requested.lstrip('/'))
                if forget_directory_present(current):
                    roots.add(current)
                history = remote_join(prefix, 'history')
                versions = json.loads(rclone_call('lsjson', history, '--dirs-only',
                                                  '--original', missing_ok=True))
                seen = set()
                for version in versions:
                    name = version.get('Name')
                    if not isinstance(name, str) or not name or '/' in name or name in ('.', '..'):
                        raise TransportError('History version has an invalid path.')
                    if name in seen:
                        raise TransportError('Duplicate history versions in the cloud.')
                    seen.add(name)
                    root = remote_join(remote_join(history, name), requested.lstrip('/'))
                    if forget_directory_present(root):
                        roots.add(root)
    return sorted(roots)


def forget_remove_empty_roots(roots: list[str], flag: str) -> list[str]:
    """Remove only empty directories, then confirm that each requested root vanished."""
    completed = []
    for root in roots:
        if forget_directory_present(root):
            rclone_call('rmdirs', root, flag, '--retries', '1')
        if forget_directory_present(root):
            raise TransportError('Directory still present after cleanup: ' + root)
        completed.append(root)
    return completed


def forget_operation(args, config: Path, home: Path) -> int:
    state = home / '.local/state/macbackup'
    with operation_lock(state):
        plans = state / 'forget-plans'
        plans.mkdir(mode=0o700, exist_ok=True)
        if plans.is_symlink():
            raise ConfigError('The plan directory cannot be a symlink.')
        os.chmod(plans, 0o700)
        if args.plan:
            if args.path or args.area or args.target or args.mode or not args.apply:
                raise ConfigError('To apply a plan, use only --plan ID --apply.')
            if not re.fullmatch(r'F[0-9a-f]{12}', args.plan):
                raise ConfigError('Invalid plan ID.')
            file = plans / (args.plan + '.json')
            if file.is_symlink() or not file.is_file():
                raise ConfigError('Plan missing or already used.')
            data = json.loads(file.read_text())
            if data.get('schema_version') != 1 or data.get('plan_id') != args.plan:
                raise ConfigError('Invalid plan format.')
            if data.get('config_dir') != str(config):
                raise ConfigError('Use the same configuration directory as the plan.')
            if time.time() > data.get('expires_at', 0):
                raise ConfigError('Plan expired; create a new one.')
            if data.get('mode') == 'permanent' and data.get('target') != 'google':
                raise ConfigError('Automatic permanent removal is available only for Google.')
            targets, _ = load_targets(config, data['target'], require_enabled=False)
            if data['mode'] == 'permanent':
                check_permanent_google(targets)
            if targets != data.get('roots'):
                raise ConfigError('Targets changed; create a new plan.')
            with operation_activity('Checking forget plan', report_non_tty=True,
                                    show_count='entries') as activity:
                activity.matches = 0
                current = forget_inventory(targets, data['requested'], data['subtree'],
                                           data['area'], activity)
                cleanup_roots = (forget_cleanup_roots(targets, data['requested'], data['area'])
                                 if data['subtree'] else [])
            if current != data.get('items'):
                raise ConfigError('Cloud copies changed; create a new plan.')
            if cleanup_roots != data.get('cleanup_roots', cleanup_roots):
                raise ConfigError('Plan directories changed; create a new plan.')
            applying = plans / (args.plan + '.applying')
            os.replace(file, applying)
            completed = []
            error = None
            flag = '--drive-use-trash=false' if data['mode'] == 'permanent' else '--drive-use-trash=true'
            with operation_activity('Removing copies', len(current)) as activity:
                if activity is not None:
                    activity.count_verb = 'removed'
                for item in current:
                    try:
                        rclone_call('deletefile', item['remote_path'], flag, '--retries', '1')
                        completed.append(item['remote_path'])
                        if activity is not None:
                            activity.completed = len(completed)
                    except (TransportError, KeyboardInterrupt) as exc:
                        error = ("Interrupted by user; some copies may already have been removed."
                                 if isinstance(exc, KeyboardInterrupt) else str(exc))
                        if activity is not None:
                            activity.outcome = ('interrupted' if isinstance(exc, KeyboardInterrupt)
                                                else 'error')
                        break
            try:
                with operation_activity('Checking remaining copies', report_non_tty=True,
                                        show_count='entries') as activity:
                    activity.matches = 0
                    remaining = forget_inventory(targets, data['requested'], data['subtree'],
                                                 data['area'], activity)
            except (ConfigError, TransportError) as exc:
                remaining = None
                error = str(exc) if error is None else error + '; final check: ' + str(exc)
            cleaned_roots = []
            if error is None and remaining == [] and cleanup_roots:
                try:
                    cleaned_roots = forget_remove_empty_roots(cleanup_roots, flag)
                except (ConfigError, TransportError) as exc:
                    error = 'Cleaning empty directories: ' + str(exc)
            result = {
                'operation': 'forget-apply', 'plan_id': args.plan,
                'ok': error is None and remaining == [], 'mode': data['mode'],
                'attempted': len(completed) + (1 if error and len(completed) < len(current) else 0),
                'removed_from_active_backup': completed,
                'empty_directory_roots_removed': cleaned_roots,
                'remaining': remaining, 'error': error,
                'note': ('Provider trash; this is not permanent deletion.'
                         if data['mode'] == 'trash' else
                         'Permanent deletion requested; native revisions and existing trash not inspected.'),
            }
            write_private_json(plans / (args.plan + '.result.json'), result)
            if args.json:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            else:
                print(f"{ui('Plan', 'success' if result['ok'] else 'error')} {args.plan}: "
                      f"{len(completed)}/{len(current)} files removed from backup folders.")
                if cleanup_roots:
                    print(f"Empty directories cleaned: {len(cleaned_roots)}/{len(cleanup_roots)} selected roots.")
                if error:
                    print(ui('ERROR:', 'error') + ' ' + error)
                print(ui(result['note'], 'subtle'))
                if remaining:
                    print(f'Items still present: {len(remaining)}. Create a new plan to retry.')
            return 0 if result['ok'] else 1
        if args.apply or not (args.path and args.area and args.target and args.mode):
            raise ConfigError('Creating a plan requires a path, --area, --target and --mode.')
        requested = absolute_path(args.path)
        if requested == Path('/'):
            raise ConfigError('Root / is not allowed in forget.')
        subtree = args.path.endswith('/')
        if requested.is_dir() and not subtree:
            raise ConfigError('For a directory, add / to the end of the path.')
        if args.mode == 'permanent' and args.target != 'google':
            raise ConfigError('Automatic permanent removal is available only for Google.')
        targets, _ = load_targets(config, args.target, require_enabled=False)
        if args.mode == 'permanent':
            check_permanent_google(targets)
        with operation_activity('Searching copies for forget', report_non_tty=True,
                                show_count='entries') as activity:
            activity.matches = 0
            items = forget_inventory(targets, str(requested), subtree, args.area, activity)
            cleanup_roots = forget_cleanup_roots(targets, str(requested), args.area) if subtree else []
        if len(items) > 10000:
            raise ConfigError('More than 10000 files; narrow the path and create multiple plans.')
        result = {
            'operation': 'forget-plan', 'plan_id': None, 'requested': str(requested),
            'subtree': subtree, 'area': args.area, 'target': args.target,
            'mode': args.mode, 'items': items, 'count': len(items),
            'cleanup_roots': cleanup_roots,
            'known_bytes': sum(item['size'] for item in items),
            'selected_locally': None,
            'note': ('Files will move to provider trash; empty directories '
                     'included in the plan will be removed.' if args.mode == 'trash' else
                     'Files and empty directories in the plan will be deleted '
                     'permanently through the provider; native revisions and prior trash '
                     'are not included.'),
        }
        if items or cleanup_roots:
            # The selector is advisory here. Forget must still find old copies
            # after exclusions or routing changes.
            try:
                policy = Policy(config, home)
                result['selected_locally'] = policy.decide(requested, directory=subtree).action in ('plain', 'private')
            except ConfigError:
                pass
            plan_id = 'F' + uuid.uuid4().hex[:12]
            data = {
                'schema_version': 1, 'plan_id': plan_id, 'config_dir': str(config),
                'requested': str(requested), 'subtree': subtree,
                'target': args.target, 'area': args.area, 'mode': args.mode,
                'roots': targets, 'items': items,
                'cleanup_roots': cleanup_roots,
                'expires_at': time.time() + 3600,
            }
            write_private_json(plans / (plan_id + '.json'), data)
            result['plan_id'] = plan_id
            result['expires_at'] = data['expires_at']
        if args.json:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        else:
            print(f"{ui('Matches:', 'info')} {len(items)} file, "
                  f"{progress_quantity(result['known_bytes'], False)} noti.")
            for item in items:
                print(f"{ui(item['target'] + '/' + item['area'] + '/' + item['location'], 'remote')}: "
                      f"{ui(item['remote_path'], 'remote')}")
            if cleanup_roots:
                print(f"Directories to clean if empty: {len(cleanup_roots)} roots.")
                for root in cleanup_roots:
                    print(f"Directory: {ui(root, 'remote')}")
            if result['selected_locally']:
                print(ui('WARNING:', 'warning') + ' the path is still selected and may be uploaded again by the next run.')
            print(ui(result['note'], 'subtle'))
            if result['plan_id']:
                print(f"{ui('To apply within one hour:', 'info')} macbackup forget --plan {result['plan_id']} --apply")
        return 0


def versions_inventory(targets: dict, requested: str, subtree: bool, area_filter: str,
                       activity: MountPulse | None = None) -> list[dict]:
    """Read only the requested current subtree and matching subtrees in each history run."""
    wanted = requested.lstrip('/')
    found = []
    for target, areas in targets.items():
        for area, root in areas.items():
            if area_filter != 'all' and area != area_filter:
                continue
            for kind in (('files', 'macos-icons') if subtree else ('files',)):
                prefix = root if kind == 'files' else remote_join(root, 'macos-icons')
                history_root = remote_join(prefix, 'history')
                runs = (mount_inventory(history_root, f'{target}/{area}/{kind}/history',
                                        options=('--dirs-only',), activity=activity)
                        if activity is not None else
                        json.loads(rclone_call('lsjson', history_root, '--dirs-only',
                                               missing_ok=True)))
                if not isinstance(runs, list):
                    raise TransportError('Invalid history run list.')
                versions = [None]
                for run in runs:
                    name = run.get('Name') if isinstance(run, dict) else None
                    if not isinstance(name, str) or not name or '/' in name or name in ('.', '..'):
                        raise TransportError('Invalid history run name.')
                    versions.append(name)
                for version in versions:
                    location = 'history' if version else 'current'
                    inventory_root = remote_join(prefix, location)
                    base = remote_join(inventory_root, version) if version else inventory_root
                    scope = wanted if subtree else wanted.rpartition('/')[0]
                    search_root = remote_join(base, scope) if scope else base
                    options = ['--files-only', '--links']
                    if subtree:
                        options.append('--recursive')
                    listing = (mount_inventory(
                        search_root, f'{target}/{area}/{kind}/{version or "current"}',
                        options=tuple(options), activity=activity)
                        if activity is not None else
                        json.loads(rclone_call('lsjson', search_root, *options,
                                               missing_ok=True)))
                    if not isinstance(listing, list):
                        raise TransportError('Invalid version inventory.')
                    seen = set()
                    for entry in listing:
                        path = entry.get('Path') if isinstance(entry, dict) else None
                        if not isinstance(path, str) or not path or path.startswith('/') or any(
                            part in ('', '.', '..') for part in path.split('/')
                        ):
                            raise TransportError('Cloud inventory contains an invalid path.')
                        logical = scope + '/' + path if scope else path
                        absolute_path('/' + logical)
                        if logical in seen:
                            raise TransportError('Duplicate cloud paths; versions blocked.')
                        seen.add(logical)
                        if kind == 'macos-icons':
                            if not logical.endswith(ICON_SIDECAR):
                                raise TransportError('Unexpected item in the icon area.')
                            original = logical[:-len(ICON_SIDECAR)]
                        else:
                            original = logical[:-len('.rclonelink')] if logical.endswith('.rclonelink') else logical
                        if not (original == wanted or subtree and original.startswith(wanted + '/')):
                            continue
                        size = entry.get('Size')
                        if type(size) is not int or size < 0:
                            raise TransportError('Invalid cloud size; versions blocked.')
                        relative = version + '/' + logical if version else logical
                        found.append({
                            'target': target, 'area': area, 'kind': kind,
                            'location': location, 'version': version,
                            'remote_path': remote_join(inventory_root, relative),
                            'relative': relative, 'size': size,
                            'modtime': entry.get('ModTime'),
                        })
                        if activity is not None:
                            activity.matches += 1
    found.sort(key=lambda item: (item['target'], item['area'], item['remote_path']))
    return found


def versions_operation(args, config: Path, home: Path) -> int:
    requested = absolute_path(args.path)
    directory = args.path.endswith('/') or (requested.is_dir() and not requested.is_symlink())
    if directory and requested.is_file():
        raise ConfigError('The path given as a directory is a file.')
    if not directory and args.files:
        raise ConfigError('--files is only valid for a directory.')
    targets, _ = load_targets(config, args.target, require_enabled=False)
    with operation_lock(home / '.local/state/macbackup'):
        with operation_activity('Searching versions', report_non_tty=True,
                                show_count='entries') as activity:
            activity.matches = 0
            items = versions_inventory(targets, str(requested), directory, args.area, activity)
    if directory:
        groups = {}
        for item in items:
            version = item['version'] or 'current'
            key = (item['target'], item['area'], version)
            group = groups.setdefault(key, {'target': item['target'], 'area': item['area'],
                                            'version': version, 'location': item['location'],
                                            'count': 0, 'bytes': 0, 'items': []})
            logical = item['relative'].split('/', 1)[1] if item['location'] == 'history' else item['relative']
            if item['kind'] == 'macos-icons':
                logical = logical[:-len(ICON_SIDECAR)]
            elif logical.endswith('.rclonelink'):
                logical = logical[:-len('.rclonelink')]
            group['count'] += 1
            group['bytes'] += item['size']
            group['items'].append({'path': '/' + logical, 'kind': item['kind'],
                                   'size': item['size'], 'modtime': item['modtime'],
                                   'remote_path': item['remote_path']})
        versions = sorted(groups.values(), key=lambda group: (
            group['target'], group['area'], group['version'] != 'current', group['version']))
        for group in versions:
            group['items'].sort(key=lambda item: (item['path'], item['kind']))
        data = {
            'operation': 'versions', 'requested': str(requested), 'kind': 'directory',
            'target': args.target, 'area': args.area, 'versions': versions,
            'note': 'current is the latest copy; each history contains only items moved in that run, not a full directory snapshot.',
        }
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print(f"{ui('Directory versions', 'info')} {requested}: {len(versions)} groups; "
                  f"{len(items)} total items.")
            for group in versions:
                print(f"{ui(group['target'] + '/' + group['area'] + ' ' + group['version'], 'remote')}: "
                      f"{group['count']} items, {progress_quantity(group['bytes'], False)}")
                if args.files and group['location'] == 'history':
                    for item in group['items']:
                        print(f"  {ui(item['path'], 'subtle')} "
                              f"[{item['kind']}; {progress_quantity(item['size'], False)}]")
            print(ui(data['note'], 'subtle'))
        return 0
    items = [item for item in items if item['kind'] == 'files']
    data = {
        'operation': 'versions', 'requested': str(requested),
        'target': args.target, 'area': args.area,
        'versions': [
            {'target': item['target'], 'area': item['area'],
             'version': item['version'] or 'current',
             'location': item['location'], 'size': item['size'],
             'modtime': item['modtime'], 'remote_path': item['remote_path']}
            for item in items
        ],
        'note': 'Modification dates are not archive dates; each history contains only files moved in that run.',
    }
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(f"{ui('Versions found:', 'info')} {len(items)} for {requested}.")
        for item in data['versions']:
            print(f"{ui(item['target'] + '/' + item['area'] + ' ' + item['version'], 'remote')} "
                  f"{progress_quantity(item['size'], False)} {item['modtime'] or 'data ignota'}")
        print(ui(data['note'], 'subtle'))
    return 0


def restore_operation(args, config: Path, home: Path) -> int:
    if args.path.endswith('/'):
        raise ConfigError('restore supports one file at a time; provide the exact file path.')
    requested = absolute_path(args.path)
    destination = absolute_path(args.to)
    if destination == requested:
        raise ConfigError('Do not restore directly over the original path.')
    if destination.is_symlink():
        raise ConfigError('The destination cannot be a symlink.')
    if not destination.parent.is_dir():
        raise ConfigError('The destination directory must already exist.')
    for ancestor in (destination.parent, *destination.parent.parents):
        if ancestor.is_symlink():
            raise ConfigError('The destination path crosses a symlink.')
    if destination.exists() and not args.replace:
        raise ConfigError('Destination already exists; choose another name or use --replace.')
    targets, _ = load_targets(config, args.target, require_enabled=False)
    with operation_lock(home / '.local/state/macbackup'):
        with operation_activity('Searching for version to restore', report_non_tty=True,
                                show_count='entries') as activity:
            activity.matches = 0
            items = [item for item in forget_inventory(targets, str(requested), False,
                                                       args.area, activity)
                     if item['kind'] == 'files' and item['target'] == args.target
                     and item['area'] == args.area and (item['version'] or 'current') == args.version]
        if len(items) != 1:
            raise ConfigError('Version missing or ambiguous; consult macbackup versions.')
        item = items[0]
        is_link = item['relative'].endswith('.rclonelink')
        if is_link and not args.links:
            raise ConfigError('This version is a symlink; add --links to recreate it.')
        if args.links and not is_link:
            raise ConfigError('--links is only valid for a symlink.')
        if is_link and item['size'] > 64 * 1024:
            raise ConfigError('Symlink exceeds 64 KiB; restore blocked.')
        executable = shutil.which('rclone')
        if executable is None:
            raise ConfigError('rclone is not available in PATH.')
        fd, temporary = tempfile.mkstemp(prefix='.macbackup-restore-', dir=destination.parent)
        try:
            with os.fdopen(fd, 'wb') as output:
                os.fchmod(output.fileno(), 0o600)
                with operation_activity('Restoring file') as activity:
                    if activity is not None:
                        activity.byte_fd = output.fileno()
                        activity.byte_total = item['size']
                    transfer = subprocess.run(
                        [executable, '--ask-password=false', 'cat', item['remote_path'],
                         '--retries', '1'], stdout=output, stderr=subprocess.PIPE,
                        text=True, env=transport_env(),
                    )
                output.flush()
                os.fsync(output.fileno())
            if transfer.returncode:
                raise TransportError('Download failed: ' + transfer.stderr.strip()[-1500:])
            if os.path.getsize(temporary) != item['size']:
                raise TransportError('Downloaded size differs from inventory; no file restored.')
            supported = {'md5': 'md5', 'sha1': 'sha1', 'sha-1': 'sha1',
                         'sha256': 'sha256', 'sha-256': 'sha256'}
            expected = {name: value for name, value in item['hashes'].items()
                        if name.lower() in supported and isinstance(value, str) and value}
            if expected:
                digesters = {name: hashlib.new(supported[name.lower()]) for name in expected}
                with open(temporary, 'rb') as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                        for hasher in digesters.values():
                            hasher.update(chunk)
                if any(digesters[name].hexdigest().lower() != value.lower()
                       for name, value in expected.items()):
                    raise TransportError('Downloaded hash differs from inventory; no file restored.')
            with operation_activity('Checking restored copy', report_non_tty=True,
                                    show_count='entries') as activity:
                activity.matches = 0
                refreshed = [new for new in forget_inventory(targets, str(requested), False,
                                                             args.area, activity)
                             if new['remote_path'] == item['remote_path']]
            if refreshed != [item]:
                raise TransportError('Cloud version changed during download; no file restored.')
            if destination.is_symlink():
                raise ConfigError('The destination became a symlink.')
            if is_link:
                try:
                    link_target = Path(temporary).read_bytes().decode('utf-8')
                except UnicodeError as exc:
                    raise ConfigError('Symlink target cannot be represented in UTF-8.') from exc
                if not link_target or '\x00' in link_target:
                    raise ConfigError('Empty or invalid symlink target.')
                if args.replace:
                    if destination.exists() and not destination.is_file():
                        raise ConfigError('--replace can only replace a regular file.')
                    temporary_link = destination.parent / ('.macbackup-link-' + uuid.uuid4().hex)
                    try:
                        os.symlink(link_target, temporary_link)
                        os.replace(temporary_link, destination)
                    finally:
                        temporary_link.unlink(missing_ok=True)
                else:
                    try:
                        os.symlink(link_target, destination)
                    except FileExistsError as exc:
                        raise ConfigError('Destination created during download; nothing overwritten.') from exc
            elif args.replace:
                if destination.exists() and not destination.is_file():
                    raise ConfigError('--replace can only replace a regular file.')
                os.replace(temporary, destination)
            else:
                try:
                    os.link(temporary, destination, follow_symlinks=False)
                except FileExistsError as exc:
                    raise ConfigError('Destination created during download; nothing overwritten.') from exc
                os.unlink(temporary)
            data = {'operation': 'restore', 'ok': True, 'requested': str(requested),
                    'destination': str(destination), 'target': args.target,
                    'area': args.area, 'version': args.version, 'bytes': item['size'],
                    'hash_verified': bool(expected), 'kind': 'symlink' if is_link else 'file',
                    'link_target': link_target if is_link else None,
                    'note': ('Remote hash verified.' if expected else
                             'Content hash unavailable from backend; size and inventory checked.')}
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        label = 'Symlink recreated' if data['kind'] == 'symlink' else 'File restored'
        print(f"{ui(label, 'success')} in {destination} "
              f"({progress_quantity(data['bytes'], False)}). {data['note']}")
    return 0


def verify_report(source: str, destination: str, names: list[str],
                  state: Path, private: bool, download: bool,
                  size_only: bool = False, pulse: MountPulse | None = None) -> dict:
    if not names:
        return {'selected': 0, 'matched': 0, 'different': [], 'missing': [], 'errors': []}
    if size_only:
        options = ('--recursive', '--files-only', '--links', '--fast-list',
                   '--no-modtime', '--no-mimetype')
        if pulse is not None:
            original_label = pulse.label
            listing = mount_inventory(destination,
                                      original_label.removeprefix('Verifying ') + '/current',
                                      options=options, activity=pulse)
            pulse.label = 'Comparing sizes ' + original_label.removeprefix('Verifying ')
            pulse.total = len(names)
            pulse.completed = 0
            pulse.show_count = False
        else:
            listing = json.loads(rclone_call('lsjson', destination, *options, missing_ok=True))
        remote = {}
        for item in listing:
            name, size = item.get('Path'), item.get('Size')
            if not isinstance(name, str) or not name or name.startswith('/') or any(
                    part in ('', '.', '..') for part in name.split('/')):
                raise TransportError('Invalid remote inventory during verification.')
            if name in remote or type(size) is not int or size < 0:
                raise TransportError('Duplicate remote inventory entries or missing sizes.')
            remote[name] = size
        missing, different, errors = [], [], []
        for name in names:
            if name not in remote:
                missing.append(name)
                if pulse is not None:
                    pulse.completed += 1
                continue
            try:
                link_path = Path('/') / name[:-len('.rclonelink')]
                if source == '/' and name.endswith('.rclonelink') and link_path.is_symlink():
                    local_size = len(os.fsencode(os.readlink(link_path)))
                else:
                    local_size = (Path(source) / name).stat().st_size
            except OSError:
                errors.append(name)
                if pulse is not None:
                    pulse.completed += 1
                continue
            if local_size != remote[name]:
                different.append(name)
            if pulse is not None:
                pulse.completed += 1
        return {'selected': len(names), 'matched': len(names) - len(missing) - len(different) - len(errors),
                'different': different, 'missing': missing, 'errors': errors}
    with tempfile.TemporaryDirectory(prefix='verify-', dir=state) as directory:
        directory = Path(directory)
        manifest = write_manifest(directory, names)
        report = directory / 'combined.txt'
        report.touch(mode=0o600)
        if pulse is not None:
            pulse.report_path = report
        command = 'check' if download or size_only or not private else 'cryptcheck'
        options = [command, source, destination, '--files-from0', str(manifest),
                   '--links', '--one-way', '--combined', str(report), '--log-level', 'ERROR']
        if download:
            options.append('--download')
        if size_only:
            options.append('--size-only')
        rclone_call(*options, allowed_codes=(0, 1))
        found = {}
        expected = set(names)
        for line in report.read_text().splitlines():
            if len(line) < 3 or line[1] != ' ' or line[0] not in '=+*!':
                raise TransportError('Incomplete or unexpected verification report.')
            name = line[2:]
            if name not in expected or name in found:
                raise TransportError('Inconsistent verification report.')
            found[name] = line[0]
        if set(found) != expected:
            raise TransportError('Not all selected files were verified.')
        if pulse is not None:
            pulse.report_path = None
            pulse.completed = len(found)
        return {
            'selected': len(names),
            'matched': sum(value == '=' for value in found.values()),
            'different': sorted(name for name, value in found.items() if value == '*'),
            'missing': sorted(name for name, value in found.items() if value == '+'),
            'errors': sorted(name for name, value in found.items() if value == '!'),
        }


def save_local_report(state: Path, filename: str, data: dict) -> None:
    """Replace the private local report without exposing a partial JSON file."""
    data['updated_at'] = datetime.now(timezone.utc).isoformat()
    fd, temporary = tempfile.mkstemp(prefix='report-', dir=state)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as stream:
            json.dump(localized_json(data), stream, ensure_ascii=False, indent=2)
        os.replace(temporary, state / filename)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def display_safe_path(original: str) -> str:
    def escape(match):
        return {'\r': r'\r', '\n': r'\n', '\t': r'\t'}.get(
            match.group(), '\\x%02x' % ord(match.group()))
    return re.sub(r'[\x00-\x1f\x7f]', escape, original)


def verify_display_path(name: str, kind: str) -> str:
    if kind == 'macos-icons' and name.endswith(ICON_SIDECAR):
        original = str(Path('/' + name[:-len(ICON_SIDECAR)]) / FINDER_ICON)
    else:
        original = '/' + (name[:-len('.rclonelink')] if name.endswith('.rclonelink') else name)
    return display_safe_path(original)


def verify_operation(args, config: Path, home: Path) -> int:
    if args.size_only and args.download:
        raise ConfigError('--size-only and --download cannot be used together.')
    targets, _ = load_targets(config, args.target, require_enabled=False)
    policy = Policy(config, home)
    with operation_lock(policy.state_dir):
        results = []
        data = {'operation': 'verify', 'ok': False, 'complete': False, 'interrupted': False,
                'target': args.target, 'area': args.area, 'download': args.download,
                'size_only': args.size_only, 'scope': 'selected-local-versus-remote-current',
                'started_at': datetime.now(timezone.utc).isoformat(), 'results': results,
                'note': 'Compared with current local sources; a difference does not prove corruption. '
                        'History and previously excluded copies are not covered.'}
        active_phase = 'local-scan'
        data['active_phase'] = active_phase
        save_local_report(policy.state_dir, 'last-verify.json', data)
        try:
            with operation_activity('Local scan', show_count=True) as pulse:
                scan = scan_policy(policy, pulse)
            if scan.errors:
                raise ConfigError('The local selection has errors: run macbackup check.')
            for target, areas in targets.items():
                for area, root in areas.items():
                    if args.area != 'all' and args.area != area:
                        continue
                    local = sorted(selected_names(scan, area))
                    method = ('size-only' if args.size_only else 'download' if args.download else
                              'cryptcheck' if area == 'private' else 'check')
                    active_phase = f'{target}/{area}/files'
                    data['active_phase'] = active_phase
                    save_local_report(policy.state_dir, 'last-verify.json', data)
                    try:
                        with operation_activity(f'Verifying {target}/{area}/files', len(local)) as pulse:
                            checked = verify_report('/', remote_join(root, 'current'), local,
                                                    policy.state_dir, area == 'private', args.download,
                                                    args.size_only, pulse)
                        results.append({'target': target, 'area': area, 'kind': 'files',
                                        'method': method, **checked})
                    except (ConfigError, TransportError, OSError) as exc:
                        results.append({'target': target, 'area': area, 'kind': 'files',
                                        'selected': len(local), 'error': str(exc)})
                    save_local_report(policy.state_dir, 'last-verify.json', data)
                    icons = [entry for entry in scan.entries
                             if entry.kind == 'finder-icon' and entry.decision.action == area]
                    if icons:
                        active_phase = f'{target}/{area}/macos-icons'
                        data['active_phase'] = active_phase
                        save_local_report(policy.state_dir, 'last-verify.json', data)
                        try:
                            with tempfile.TemporaryDirectory(prefix='verify-icons-', dir=policy.state_dir) as directory:
                                source = Path(directory)
                                names = []
                                for entry in icons:
                                    relative = str(Path(entry.path).parent).lstrip('/') + ICON_SIDECAR
                                    path = source / relative
                                    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                                    with path.open('x') as stream:
                                        os.chmod(path, 0o600)
                                        json.dump(icon_snapshot(entry), stream, sort_keys=True,
                                                  ensure_ascii=False, indent=2)
                                    names.append(relative)
                                with operation_activity(f'Verifying {target}/{area}/macos-icons', len(names)) as pulse:
                                    checked = verify_report(str(source),
                                        remote_join(remote_join(root, 'macos-icons'), 'current'),
                                        sorted(names), policy.state_dir, area == 'private', args.download,
                                        args.size_only, pulse)
                                results.append({'target': target, 'area': area, 'kind': 'macos-icons',
                                                'method': method, **checked})
                        except (ConfigError, TransportError, OSError) as exc:
                            results.append({'target': target, 'area': area, 'kind': 'macos-icons',
                                            'selected': len(icons), 'error': str(exc)})
                        save_local_report(policy.state_dir, 'last-verify.json', data)
        except KeyboardInterrupt:
            data.update(interrupted=True, active_phase=active_phase,
                        note='Verification interrupted; only completed phases are reported.')
            save_local_report(policy.state_dir, 'last-verify.json', data)
            raise
        except (ConfigError, TransportError, OSError) as exc:
            data.update(error=str(exc), active_phase=active_phase)
            save_local_report(policy.state_dir, 'last-verify.json', data)
            raise
        ok = all(not item.get('error') and not item.get('different')
                 and not item.get('missing') and not item.get('errors') for item in results)
        data.update(ok=ok, complete=True, active_phase=None,
                    finished_at=datetime.now(timezone.utc).isoformat())
        save_local_report(policy.state_dir, 'last-verify.json', data)
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            if args.size_only:
                print(ui('Quick verification: paths and sizes only; contents not compared.', 'warning'))
            for item in results:
                print(f"{ui(item['target'] + '/' + item['area'] + '/' + item['kind'], 'info')}: "
                      f"{item.get('matched', 0)}/{item['selected']} matching; "
                      f"different {len(item.get('different', []))}; "
                      f"missing {len(item.get('missing', []))}; "
                      f"errors {len(item.get('errors', []))}.")
                for key, label in (('different', 'Different'), ('missing', 'Missing'),
                                   ('errors', 'Read error')):
                    paths = item.get(key, [])
                    for name in paths[:20]:
                        print(f"  {label}: {ui(verify_display_path(name, item['kind']), 'muted')}")
                    if len(paths) > 20:
                        print(ui(f"  Other {len(paths) - 20} paths in the saved report: macbackup status --verify", 'subtle'))
                if item.get('error'):
                    print(ui('ERROR:', 'error') + ' ' + item['error'])
            print(ui(data['note'], 'subtle'))
            print(ui('Full report: macbackup status --verify', 'subtle'))
        return 0 if ok else 1


class LocalizedArgumentParser(argparse.ArgumentParser):
    def _print_message(self, message, file=None):
        super()._print_message(localized(message) if message else message, file)


def localize_parser(parser: argparse.ArgumentParser) -> None:
    parser.description = localized(parser.description) if parser.description else None
    for action in parser._actions:
        if isinstance(action.help, str):
            action.help = localized(action.help)
        if isinstance(action, argparse._SubParsersAction):
            for choice in action._choices_actions:
                choice.help = localized(choice.help)
            for child in action.choices.values():
                localize_parser(child)


def make_parser() -> argparse.ArgumentParser:
    parser = LocalizedArgumentParser(
        description="macbackup: protected file selection, preview and backup using rclone.",
        epilog='In path lists, directories need a trailing /; files and symlinks do not.'
    )
    parser.add_argument("--version", action="version", version=f"macbackup {VERSION}")
    parser.add_argument("--config-dir", metavar="PATH", help="absolute directory containing path lists and settings.toml")
    commands = parser.add_subparsers(dest="command", required=True,
                                     parser_class=LocalizedArgumentParser)
    commands.add_parser("init", help="create four lists without active inclusions")
    check = commands.add_parser("check", help="check path lists and local sources")
    check.add_argument("--json", action="store_true", help="structured result")
    check.add_argument("--remote", action="store_true", help="also check remotes without writing to the cloud")
    check.add_argument("--target", choices=("google", "proton", "all"), help="remote check target; requires --remote (default: google)")
    explain = commands.add_parser("explain", help="explain classification of one path")
    explain.add_argument("path", metavar="PATH")
    explain.add_argument("--json", action="store_true", help="print classification as JSON")
    layout = commands.add_parser('layout', help='show private subtrees inside a plain directory')
    layout.add_argument('path', nargs='?', metavar='PATH', help='plain folder; default: current directory')
    layout.add_argument('--json', action='store_true', help='print result as JSON')
    preview = commands.add_parser("preview", help="local preview or remote comparison without cloud changes")
    mode = preview.add_mutually_exclusive_group(required=True)
    mode.add_argument("--local", action="store_true", help="show local selection without cloud access")
    mode.add_argument("--target", choices=("google", "proton", "all"), help="read the cloud and show planned archives")
    preview.add_argument("--simulate", action="store_true",
                         help="also run cryptcheck and an rclone transfer dry run")
    preview.add_argument("--json", action="store_true", help="print plan as JSON")
    run = commands.add_parser("run", help="run backup; requires enabled targets and valid sources")
    run.add_argument("--target", choices=("google", "proton", "all"), required=True,
                     help="backup target; apply archives within max_delete")
    run.add_argument('--progress-depth', type=int, default=2, metavar='N',
                     help='active folder depth relative to home (1-5; default 2)')
    run.add_argument("--json", action="store_true", help="print final summary as JSON; progress stays on stderr")
    mount = commands.add_parser('mount', help='mount cloud copies read-only for browsing')
    mount.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                       help='service to mount; must be enabled in settings.toml')
    mount.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                       help='areas to show (default: all)')
    mount.add_argument('--mountpoint', metavar='ABS_PATH',
                       help='base folder; default: ~/Desktop')
    status = commands.add_parser("status", help="show the saved result of the latest run or verification")
    status.add_argument("--json", action="store_true", help="compatibility: status already prints JSON")
    status.add_argument("--verify", action="store_true", help="show the latest verification report")
    icon = commands.add_parser('restore-icon', help='restore one Finder icon from a local metadata file')
    icon.add_argument('--file', required=True, metavar='PATH', help='icon.json snapshot downloaded from backup')
    icon.add_argument('--folder', required=True, metavar='PATH', help='existing local folder on which to apply the icon')
    icon.add_argument('--replace', action='store_true', help='allows replacing an existing icon')
    icon.add_argument('--json', action='store_true', help='print result as JSON')
    forget = commands.add_parser('forget', help='plan or apply selective removal from current and history')
    forget.add_argument('path', nargs='?', metavar='ABS_PATH', help='original path; trailing / for a directory')
    forget.add_argument('--area', choices=('plain', 'private', 'all'), help='area from which to remove current and history copies')
    forget.add_argument('--target', choices=('google', 'proton', 'all'), help='target from which to remove copies')
    forget.add_argument('--mode', choices=('trash', 'permanent'), help='trash or permanent removal; permanent only on Google')
    forget.add_argument('--plan', metavar='ID', help='plan to apply')
    forget.add_argument('--apply', action='store_true', help='apply the checked plan')
    forget.add_argument('--json', action='store_true', help='print plan or result as JSON')
    versions = commands.add_parser('versions', help='list current and history for a file or directory')
    versions.add_argument('path', metavar='ABS_PATH')
    versions.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                          help='target in which to search versions')
    versions.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                          help='area to search (default: all)')
    versions.add_argument('--files', action='store_true', help='for a directory, list only files in history')
    versions.add_argument('--json', action='store_true', help='print versions as JSON')
    restore = commands.add_parser('restore', help='download one file version to an explicit path')
    restore.add_argument('path', metavar='ABS_PATH')
    restore.add_argument('--target', choices=('google', 'proton'), required=True,
                         help='target from which to restore the file')
    restore.add_argument('--area', choices=('plain', 'private'), required=True,
                         help='area containing the version')
    restore.add_argument('--version', required=True, metavar='VERSION',
                         help='current or history ID returned by versions')
    restore.add_argument('--to', required=True, metavar='ABS_PATH',
                         help='absolute local destination path')
    restore.add_argument('--replace', action='store_true', help='replace an existing local file')
    restore.add_argument('--links', action='store_true', help='recreate a .rclonelink as a symlink')
    restore.add_argument('--json', action='store_true', help='print result as JSON')
    verify = commands.add_parser('verify', help='compare current local sources with cloud current')
    verify.add_argument('--target', choices=('google', 'proton', 'all'), required=True,
                        help='target to compare')
    verify.add_argument('--area', choices=('plain', 'private', 'all'), default='all',
                        help='area to compare (default: all)')
    verify.add_argument('--download', action='store_true', help='read remote data for comparison')
    verify.add_argument('--size-only', action='store_true',
                        help='compare paths and sizes without reading contents')
    verify.add_argument('--json', action='store_true', help='print comparison as JSON')
    localize_parser(parser)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = make_parser().parse_args(argv)
    try:
        home = Path.home()
        config = absolute_path(args.config_dir) if args.config_dir else home / ".config/macbackup"
        if args.command == 'restore-icon':
            with operation_lock(home / '.local/state/macbackup'):
                data = restore_icon(absolute_path(args.file), absolute_path(args.folder), args.replace)
            print(json.dumps(data, ensure_ascii=False) if args.json else ui(data['note'], 'success'))
            return 0
        if args.command == 'forget':
            return forget_operation(args, config, home)
        if args.command == 'versions':
            return versions_operation(args, config, home)
        if args.command == 'restore':
            return restore_operation(args, config, home)
        if args.command == 'verify':
            return verify_operation(args, config, home)
        if args.command == 'mount':
            return mount_operation(args, config, home)
        if args.command == "init":
            files = init_config(config, home)
            print(ui("Configuration initialized.", 'success') +
                  " No paths included and no cloud access.")
            print("\n".join(files))
            return 0
        if args.command == "status":
            file = home / (".local/state/macbackup/last-verify.json" if args.verify
                           else ".local/state/macbackup/last-run.json")
            if file.is_symlink():
                raise ConfigError("The status file cannot be a symlink.")
            if not file.exists():
                message = ('No verification recorded.' if args.verify else
                           'No run recorded. No backup certified.')
                data = {"ok": None, "note": localized(message)}
            else:
                data = json.loads(file.read_text())
            # A saved report is a historical record: keep its original language.
            builtins.print(json.dumps(data, ensure_ascii=False, indent=2))
            return 1 if data.get("ok") is False else 0
        policy = Policy(config, home)
        if args.command == 'layout':
            with operation_activity('Analyzing layout', show_count=True) as pulse:
                data = split_layout(policy, absolute_path(args.path) if args.path else Path.cwd(), pulse)
            if args.json:
                print(json.dumps(data, ensure_ascii=False, indent=2))
            else:
                if not data['ok']:
                    for error in data['errors']:
                        print(ui('ERROR:', 'error', sys.stderr) + ' ' +
                              error.replace('\r', '\\r'), file=sys.stderr)
                else:
                    print(f"{ui(data['path'], 'subtle')}: {data['plain_items']} plain items, "
                          f"{data['private_items']} private.")
                    for item in data['private_subtrees']:
                        print(f"{ui('PRIVATE', 'private')} {ui(item['path'], 'subtle')} "
                              f"({item['private_items']} items, "
                              f"{progress_quantity(item['selected_bytes'], False)})")
                    if not data['private_subtrees']:
                        print('No private subtrees found inside it.')
                    print(ui(data['note'], 'subtle'))
            return 0 if data['ok'] else 1
        if args.command == "check" and args.target and not args.remote:
            raise ConfigError("check --target also requires --remote.")
        if args.command == 'preview' and args.local and args.simulate:
            raise ConfigError('preview --simulate requires --target.')
        if args.command == "run" or (args.command == "preview" and not args.local) or (args.command == "check" and args.remote):
            if args.command == "check" and args.target is None:
                args.target = "google"
            return transport_operation(args, policy)
        if args.command == "explain":
            path = absolute_path(args.path)
            try:
                info = path.lstat()
                kind = file_kind(info)
                exists = True
            except FileNotFoundError:
                kind, exists = "missing", False
            decision = policy.decide(path, directory=kind == "directory")
            data = {
                "scope": "single-path", "path": str(path), "kind": kind,
                "exists": exists, **asdict(decision),
                "note": "Classification of this path only; use check to inspect the full selection.",
            }
            if args.json:
                print(json.dumps(data, ensure_ascii=False, indent=2))
            else:
                tone = ('private' if decision.action == 'private' else
                        'error' if decision.action == 'error' else
                        'success' if decision.action == 'plain' else 'warning')
                print(f"{ui(decision.action.upper() + ':', tone)} {path}\n{decision.reason}")
                if decision.rule:
                    print(f"Rule: {decision.rule}")
                if decision.protected_pattern:
                    print(f"Protected pattern: {decision.protected_pattern}; exact inclusion: {decision.explicit}")
                if kind == "symlink":
                    print("Symlink: the target is not traversed.")
                if not exists:
                    print("The path does not currently exist; this is only a classification.")
                print(ui(data["note"], 'subtle'))
            return 1 if decision.action == "error" else 0
        with operation_activity('Local scan', show_count=True) as pulse:
            scan = scan_policy(policy, pulse)
        if not policy.roots:
            scan.warnings.append("No paths selected: the inclusion lists are empty.")
        data = {
            "scope": "local-only", "ok": not scan.errors,
            "config_dir": str(config), "summary": scan.summary(),
            "errors": scan.errors, "warnings": scan.warnings,
        }
        if args.command == "preview":
            # Fail closed: never present a partial scan as an executable plan.
            data["entries"] = [] if scan.errors else [entry.public_dict() for entry in scan.entries]
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        else:
            print(ui("Local check complete.", 'success') if data["ok"]
                  else ui("Local check FAILED.", 'error'))
            print(ui("No cloud access; no files transferred or deleted.", 'muted'))
            for error in scan.errors:
                print(issue_line('ERROR:', error, 'error'))
            for warning in scan.warnings:
                print(issue_line('WARNING:', warning, 'warning'))
            if args.command == "preview" and not scan.errors:
                for entry in scan.entries:
                    action = entry.decision.action.upper().ljust(7)
                    tone = 'private' if action.strip() == 'PRIVATE' else 'success' if action.strip() == 'PLAIN' else 'muted'
                    print((f"{ui(action, tone)} {ui(str(entry.path), 'muted')} "
                           f"[{entry.kind}] — {entry.decision.reason}").replace('\r', '\\r'))
            print_selection_summary(data["summary"])
        return 0 if data["ok"] else 1
    except KeyboardInterrupt:
        if not getattr(args, 'json', False):
            print('Interrupted by user.', file=sys.stderr)
        return 130
    except (ConfigError, OSError, TransportError, json.JSONDecodeError) as exc:
        if getattr(args, "json", False):
            print(json.dumps({"scope": "operation-error", "ok": False, "errors": [str(exc)]}, ensure_ascii=False))
        else:
            print(f'{terminal_style("ERROR:", "1;31", sys.stderr)} {exc}', file=sys.stderr)
        return 1 if isinstance(exc, TransportError) else 2


if __name__ == "__main__":
    raise SystemExit(main())
