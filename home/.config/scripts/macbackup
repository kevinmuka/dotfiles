def macbackup_language() -> str:
    return 'it' if os.environ.get('MACBACKUP_LANG', 'en').lower() == 'it' else 'en'


_TRANSLATIONS = tuple(sorted(ITALIAN_TO_ENGLISH.items(), key=lambda pair: -len(pair[0])))
_LOCAL_PATH = re.compile(r'(?<![\w/])/(?:Users|Volumes|private|tmp|var|etc|opt|System|Library)/')


def _localize_text(value: str) -> str:
    for original, english in _TRANSLATIONS:
        value = value.replace(original, english)
    return value


def localized(value: str) -> str:
    if macbackup_language() == 'it':
        return value
    # Paths may contain words that also occur in UI messages. Keep their bytes
    # intact while translating the surrounding label or explanation.
    output = []
    cursor = 0
    for match in _LOCAL_PATH.finditer(value):
        if match.start() < cursor:
            continue
        end = len(value)
        for separator in ('\n', ': ', '; ', ' (', ' [', ' — '):
            found = value.find(separator, match.start())
            if found != -1:
                end = min(end, found)
        output.append(_localize_text(value[cursor:match.start()]))
        output.append(value[match.start():end])
        cursor = end
    output.append(_localize_text(value[cursor:]))
    return ''.join(output)


_TRANSLATED_JSON_FIELDS = {'reason', 'note', 'error', 'errors', 'warnings'}


def localized_json(value, key: str = ''):
    if isinstance(value, dict):
        return {name: localized_json(item, name) for name, item in value.items()}
    if isinstance(value, list):
        return [localized_json(item, key) for item in value]
    if isinstance(value, str) and key in _TRANSLATED_JSON_FIELDS:
        return localized(value)
    return value


def print(*values, **kwargs):
    """Localize only display text and explanatory JSON values, never JSON keys."""
    if macbackup_language() == 'it':
        return builtins.print(*values, **kwargs)
    rendered = []
    for value in values:
        if isinstance(value, str):
            try:
                data = json.loads(value) if value.lstrip().startswith(('{', '[')) else None
            except json.JSONDecodeError:
                data = None
            if isinstance(data, (dict, list)):
                value = json.dumps(localized_json(data), ensure_ascii=False,
                                   indent=2 if '\n' in value else None)
            else:
                value = localized(value)
        rendered.append(value)
    return builtins.print(*rendered, **kwargs)
