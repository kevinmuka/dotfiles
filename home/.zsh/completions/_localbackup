#compdef localbackup

# Read app metadata locally; the metadata command never loads config or runs a backup.
local curcontext="$curcontext" context state state_descr line
local -A opt_args
local -a command_choices app_names app_specs fields
local completion_launcher="${LOCALBACKUP_COMPLETION_LAUNCHER:-$HOME/.config/scripts/localbackup}"
if [[ ! -x "$completion_launcher" ]]; then
  completion_launcher="$(whence -p localbackup 2>/dev/null)"
fi
[[ -n "$completion_launcher" && -x "$completion_launcher" ]] || return 1
app_specs=("${(@f)$(PYTHONDONTWRITEBYTECODE=1 "$completion_launcher" --completion-spec 2>/dev/null)}")
(( ${#app_specs} )) || return 1
local record
for record in "${app_specs[@]}"; do
  IFS=$'\t' read -rA fields <<< "$record"
  [[ "$fields[1]" == app ]] && app_names+=("$fields[2]")
done

_localbackup_apps() {
  compadd -- "${app_names[@]}"
}

_localbackup_apps_or_all() {
  compadd -- "${app_names[@]}" all
}

command_choices=(
  'list:list supported applications'
  'init:create an editable TOML configuration'
  'now:create a backup without changing its schedule'
  'run:alias for now'
  'start:back up now and enable the schedule'
  'stop:disable the schedule and keep archives'
  'status:show schedules and LaunchAgent state'
  'archives:list local archive files'
  'restore:validate or restore an archive'
)

_localbackup_absolute_path() {
  if [[ -z "$PREFIX" ]]; then
    compadd -S '' -- /
  elif [[ "$PREFIX" == /* || "$PREFIX" == \~* ]]; then
    _path_files "$@"
  fi
}

if (( CURRENT == 2 )) && [[ "$PREFIX" == -* && "$PREFIX" != *=* ]]; then
  local -a global_options
  global_options=(
    '--config:alternate TOML configuration'
    '--help:command help'
    '--version:installed version'
    '-h:command help'
  )
  _describe -t options 'global options' global_options
  return
fi

_arguments -C -A '-*' \
  '(- *)'{-h,--help}'[command help]' \
  '(- *)--version[installed version]' \
  '--config=[alternate TOML configuration]:absolute file:_localbackup_absolute_path' \
  '1:command:->command' \
  '*::argument:->arguments'

case "$state" in
  command)
    _describe -t commands 'localbackup command' command_choices
    ;;
  arguments)
    local selected_app='' token
    for token in "${line[@]}"; do
      if (( ${app_names[(Ie)$token]} )); then
        selected_app="$token"
        break
      elif [[ "$token" == all ]]; then
        selected_app=all
        break
      fi
    done
    case "$line[1]" in
      list|init)
        _arguments '(- *)'{-h,--help}'[show help]' '--json[JSON output]'
        ;;
      now|run)
        local -a run_options
        run_options=(
          '(- *)'{-h,--help}'[show help]'
          '--json[JSON output]'
          '--keep=[versions to retain]:count:'
        )
        if [[ "$selected_app" != '' && "$selected_app" != all ]]; then
          run_options+=('--output-dir=[archive directory for this run]:absolute folder:_localbackup_absolute_path -/')
        fi
        for record in "${app_specs[@]}"; do
          IFS=$'\t' read -rA fields <<< "$record"
          [[ "$fields[1]" == option && "$fields[2]" == now && "$fields[3]" == "$selected_app" ]] || continue
          case "$fields[5]" in
            path) run_options+=("$fields[4]=[$fields[6]]:absolute folder:_localbackup_absolute_path -/") ;;
            archive) run_options+=("$fields[4]=[$fields[6]]:archive:_files -g '*.zip'") ;;
            int) run_options+=("$fields[4]=[$fields[6]]:count:") ;;
            text) run_options+=("$fields[4]=[$fields[6]]:value:") ;;
          esac
        done
        _arguments \
          "${run_options[@]}" \
          '1:application:_localbackup_apps_or_all'
        ;;
      start)
        _arguments \
          '(- *)'{-h,--help}'[show help]' \
          '--json[JSON output]' \
          '1:application:_localbackup_apps_or_all'
        ;;
      stop|status|archives)
        _arguments \
          '(- *)'{-h,--help}'[show help]' \
          '--json[JSON output]' \
          '1::application:_localbackup_apps_or_all'
        ;;
      restore)
        local -a restore_options
        restore_options=(
          '(- *)'{-h,--help}'[show help]'
          '--json[JSON output]'
          '--apply[replace current settings after validation]'
        )
        for record in "${app_specs[@]}"; do
          IFS=$'\t' read -rA fields <<< "$record"
          [[ "$fields[1]" == option && "$fields[2]" == restore && "$fields[3]" == "$selected_app" ]] || continue
          case "$fields[5]" in
            path) restore_options+=("$fields[4]=[$fields[6]]:absolute folder:_localbackup_absolute_path -/") ;;
            archive) restore_options+=("$fields[4]=[$fields[6]]:archive:_files -g '*.zip'") ;;
            int) restore_options+=("$fields[4]=[$fields[6]]:count:") ;;
            text) restore_options+=("$fields[4]=[$fields[6]]:value:") ;;
          esac
        done
        _arguments \
          "${restore_options[@]}" \
          '1:application:_localbackup_apps'
        ;;
    esac
    ;;
esac
