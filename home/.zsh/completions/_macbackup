#compdef macbackup

# This completion is deliberately offline: never invoke macbackup or rclone.
local curcontext="$curcontext" context state state_descr line
local -A opt_args
local -a commands

commands=(
  'init:crea gli elenchi senza inclusioni attive'
  'check:controlla configurazione e sorgenti locali'
  'explain:spiega la classificazione di un percorso'
  'layout:mostra le parti private dentro una cartella consultabile'
  'preview:mostra la selezione locale'
  'run:esegue il backup sulle destinazioni abilitate'
  "status:mostra l'esito memorizzato dell'ultima esecuzione"
  "restore-icon:ripristina un'icona Finder da un file locale"
  'forget:prepara o applica la rimozione selettiva di copie dal backup'
  'versions:mostra le copie correnti e storiche di un file'
  'restore:scarica una versione in un percorso locale esplicito'
  'verify:confronta i file locali attuali con la copia corrente'
)

_macbackup_absolute_path() {
  if [[ -z "$PREFIX" ]]; then
    compadd -S '' -- /
  elif [[ "$PREFIX" == /* || "$PREFIX" == \~* ]]; then
    _path_files "$@"
  fi
}

_arguments -C -A '-*' \
  '(- *)'{-h,--help}'[mostra aiuto]' \
  '(- *)--version[mostra la versione]' \
  '--config-dir=[directory degli elenchi]:directory assoluta:_macbackup_absolute_path -/' \
  '1:comando:->command' \
  '*::argomento:->arguments'

case "$state" in
  command)
    _describe -t commands 'comando macbackup' commands
    ;;
  arguments)
    case "$line[1]" in
      init)
        _arguments '(- *)'{-h,--help}'[mostra aiuto]'
        ;;
      check)
        local -a check_options
        check_options=(
          '--json[stampa il risultato in JSON]'
          '--remote[controlla anche le destinazioni senza modificarle]'
        )
        if (( ${words[(Ie)--remote]} )); then
          check_options+=('--target=[destinazione]:destinazione:(google proton all)')
        fi
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          "${check_options[@]}"
        ;;
      explain)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--json[stampa il risultato in JSON]' \
          '1:percorso assoluto:_macbackup_absolute_path'
        ;;
      layout)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--json[stampa il risultato in JSON]' \
          '1::cartella plain (predefinita: directory corrente):_macbackup_absolute_path -/'
        ;;
      preview)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '(--target)--local[mostra la selezione locale senza accesso cloud]' \
          "(--local)--target=[destinazione dell'anteprima remota]:destinazione:(google proton all)" \
          '--json[stampa il risultato in JSON]'
        ;;
      run)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--target=[destinazione del backup]:destinazione:(google proton all)' \
          '--progress-depth=[livelli di cartelle attive rispetto alla home]:livelli:(1 2 3 4 5)' \
          '--json[stampa il risultato in JSON]'
        ;;
      status)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--json[stampa il risultato in JSON]'
        ;;
      restore-icon)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--file=[snapshot locale icon.json]:file assoluto:_macbackup_absolute_path' \
          '--folder=[cartella esistente di destinazione]:cartella assoluta:_macbackup_absolute_path -/' \
          "--replace[sostituisce un'icona già presente]" \
          '--json[stampa il risultato in JSON]'
        ;;
      forget)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--area=[area da cercare]:area:(plain private all)' \
          '--target=[destinazione da cercare]:destinazione:(google proton all)' \
          '--mode=[modalità di rimozione]:modalità:(trash permanent)' \
          '--plan=[ID del piano]:ID:' \
          '--apply[applica il piano dopo una nuova verifica]' \
          '--json[stampa il risultato in JSON]' \
          '1:percorso assoluto:_macbackup_absolute_path'
        ;;
      versions)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--target=[destinazione]:destinazione:(google proton all)' \
          '--area=[area]:area:(plain private all)' \
          '--files[mostra i singoli elementi di ogni versione della directory]' \
          '--json[stampa il risultato in JSON]' \
          '1:percorso originale del file o della directory:_macbackup_absolute_path'
        ;;
      restore)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--target=[destinazione]:destinazione:(google proton)' \
          '--area=[area]:area:(plain private)' \
          '--version=[versione restituita da versions]:versione:' \
          '--to=[file locale di destinazione]:file assoluto:_macbackup_absolute_path' \
          '--replace[sostituisce un file locale già presente]' \
          '--links[ricrea un collegamento simbolico da un file .rclonelink]' \
          '--json[stampa il risultato in JSON]' \
          '1:percorso originale:_macbackup_absolute_path'
        ;;
      verify)
        _arguments \
          '(- *)'{-h,--help}'[mostra aiuto]' \
          '--target=[destinazione]:destinazione:(google proton all)' \
          '--area=[area]:area:(plain private all)' \
          '--download[confronta leggendo anche i dati remoti]' \
          '--json[stampa il risultato in JSON]'
        ;;
    esac
    ;;
esac
