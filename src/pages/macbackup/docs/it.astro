---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import LiveGuide from '../../../components/LiveGuide.astro';
import { pages } from '../../../data/pages';
import { getLiveGuide } from '../../../lib/live-guides';
import { githubUrl } from '../../../lib/repositories';

export const prerender = false;
const page = pages.find((item) => item.path === '/macbackup/docs/it')!;
const guide = await getLiveGuide('dotfiles', 'docs/macbackup.md').catch(() => null);
Astro.response.headers.set('Cache-Control', guide ? 'public, s-maxage=300, stale-while-revalidate=900' : 'no-store');
---
<SiteLayout page={page}>
  <LiveGuide overview="/macbackup" source={githubUrl('dotfiles', 'docs/macbackup.md')} english="/macbackup/docs" italian="/macbackup/docs/it" label="macbackup" html={guide?.html} headings={guide?.headings} fallback={page.content} />
</SiteLayout>
