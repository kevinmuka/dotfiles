---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../data/pages';

export function getStaticPaths() {
  return pages.slice(1).filter((page) => !/^\/(?:macbackup|nvim)\/docs(?:\/it)?$/.test(page.path)).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<SiteLayout page={page}>
  <main transition:name="page-content" data-guide={/^\/(macbackup|nvim)\/docs(?:\/it)?$/.test(page.path) ? 'true' : undefined}><Fragment set:html={page.content} /></main>
</SiteLayout>
