---
import type { GuideHeading } from '../lib/live-guides';
import { withGuideUpdated } from '../lib/guide-updated';

interface Props {
  overview: string;
  source: string;
  english: string;
  italian: string;
  label: string;
  lang?: 'en' | 'it';
  html?: string;
  headings?: GuideHeading[];
  fallback: string;
  updatedAt?: string;
}

const { overview, source, english, italian, label, lang = 'it', html, headings = [], fallback, updatedAt } = Astro.props;
const isItalian = lang === 'it';
---
<main transition:name="page-content" data-guide="true">
  {html ? <>
    <div class="wrap doc-intro">
      <a class="section-back" href={overview}>{isItalian ? `← Torna a ${label}` : `← ${label} overview`}</a>
      <p class="eyebrow">{label} / {isItalian ? 'documentazione' : 'documentation'}</p>
      <p>{isItalian ? 'Per verificare la versione più recente, ' : 'For the latest version, '}<a href={source} target="_blank" rel="noopener noreferrer">{isItalian ? 'consulta la guida su GitHub ↗' : 'check the guide on GitHub ↗'}</a>.</p>
      <nav aria-label={isItalian ? 'Lingua della guida' : 'Guide language'} class="language-switch"><span class="language-pill" aria-hidden="true"></span><a href={english} lang="en" aria-current={!isItalian ? 'page' : undefined}>English</a><a href={italian} lang="it" aria-current={isItalian ? 'page' : undefined}>Italiano</a></nav>
    </div>
    <div class="wrap document-layout">
      <aside class="doc-nav"><p class="eyebrow">{isItalian ? 'In questa pagina' : 'On this page'}</p><nav aria-label={isItalian ? 'Indice della guida' : 'Guide table of contents'}><ul>{headings.map((heading) => <li class={`toc-level-${heading.level}`}><a href={`#${heading.id}`} set:html={heading.label} /></li>)}</ul></nav></aside>
      <article class="doc-content" set:html={withGuideUpdated(html, updatedAt, lang)} />
    </div>
  </> : <>
    <div class="wrap guide-fallback">{isItalian ? 'La versione aggiornata non è disponibile al momento. Qui sotto trovi la copia salvata; ' : 'The latest version is temporarily unavailable. Below is the saved copy; '}<a href={source} target="_blank" rel="noopener noreferrer">{isItalian ? 'puoi leggere la guida su GitHub ↗' : 'read the guide on GitHub ↗'}</a>.</div>
    <Fragment set:html={withGuideUpdated(fallback, undefined, lang)} />
  </>}
</main>
